    "logo": null
  },
  "profile": {
    "source_type": "talking_head",
    "presenter": {
      "presence": "anchor",
      "share": [
        75,
        95
      ],
      "max_absence_s": 8
    },
    "spine": "talking_head",
    "captions": {
      "mode": "full",
      "role": "support",
      "mute_policy": "mute_safe"
    },
    "graphics": "support",
    "duration": {
      "class": "long",
      "target_s": [
        90,
        170
      ]
    },
    "language": {
      "speech": "en",
      "captions": {
        "lang": "en",
        "script": "Latn",
        "transform": "verbatim"
      },
      "on_screen": "en",
      "post_title": "en",
      "supported": [
        [
          "en",
          "en",
          "Latn"
        ],
        [
          "hinglish",
          "hinglish",
          "Latn"
        ],
        [
          "hi",
          "hi",
          "Deva"
        ]
      ]
    },
    "numbers": {
      "grouping": "international",
      "currency": "$",
      "compact": "k_m_b",
      "units": "metric",
      "decimals": 0,
      "style": "short"
    },
    "tone": {
      "energy": "calm",
      "comedy": "off",
      "comedy_max": "off"
    },
    "themes": {
      "policy": "per_reel",
      "packs": [
        "TH-studio",
        "TH-lime"
      ],
      "default": "TH-studio"
    },
    "formats": {
      "list": [
        "F-A",
        "F-B"
      ],
      "default": "F-A"
    },
    "footage_dependency": "medium",
    "cta": {
      "devices": [
        "follow_save_stack",
        "link_bio",
        "comment_keyword",
        "end_card"
      ],
      "placement": "end"
    },
    "modules": {
      "chrome": false,
      "running_state": false,
      "anchors": false,
      "data_figures": false,
      "citations": false,
      "dialogue": false,
      "canvas_camera": false,
      "ink": false,
      "continuity": false,
      "series": true,
      "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Countdown",
      "when": "a numbered roundup of tools, features, launches or picks (5-10 items), one item every 10-20 s",
      "profile": {},
      "layouts": [
        "L-full",
        "L-split",
        "L-card",
        "L-board"
      ],
      "hooks": {
        "default": "HA-02"
      },
      "structure": {
        "type": "news"
      },
      "shared_dna": "bare white captions with a big italic-serif phrase on full frames, small pill captions only on the split seam and under tool cards, series card, lime-and-white numerals, Save/Follow/Community end stack"
    },
    "F-B": {
      "name": "Daily brief",
      "when": "one news story or one launch explained in 70-100 s (a 'Day N' update), no numbered items",
      "profile": {
        "duration": {
          "class": "standard",
          "target_s": [
            70,
            100
          ]
        }
      },
      "layouts": [
        "L-full",
        "L-split",
        "L-card",
        "L-board"
      ],
      "hooks": {
        "default": "HA-12"
      },
      "structure": {
        "type": "explainer"
      },
      "shared_dna": "same caption profile, same split and seam caption, same series card and community end card; italic-serif questions replace numerals as the re-hooks"
    }
  },
  "tone": {
    "energy": "calm",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "high",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "navigation lime: numeral digits, the numeral hash (SM-NUM-B), Link in Bio pill, community headline, cursor/highlight boxes",
      "default": "#C6FF0C",
      "text_on": "ink",
      "brandable": true
    },
    "accent": {
      "meaning": "headline plate second line, the Save badge, the 'Comment below' title",
      "default": "#E60005",
      "text_on": "paper",
      "brandable": true
    },
    "bad": {
      "meaning": "paid, risky, the old way (price chips, strike lines)",
      "default": "#FF453A",
      "text_on": "ink",
      "brandable": false
    },
    "good": {
      "meaning": "free, works, the new way (FREE chip, ticks)",
      "default": "#30D158",
      "text_on": "ink",
      "brandable": false
    },
    "ink": {
      "meaning": "text on light cards and chips; plate fill",
      "default": "#0A0A0A"
    },
    "paper": {
      "meaning": "white text, chips, light cards, numeral hash (SM-NUM-A)",
      "default": "#FFFFFF"
    },
    "tile": {
      "meaning": "neutral glass tile for created logo plates / monograms (never a brand's colour)",
      "default": "#1C1C1E",
      "text_on": "paper",
      "brandable": false
    },
    "night": {
      "meaning": "end card ground (dark green-black)",
      "default": "#050B06"
    },
    "canvas": {
      "meaning": "warm board gradient top (full-screen UI board)",
      "default": "#E9773C"
    },
    "grid": {
      "meaning": "end card dot grid",
      "default": "#C6FF0C"
    }
  },
  "fixed_meaning": [
    "bad",
    "good"
  ],
  "max_bright_per_frame": 3,
  "gradients": {
    "wash": [
      "#FF8A3D",
      "#FF5E7A",
      "#FFC2A8"
