      "lifetime": "hook",
      "max_words": 9,
      "max_lines": 2,
      "read_s": 1.5,
      "f0": "both plates fully readable at frame 0 (settle 1.04 -> 1.00 over f0-f5)",
      "exit": "blur-out 6 f at the hook's end, or cut away with the hook beat",
