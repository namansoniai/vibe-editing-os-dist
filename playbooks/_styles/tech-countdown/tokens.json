  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "tech-countdown",
    "name": "Tech Countdown",
    "template_version": 1,
    "inspired_by": [
      "vaibhav-sisinty"
    ],
    "evidence": "analysis/short/vaibhav.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "profile.language.captions.transform",
      "sound.bed.on"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
