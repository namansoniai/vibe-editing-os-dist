  "font_slots": {
    "body": {
      "family": "Inter Tight",
      "use": "caption connector text, brand rows, banner plates, chips' sans text",
      "class": "neo-grotesk sans 400-700"
    },
    "serif": {
      "family": "Instrument Serif",
      "use": "italic emphasis phrases, series number, label/teaser chips, end-card kicker",
      "class": "high-contrast italic display serif"
    },
    "display": {
      "family": "Montserrat",
      "use": "numerals (SM-NUM-A), the SM-NUM-B hash, community headline, Link in Bio",
      "class": "heavy grotesk 800-900"
    },
    "numeric": {
      "family": "Barlow Condensed",
      "use": "condensed white digits (SM-NUM-B)",
      "class": "condensed sans 600-700"
    },
    "mono": {
      "family": "JetBrains Mono",
      "use": "created terminal / code texture only",
      "class": "monospace 400"
    }
