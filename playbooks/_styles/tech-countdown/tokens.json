      "#B26BFF",
      "#FF6FB1"
    ]
  },
  "themes": {
    "TH-studio": {
      "name": "Studio pill",
      "when": "default skin: plain-only chunks in a small 44 px black pill (hard swap), emphasis chunks bare white + italic serif; black translucent seam pill (CS-1S) on splits, white # with lime digits (SM-NUM-A, smear-in on the cut), dark tool windows; items enter by hard cut, warm flash only at section breaks",
      "roles": {},
      "worlds": {
        "W-board": {
          "gradient": {
            "stops": [
              "#E9773C",
              "#F6C9A5"
            ],
            "angle": 180
          }
        }
      },
      "gradients": {},
      "grade": null
    },
    "TH-lime": {
      "name": "Lime pill",
      "when": "tools-of-the-week skin: bare white 60 px full-frame captions that type on word by word; every item enters through a warm leak wash + rush-in zoom + lime bar swipe; lime pill with black text (CS-2) under tool cards, lime hash with white condensed digits (SM-NUM-B), white-framed tool windows",
      "roles": {},
      "worlds": {
        "W-board": {
          "gradient": {
            "stops": [
              "#2F7FD8",
              "#7FD8E6"
            ],
            "angle": 180
          }
        }
      },
      "gradients": {},
      "grade": null
    }
