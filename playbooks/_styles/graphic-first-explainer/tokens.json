{
  "schema": "veos.tokens/3",
  "playbook": "graphic-first-explainer",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "graphic-first-explainer",
    "name": "Graphic-First Explainer",
    "template_version": 1,
    "inspired_by": [
      "100xengineers"
    ],
    "evidence": "analysis/short/100xengineers.md",
    "status": "released",
    "unverified": [
      "sound.bed",
      "font_slots.display.family",
      "font_slots.chunky.family",
      "motion.counter_tick_frames"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {
      "pattern": null,
      "deliverable": null,
      "community_chip": null,
      "signoff": null
    },
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "talking_head",
    "presenter": {
      "presence": "guest",
      "share": [
        20,
        40
      ],
      "max_absence_s": 10
    },
    "spine": "hybrid",
    "captions": {
      "mode": "full",
      "role": "support",
      "mute_policy": "mute_safe"
    },
    "graphics": "primary",
    "duration": {
      "class": "short",
      "target_s": [
        35,
        60
      ]
    },
    "language": {
      "speech": "en",
      "captions": {
        "lang": "en",
        "script": "Latn",
        "transform": "verbatim"
      },
      "on_screen": "en",
      "post_title": "en",
      "supported": [
        [
          "en",
          "en",
          "Latn"
        ],
        [
          "hinglish",
          "hinglish",
          "Latn"
        ],
        [
          "hi",
          "hi",
          "Deva"
        ]
      ]
    },
    "numbers": {
      "grouping": "international",
      "currency": "$",
      "compact": "k_m_b",
      "units": "metric",
      "decimals": 0,
      "compact_decimals": 1
    },
    "tone": {
      "energy": "balanced",
      "comedy": "off",
      "comedy_max": "off"
    },
    "themes": {
      "policy": "per_reel",
      "packs": [
        "TH-editorial",
        "TH-brutal",
        "TH-pinksage"
      ],
      "default": "TH-editorial"
    },
    "formats": {
      "list": [
        "F-A",
        "F-B"
      ],
      "default": "F-A"
    },
    "footage_dependency": "low",
    "cta": {
      "devices": [
        "comment_keyword",
        "dm",
        "link_bio",
        "none"
      ],
      "placement": "mid+end"
    },
    "modules": {
      "chrome": false,
      "running_state": false,
      "anchors": false,
      "data_figures": true,
      "citations": true,
      "dialogue": false,
      "canvas_camera": false,
      "ink": false,
      "continuity": false,
      "series": false,
      "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Editorial figure explainer",
      "when": "explaining a result, a study, a launch, a record, a market move or any 'how it works' story: one numbered figure per idea on a dark editorial stage",
      "profile": {
        "presenter": {
          "share": [
            20,
            35
          ],
          "max_absence_s": 10
        },
        "duration": {
          "class": "standard",
          "target_s": [
            50,
            80
          ]
        },
        "themes": {
          "default": "TH-editorial"
        },
        "footage_dependency": "low",
        "cta": {
          "placement": "end"
        }
      },
      "layouts": [
        "L-graphic",
        "L-stack",
        "L-full"
      ],
      "hooks": {
        "default": "HA-07",
        "allowed": [
          "HA-07",
          "HA-18",
          "HA-02"
        ]
      },
      "structure": {
        "type": "explainer",
        "markers": {
          "style": "SM-FIG",
          "numbering": "asc",
          "recap": false,
          "teaser": false
        },
        "rehook_every_s": 25,
        "intro_max_ratio": 0.15
      },
      "type": {
        "headline": {
          "kind": "plate",
          "lifetime": "hook",
          "max_words": 5,
          "max_lines": 2,
          "read_s": 1.2,
          "f0": "slides in from the right with blur, settled by f10",
          "exit": "hard cut with the stack"
        }
      },
      "shared_dna": "same closed design system: one theme per reel, a full-frame designed graphic per idea replaced by a hard cut every 1.5-3 s, word-by-word pill captions, numbers that move, the presenter as a guest in stack / full layouts"
    },
    "F-B": {
      "name": "Ad card",
      "when": "offers, launches, tools, courses, events, 'N ways / N use cases' pitches: neo-brutalist window cards, a list, and a comment-keyword CTA said twice",
      "profile": {
        "presenter": {
          "share": [
            25,
            40
          ],
          "max_absence_s": 8
        },
        "duration": {
          "class": "short",
          "target_s": [
            35,
            55
          ]
        },
        "themes": {
          "default": "TH-brutal"
        },
        "cta": {
          "placement": "mid+end"
        }
      },
      "layouts": [
        "L-graphic",
        "L-stack",
        "L-full",
        "L-pip",
        "L-cardtop"
      ],
      "hooks": {
        "default": "HA-07",
        "allowed": [
          "HA-07",
          "HA-02"
        ]
      },
      "structure": {
        "type": "list",
        "markers": {
          "style": "SM-NUMERAL",
          "numbering": "asc",
          "recap": false,
          "teaser": false
        },
        "rehook_every_s": 25,
        "intro_max_ratio": 0.15
      },
      "type": {
        "headline": {
          "kind": "lockup",
          "lifetime": "section",
          "max_words": 6,
          "max_lines": 2,
          "read_s": 1.2,
          "f0": "slug pill pops, header lines type in by f12",
          "exit": "hard cut to the next section header"
        }
      },
      "font_slots": {
        "numeric": {
          "family": "Poppins",
          "use": "giant list numerals, ticker values, stat numbers",
          "class": "geometric sans 700-800"
        }
      },
      "captions": {
        "profiles": {
          "CS-1": {
            "skin": {
              "slot": "ui",
              "weight": 700,
              "size": 48,
              "case": "as_spoken",
              "container": {
                "type": "pill",
                "fill": "pill",
                "opacity": 1.0,
                "radius": 10,
                "padding": [
                  8,
                  16
                ]
              }
            },
            "position": {
              "by_layout": {
                "L-graphic": {
                  "anchor": "fixed_y",
                  "cy": 1450
                }
              }
            }
          }
        }
      },
      "citations": {
        "credit_line": {
          "required_on": "none"
        },
        "figure_numbering": false
      },
      "shared_dna": "same closed design system: one theme per reel, a full-frame designed graphic per idea replaced by a hard cut every 1.5-3 s, word-by-word pill captions, numbers that move, the presenter as a guest in stack / full / pip layouts"
    }
  },
  "tone": {
    "energy": "balanced",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "high",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "the theme's lead accent: hero numerals, the FIG number, header line 2, the active bar, the PiP ring",
      "default": "#F08060",
      "text_on": "ink",
      "brandable": true
    },
    "accent": {
      "meaning": "the second accent: the new / winning series, slug pills, chips, the CTA keyword",
      "default": "#4F8CFF",
      "text_on": "ink",
      "brandable": true
    },
    "pill": {
      "meaning": "the caption pill fill (white caption text on it)",
      "default": "#0B0A0A",
      "text_on": "paper"
    },
    "card": {
      "meaning": "card and window body fill",
      "default": "#EDE6D6",
      "text_on": "ink"
    },
    "line": {
      "meaning": "outlines and hard shadows of cards and windows",
      "default": "#2A2622",
      "text_on": "paper"
    },
    "mute": {
      "meaning": "mono micro labels, axis labels, the FIG title and SRC line",
      "default": "#9A9384"
    },
    "highlight": {
      "meaning": "the highlighter bar behind a stat line",
      "default": "#C27BD9",
      "text_on": "ink"
    },
    "bad": {
      "meaning": "the old value, the cost, the problem, the record to beat",
      "default": "#D4372D",
      "text_on": "paper",
      "brandable": false
    },
    "good": {
      "meaning": "the fix, the pass, the saving",
      "default": "#2FBF71",
      "text_on": "ink",
      "brandable": false
    },
    "ink": {
      "meaning": "dark text and outlines",
      "default": "#111111"
    },
    "paper": {
      "meaning": "light text on dark grounds, caption text",
      "default": "#FFFFFF"
    },
    "cream": {
      "meaning": "editorial text on the dark stage",
      "default": "#EDE6D6"
    }
  },
  "fixed_meaning": [
    "bad",
    "good"
  ],
  "max_bright_per_frame": 3,
  "gradients": {
    "G-old": {
      "stops": [
        "#F06A5E",
        "#8A2320"
      ],
      "angle": 180
    },
    "G-new": {
      "stops": [
        "#E4ECFF",
        "#3B74FF"
      ],
      "angle": 180
    },
    "G-fill": {
      "stops": [
        "#F08060",
        "#B07CE8",
        "#4F8CFF"
      ],
      "angle": 90
    },
    "G-promo": {
      "stops": [
        "#120A0A",
        "#C9341F",
        "#F7C2B5"
      ],
      "angle": 180
    }
  },
