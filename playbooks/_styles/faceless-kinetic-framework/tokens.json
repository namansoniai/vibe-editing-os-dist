  "font_slots": {
    "display": {
      "family": "Montserrat",
      "use": "bold sans stack lines, header line, CTA lines, card labels",
      "class": "geometric sans 700-800 (Montserrat ExtraBold measured; Poppins Bold is the fallback)"
    },
    "serif": {
      "family": "Instrument Serif",
      "use": "italic serif stack lines and serif words inside titles",
      "class": "light italic display serif"
    },
    "numeric": {
      "family": "Anton",
      "use": "giant initials, condensed formula caps, tucked words",
      "class": "tall condensed grotesk caps"
    },
    "ui": {
      "family": "Inter Tight",
      "use": "title-mix (P-04), hub centre name, typed node labels, view chips, credit lines",
      "class": "neo-grotesk 500-800"
    },
    "body": {
      "family": "Montserrat",
      "use": "caption header line (CS-3)",
