  "formats": {
    "F-A": {
      "name": "Kinetic framework",
      "when": "one idea, framework, list of N ways, acronym, formula or 'this is the X' explainer, 18-30 s, voice-over only",
      "profile": {},
      "layouts": [
        "L-canvas"
      ],
      "hooks": {
        "default": "HA-06"
      },
      "structure": {
        "type": "framework"
      },
      "shared_dna": "no presenter; alternating bold-sans / italic-serif kinetic stack on warm graph paper; rounded 9:16 proof cards; a canvas camera that visits the framework; light / umber / ink section flips; lead-magnet card CTA"
    }
  },
  "tone": {
    "energy": "calm",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "high",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "Signal: the one accent on the light world (active node ring, typing cursor, the quoted keyword)",
      "default": "#AE3F18",
      "text_on": "paper",
      "brandable": true
    },
    "accent": {
      "meaning": "Signal on the dark worlds (umber / ink): active node, cursor, CTA keyword on the dark card",
      "default": "#F2A65A",
      "text_on": "ink",
      "brandable": true
    },
    "bad": {
      "meaning": "the wrong way: strike-through, cross on a comparison",
      "default": "#B83A3A",
      "text_on": "paper",
      "brandable": false
    },
    "good": {
      "meaning": "the right way: tick on a comparison",
      "default": "#1B6E49",
      "text_on": "paper",
      "brandable": false
    },
    "comedy": {
      "meaning": "unused (comedy off)",
      "default": "#B83A3A",
      "text_on": "paper",
      "brandable": false
    },
    "ink": {
      "meaning": "warm near-black (sampled #392E2C, the same brown as the umber world): all type on paper, hub fill, card text",
      "default": "#392E2C"
    },
    "paper": {
      "meaning": "white: type on umber / ink worlds, light cards",
      "default": "#FFFFFF"
    },
    "canvas": {
      "meaning": "W-paper ground: warm light grey (sampled #E2E1DC, v01 + v03 CTA)",
      "default": "#E2E1DC"
    },
    "grid": {
      "meaning": "W-paper graph-paper LINES (1.5 px, 64 px pitch; barely visible, about 4% darker than the ground)",
      "default": "#D8D7D1"
    },
    "umber": {
      "meaning": "W-umber ground: dark brown section",
      "default": "#3A2E2C"
    },
    "night": {
      "meaning": "W-ink ground: charcoal section",
      "default": "#151515"
    },
    "hub": {
      "meaning": "hub hexagon and redaction bars",
      "default": "#262626"
    },
    "ghost": {
      "meaning": "giant initials on W-ink (display >= 180 px only)",
      "default": "#6F6F6F"
    },
    "mute": {
      "meaning": "secondary small type on paper (helper words, sublabels)",
      "default": "#5E5853"
    },
    "vault": {
      "meaning": "the lead-magnet database card body",
      "default": "#111111"
    },
    "mist": {
      "meaning": "W-mist ground: neutral cool grey of the hub / thumb-rain hooks (sampled #EBEBEB, v02 + v03 hook)",
      "default": "#EBEBEB"
    },
    "mist_dot": {
      "meaning": "W-mist faint dot grid",
      "default": "#DEDEDE"
