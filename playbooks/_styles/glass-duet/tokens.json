  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-1",
    "by_layout": {"L-card-pale": "CS-2", "L-pip-orbit": "CS-2"},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:joseph",
        "unit": "phrase", "words": [1, 8], "max_chars_line": 18, "lines": 3, "no_split": ["names", "numbers", "units"],
        "reveal": "word", "lead_frames": 1, "min_hold_s_per_word": 0.25,
        "swap": {"type": "blur", "frames": 5, "blur_px": 10, "out_frames": 5},
        "pause_hold_s": 0.6, "tail_s": 0.12, "hard_pause_s": 0.9, "punct_break": true, "punct": "strip_end",
        "skin": {"slot": "geo", "weight": 500, "size": 56, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": 0,
                 "colour": "paper", "stroke": 0, "shadow": "0 2 14 rgba(0,0,0,.45)", "line_height": 0.9,
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "chest", "offset": 220, "cy": 1120, "cx": 540, "max_w": 800, "align": "center", "avoid_face": true,
                     "colour_by_bg": {"light": "ink", "dark": "paper"}},
        "emphasis": {"mechanism": "size_tier", "slot": "geo", "colour": null, "ratio": 1.8,
                     "select": ["number", "topic_noun", "name"], "max_per_chunk": 1, "max_per_s": 0.35, "min_score": 1.5,
                     "never": ["stopwords"]},
        "karaoke": null, "tiers": null,
        "duet": {"keyword_slot": "geo", "keyword_weight": 700, "mid_slot": "script", "mid_weight": 400,
                 "connector_slot": "geo", "connector_weight": 500, "size_jump": [1.0, 1.55, 1.8], "mid_score": 1.3,
                 "rule": "audit 2026-10 (v01 @0:02.3, v04 @0:01.5/0:03.0 at full res): tier 0 (function words: is, at, you, and, like, what) = Jost 500 at 56 px; tier 1 (content words: style, look, edits, nothing) = Pinyon Script at 1.55x = 87 px; tier 2 (the punch word / number: taking over, your, think, 2026) = Jost 700 at 1.8x = 101 px. Sentence openers (This, If, That, The, In) are script in the source; the engine cannot force this, so the editor may mark them by hand (P5b)"},
        "stack": null,
        "hide": ["under_z8", "transitions"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      },
      "CS-2": {
        "extends": "lib:joseph",
        "unit": "phrase", "words": [2, 6], "max_chars_line": 30, "lines": 1, "no_split": ["names", "numbers", "units"],
        "reveal": "word", "lead_frames": 1, "min_hold_s_per_word": 0.25,
        "swap": {"type": "blur", "frames": 4, "blur_px": 8, "out_frames": 4},
        "pause_hold_s": 0.6,
        "skin": {"slot": "body", "weight": 500, "size": 44, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": 0,
                 "colour": "ink", "stroke": 0, "shadow": "none", "line_height": 1.1,
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "below_card", "offset": 34, "cy": 1380, "cx": 540, "max_w": 900, "align": "center",
                     "colour_by_bg": {"light": "ink", "dark": "paper"}},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8", "transitions"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      },
      "CS-3": {
        "extends": "lib:joseph",
        "unit": "phrase", "words": [1, 4], "max_chars_line": 18, "lines": 2, "no_split": ["names", "numbers", "units"],
        "reveal": "word", "lead_frames": 1, "min_hold_s_per_word": 0.25,
        "swap": {"type": "blur", "frames": 5, "blur_px": 10, "out_frames": 5},
        "pause_hold_s": 0.6, "punct": "keep",
        "skin": {"slot": "caps", "weight": 400, "style": "italic", "size": 58, "text_class": "TC-subtitle", "case": "upper", "tracking": 0,
                 "colour": "paper", "stroke": 0, "shadow": "0 0 18 rgba(255,255,255,.28), 0 2 10 rgba(0,0,0,.6)", "line_height": 1.05,
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "chest", "offset": 220, "cy": 1220, "cx": 540, "max_w": 920, "align": "center", "avoid_face": true,
                     "colour_by_bg": {"light": "ink", "dark": "paper"}},
        "emphasis": {"mechanism": "size_tier", "slot": "caps", "colour": null, "ratio": 1.25,
                     "select": ["number", "topic_noun", "name"], "max_per_chunk": 1, "max_per_s": 0.3, "min_score": 1.5,
                     "never": ["stopwords"]},
        "karaoke": null, "tiers": null,
        "duet": {"keyword_slot": "caps", "keyword_weight": 800, "keyword_style": "italic", "mid_slot": "caps", "mid_weight": 500,
                 "mid_style": "italic", "connector_slot": "caps", "connector_weight": 400, "connector_style": "italic",
                 "size_jump": [1.0, 1.0, 1.25], "mid_score": 1.3,
                 "rule": "one italic caps voice; emphasised words jump to 800 at 1.25x; the script appears only in P-SCRIPT-TAG titles"},
        "stack": null,
        "hide": ["under_z8", "transitions"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      }
    }
  },
