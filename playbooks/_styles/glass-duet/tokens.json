  "formats": {
    "F-A": {
      "name": "Tutorial explainer",
      "when": "teaching a method, a style, a tool or N tips/steps/reasons; one continuous take with glass markers, chest windows and full-screen tutorial cards",
      "profile": {},
      "layouts": ["L-full", "L-card-pale", "L-tutorial", "L-pip-orbit", "L-dim"],
      "hooks": {"default": "HA-05"},
      "structure": {"type": "tutorial", "markers": {"style": "SM-GLASS-DIAMOND", "numbering": "asc", "recap": true, "teaser": false}},
      "shared_dna": "duet captions at chest, glass diamonds and glass cards with a rim glow in the reel's studio colour, calm blur-in motion, face shrinks into a card"
    },
    "F-B": {
      "name": "Course sales",
      "when": "selling your own course, program, product or service: what it is, proof, what's inside (numbered modules), guarantee, DM/comment keyword",
      "profile": {
        "presenter": {"presence": "host", "share": [40, 80], "max_absence_s": 11},
        "duration": {"class": "long", "target_s": [90, 125]},
        "themes": {"default": "TH-neon"},
        "cta": {"chosen": "comment_keyword"}
      },
      "layouts": ["L-full", "L-card-pale", "L-graphic", "L-dim"],
      "hooks": {"default": "HA-05"},
      "captions": {"default": "CS-3"},
      "structure": {"type": "list", "markers": {"style": "SM-NUM-TILE", "numbering": "asc", "recap": false, "teaser": false}, "rehook_every_s": 25},
      "cadence": {"sc_per_10s": [3.5, 9], "max_gap_s": 2.2},
      "shared_dna": "same chest captions with an emphasis tier, same glass language and studio-colour glow, a 3D chrome title as the headline, numbered glass markers"
    }
  },
  "tone": {"energy": "calm", "meme_sfx": false, "roast": false, "caption_density": "high", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "the reel's studio colour on glass: diamond and tile fill, window rim, active marker, chip fill", "default": "#8018D0", "text_on": "paper", "brandable": true, "large_text_only": true},
    "accent": {"meaning": "the glow: card and window outer glow, sparkle bullets, leader-line dots, ring of the face bubble", "default": "#B46CFF", "text_on": "ink", "brandable": true},
    "good": {"meaning": "money, guarantee, 'yes', the CTA keyword glow in F-B", "default": "#39FF7A", "text_on": "ink", "brandable": false},
    "bad": {"meaning": "the viewer's current wrong state (a 1-star rating, a crossed-out habit); used rarely", "default": "#FF5C7A", "text_on": "ink", "brandable": false},
    "gold": {"meaning": "the earned result: '5/5', a won state (rating stars use primary-light, not gold; audit v04 @0:03)", "default": "#F7D15B", "text_on": "ink", "brandable": false},
    "ink": {"meaning": "text on the pale world and on light cards; deep shadows", "default": "#0B0D1A"},
    "paper": {"meaning": "caption text, glass text, card rims", "default": "#FFFFFF"},
    "canvas": {"meaning": "the pale floating world (W-pale)", "default": "#EAF3FA"},
    "navy": {"meaning": "top of the tutorial world gradient", "default": "#030F22"},
    "night": {"meaning": "the void behind chrome titles (W-void)", "default": "#05070F"},
    "grid": {"meaning": "grid-paper world lines (W-grid)", "default": "#C9CBD3"}
  },
  "fixed_meaning": ["good", "bad", "gold"],
  "max_bright_per_frame": 3,
  "gradients": {
    "chrome": ["#FFFFFF", "#DCEBFF", "#8FB7FF", "#3C5FB8", "#E8F2FF"],
    "glass_rim": ["rgba(255,255,255,0.85)", "rgba(255,255,255,0.10)", "rgba(255,255,255,0.45)"],
    "money": ["#B9FFD3", "#39FF7A", "#12B24E"]
