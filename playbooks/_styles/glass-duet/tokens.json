  "font_slots": {
    "display": {"family": "Inter Tight", "use": "duet keyword tier, diamond numerals, marker titles, stat counts", "class": "neo-grotesk sans 600-900"},
    "body": {"family": "Inter Tight", "use": "duet content tier, bullets, labels, card text", "class": "neo-grotesk sans 400-700"},
    "geo": {"family": "Jost", "use": "CS-1 duet sans: tier 0 (Medium 500) and tier 2 (Bold 700); Futura-like with the single-storey a/g seen in v01/v04 captions", "class": "geometric sans with single-storey a, 400-700"},
    "script": {"family": "Pinyon Script", "use": "duet content tier (tier 1), sentence openers, script tags under caps words ('Style', 'Month')", "class": "formal copperplate script (Edwardian-like)"},
    "caps": {"family": "Montserrat", "use": "F-B italic caps captions, chrome title, glass slabs, number tiles, CTA keyword", "class": "geometric sans with a true italic, 400-900"},
    "numeric": {"family": "Inter Tight", "use": "counts on stat cards, tracked money figures", "class": "neo-grotesk sans 700-900"}
  },
  "type": {
