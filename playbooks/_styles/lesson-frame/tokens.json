  "formats": {
    "F-A": {
      "name": "Lesson Frame",
      "when": "one concept, one mistake or one difference explained to camera: the title lockup stays the whole reel and the card swaps between your face, term cards and settings screenshots",
      "profile": {},
      "layouts": [
        "L-lesson",
        "L-term-pip",
        "L-term-full"
      ],
      "hooks": {
        "default": "HA-05"
      },
      "structure": {
        "type": "tutorial"
      },
      "shared_dna": "dot-grid page, one 4:3 rounded card at y 568-1288, tracked ALL CAPS captions under it, term cards instead of B-roll, credit chip, empty bottom band, hard cuts only"
    },
    "F-B": {
      "name": "Screen Walkthrough",
      "when": "step-by-step software settings or a where-to-click walkthrough: an insert hook with the title, then the card carries your screen recording with a highlight box on every field you name",
      "profile": {
        "footage_dependency": "medium",
        "presenter": {
          "presence": "host",
          "share": [
            40,
            100
          ],
          "max_absence_s": 3.0
        }
      },
      "layouts": [
        "L-insert-hook",
        "L-lesson",
        "L-screen",
        "L-term-pip",
        "L-term-full",
        "L-full"
      ],
      "hooks": {
        "default": "HA-02"
      },
      "structure": {
        "type": "tutorial"
      },
      "slots": {
        "S-title": {
          "rect": {
            "x": 64,
            "y": 812,
            "w": 952,
            "h": 214
          },
          "lifetime": "hook"
        }
      },
      "shared_dna": "same page, same 4:3 card rect, same caps captions in the same slot, same highlight box and credit chip; only the title lives for the hook alone"
    }
  },
  "tone": {
    "energy": "calm",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "high",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "the one accent: title hairline, highlight box on the named field, the warm first line of a dark term card",
      "default": "#F59E0B",
      "text_on": "ink",
      "brandable": true
    },
    "accent": {
      "meaning": "credit chip fill (handle, keyword or tool credit)",
      "default": "#1E7A3A",
      "text_on": "paper",
      "brandable": true
    },
    "ink": {
      "meaning": "text on light cards and on the light page, term words on white cards",
      "default": "#0F0F0F"
    },
    "paper": {
      "meaning": "lockup on the dark page, caption text, white term cards",
      "default": "#FFFFFF"
    },
    "night": {
      "meaning": "the dark page (TH-dark)",
      "default": "#000000"
    },
    "canvas": {
      "meaning": "the light page (TH-light)",
      "default": "#FBF3F1"
    },
    "grid": {
      "meaning": "page texture: dots on dark, lines on light",
      "default": "#1C1C1C"
    },
    "charcoal": {
      "meaning": "dark term card fill",
      "default": "#2A2A2E"
    },
    "termink": {
      "meaning": "the term word on a white card (soft charcoal with a drop shadow)",
      "default": "#2B2B2E"
    },
    "mute": {
      "meaning": "second tone of a variant chip (\"Apple Pro Res\" -> \"Pro Res\"); >= 4.5:1 on white",
      "default": "#6B6B70"
    },
    "pill": {
      "meaning": "Essential #N marker pill fill",
      "default": "#E4E4E7"
    }
  },
  "fixed_meaning": [],
