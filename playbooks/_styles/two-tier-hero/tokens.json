      {"id": "B", "desc": "second angle: three-quarter or profile at the same desk working (typing, writing), for statement-bleed and focus moments", "framing": {"head_top_y": [240, 520]}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "A-roll: the whole script at the desk, mid shot, 25-30 fps or higher, one take or several", "per_60s": [60, 60], "must": true, "formats": ["F-A"], "fallback": null},
      {"id": "SH-2", "desc": "hook prop take: the first 3-4 s of the script performed with 1-2 physical props in hand or on the desk at chest-to-desk height (two jars/glasses filled red and green, a printed photo, a handwritten card, chips/tokens)", "per_60s": [1, 1], "must": false, "formats": ["F-A"], "fallback": "FB-2"},
      {"id": "SH-3", "desc": "handwritten keyword cards (white card or paper, black marker, 1-2 words or a number like ₹60/DAY) shown to camera on the word", "per_60s": [0, 3], "must": false, "formats": ["F-A"], "fallback": "FB-3"},
      {"id": "SH-4", "desc": "own B-roll 1-3 s each: team, office, clients, the product, city or life moments the creator owns", "per_60s": [4, 12], "must": false, "formats": ["F-A"], "fallback": "FB-4"},
      {"id": "SH-5", "desc": "screen recordings or screenshots of the tools, sites, dashboards and documents named in the script (creator-owned)", "per_60s": [0, 6], "must": false, "formats": ["F-A"], "fallback": "FB-5"},
      {"id": "SH-6", "desc": "setup B: 3-6 s of the presenter working at the desk from the side", "per_60s": [0, 2], "must": false, "formats": ["F-A"], "fallback": "FB-6"},
      {"id": "SH-7", "desc": "the CTA target: a QR image (PNG) or the URL, or the comment keyword", "per_60s": [1, 1], "must": false, "formats": ["F-A"], "fallback": "FB-7"},
      {"id": "SH-8", "desc": "a desk list prop: 3-5 chips, tokens or cards laid in a row on the desk for list reels", "per_60s": [0, 1], "must": false, "formats": ["F-A"], "fallback": "FB-8"}
    ],
    "fallbacks": [
      {"id": "FB-2", "does": "P-10 RESULT-PAIR-VESSELS or P-12 PAPER-CARD-PROP: engine-built objects drawn on a glass world or in the top band (two glass jars filling red/neon, a drawn polaroid card), with the counter tags exactly as with real props", "cost": "no tangible object in the presenter's hands; the hook loses its physical surprise", "result": "degraded"},
      {"id": "FB-3", "does": "P-12 PAPER-CARD-PROP drawn: a white paper card with the keyword in Permanent Marker pops beside the presenter at chest height (never on the face)", "cost": "no in-hand action", "result": "holds"},
      {"id": "FB-4", "does": "replace each B-roll beat by an engine visual on the noun: a glass card (P-24), a silhouette or logo plate (created substitute), a product circle (P-33) with type, or a stylised punch of the A-roll with a treatment (P-31b)", "cost": "fewer real-world cutaways; the reel reads more like an explainer", "result": "holds"},
      {"id": "FB-5", "does": "recreated generic UI (VEOS.fx.appUI / fx.device), or a glass card with the tool's name set in type", "cost": "no real product footage", "result": "holds"},
      {"id": "FB-6", "does": "a Z-1 tight punch of the A-roll with the GR-bw treatment behind the statement", "cost": "no second angle", "result": "holds"},
      {"id": "FB-7", "does": "switch the CTA device to comment_keyword (P-43) or link_bio; never draw a fake QR", "cost": "no scan action", "result": "holds"},
      {"id": "FB-8", "does": "P-19 TOKEN-CAROUSEL on the violet stage carries the list count instead of desk chips", "cost": "no physical list on the desk", "result": "holds"}
    ],
    "props": [
