  "camera_presets": {
    "snap-punch": {"id": "Z-1", "name": "tight-on-cut", "scale": [1.0, 1.3], "frames": 1, "hold": "until_next_cut", "levels": {"mid": [1.15, 1.22], "tight": [1.3, 1.35]}, "tones": ["hype", "explain", "warn", "win"]},
