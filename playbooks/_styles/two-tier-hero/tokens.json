  "formats": {
    "F-A": {
      "name": "Two-tier hero talking head",
      "when": "every reel: career, money, skills, tools, stories and promos told by one presenter at a desk",
      "profile": {},
      "layouts": ["L-full", "L-stack", "L-graphic"],
      "hooks": {"default": "HA-08"},
      "structure": {"type": "list"},
      "shared_dna": "two-tier chest captions, hero text or number behind the head, whip-cut jump rhythm with wide/tight punches, one neon accent per reel, short stylised inserts on the noun"
    }
  },
  "tone": {"energy": "hype", "meme_sfx": false, "roast": false, "caption_density": "high", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "the reel's neon accent: hero numbers, gains, the active node, keyword chips, the current year", "default": "#C6FF1A", "text_on": "ink", "brandable": true},
    "accent": {"meaning": "glass-world glow: explainer card rims, spotlight stage, token glow, hub halo", "default": "#4363F2", "text_on": "paper", "brandable": true},
    "bad": {"meaning": "zero, loss, the wrong path, the problem alert (red half of the result pair)", "default": "#FF2A1A", "text_on": "ink", "brandable": false},
    "good": {"meaning": "the reached result, the right path, done (green half of the result pair)", "default": "#2BFF6E", "text_on": "ink", "brandable": false},
    "ink": {"meaning": "text on light worlds and on neon chips", "default": "#0B0B0B"},
    "paper": {"meaning": "captions, hero words, card text on dark worlds", "default": "#FFFFFF"},
    "canvas": {"meaning": "paper and grid worlds", "default": "#EEEDE9"},
    "grid": {"meaning": "grid lines on the grid canvas", "default": "#D7DAE2"},
    "night": {"meaning": "glass and space worlds", "default": "#050713"}
  },
  "fixed_meaning": ["bad", "good"],
  "max_bright_per_frame": 2,
