          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "fixed_y", "cy": 1420, "offset": 0, "cx": 540, "max_w": 860, "align": "center",
                     "colour_by_bg": null, "avoid_face": true},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null,
