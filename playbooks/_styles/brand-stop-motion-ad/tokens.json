{
  "schema": "veos.tokens/3",
  "playbook": "brand-stop-motion-ad",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "brand-stop-motion-ad",
    "name": "Brand Stop-motion Ad",
    "template_version": 1,
    "inspired_by": ["emma-chamberlain"],
    "evidence": "analysis/short/emma-chamberlain.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "profile.cta.devices",
      "sound.bed",
      "sound.cue_moments",
      "captions.profiles.CS-1.skin.slot",
      "captions.profiles.CS-1.lead_frames",
      "formats.F-C.end_card"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "animated_plates",
    "presenter": {"presence": "none", "share": [0, 0], "max_absence_s": 999},
    "spine": "footage",
    "captions": {"mode": "full", "role": "support", "mute_policy": "mute_safe"},
    "graphics": "minimal",
    "duration": {"class": "micro", "target_s": [12, 30]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "none", "units": "metric", "decimals": 0},
    "tone": {"energy": "calm", "comedy": "light", "comedy_max": "light"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A", "F-B", "F-C"], "default": "F-A"},
    "footage_dependency": "total",
    "cta": {"devices": ["end_card", "link_bio", "post_only", "none"], "placement": "end", "chosen": "end_card"},
    "modules": {
      "chrome": false, "running_state": false, "anchors": false, "data_figures": false, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": false, "continuity": false, "series": false, "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Dialogue sketch",
      "when": "the brand's plates carry character dialogue (voices in the mix): a two-character mini story that turns on the product and ends on a button line",
      "profile": {"duration": {"class": "micro", "target_s": [20, 30]}},
      "layouts": ["L-plate", "L-endcard", "L-plate-band", "L-plate-blur"],
      "hooks": {"default": "HA-16"},
      "structure": {"type": "sketch"},
      "cadence": {"sc_per_10s": [2.5, 6.0], "max_gap_s": 8.0, "max_static_s": 3.0, "median_shot_s": 4.1},
      "end_card": {"via": "T-IRIS", "hold_s": [1.8, 2.4]},
      "shared_dna": "plates open mid-action with no added text, small pale-yellow two-line captions at y 1420 (hard on/off) only when someone speaks, hard cuts on action, the product inside the world, a button beat, the wordmark alone on black last"
    },
    "F-B": {
      "name": "Product broadcast",
      "when": "silent or music-only plates with a locked-off in-world screen (TV, phone, billboard, shop window): the engine runs the product spot on that screen, 1-2 word label words alternating with the brand's pack shots",
      "profile": {"graphics": "support", "duration": {"class": "micro", "target_s": [18, 30]},
                  "modules": {"anchors": true}},
      "layouts": ["L-plate", "L-endcard", "L-plate-band", "L-plate-blur"],
      "hooks": {"default": "HA-16"},
      "structure": {"type": "sketch"},
      "cadence": {"sc_per_10s": [2.0, 6.0], "max_gap_s": 6.5, "max_static_s": 4.5},
      "end_card": {"via": "T-CUT-BLACK", "hold_s": [1.8, 2.4]},
      "shared_dna": "same plates-first sketch and end wordmark; the product spot plays inside the world on a screen, never as a full-frame overlay"
    },
    "F-C": {
      "name": "Vignette",
      "when": "one short character moment with no dialogue (a sip, a stroll, a look): opener, one wide, one button, then the wordmark",
      "profile": {"duration": {"class": "micro", "target_s": [10, 16]}},
      "layouts": ["L-plate", "L-endcard", "L-plate-band", "L-plate-blur"],
      "hooks": {"default": "HA-16"},
      "structure": {"type": "sketch"},
      "cadence": {"sc_per_10s": [1.5, 4.0], "max_gap_s": 6.5, "max_static_s": 3.0},
      "end_card": {"via": "T-CUT-BLACK", "hold_s": [1.6, 2.0]},
      "shared_dna": "same plates-first open, same no-text rule, same wordmark on black; the shortest form of the sketch (setup, wide, button)"
    }
  },
  "tone": {"energy": "calm", "meme_sfx": false, "roast": false, "caption_density": "low", "comedy": "light"},
  "roles": {
    "primary": {"meaning": "the brand's word colour: label words on in-world screens and the link line accent; never on a plate directly", "default": "#9C0012", "text_on": "paper", "brandable": true},
    "accent": {"meaning": "the ground of engine-built screen content (the pale cloud sky behind labels and pack shots)", "default": "#C9D9EE", "text_on": "primary", "brandable": true},
    "paper": {"meaning": "captions, the type-set wordmark fallback, the link line, legal lines", "default": "#FFFFFF"},
    "ink": {"meaning": "the end-card ground, the iris mask, the cut to black", "default": "#000000"},
    "shade": {"meaning": "caption stroke and shadow tint on bright plates (CS-2)", "default": "#2A1E14"},
    "static": {"meaning": "mid grey of the in-world screen static between channels", "default": "#8E8E8E"}
  },
  "fixed_meaning": ["paper", "ink"],
  "max_bright_per_frame": 2,
  "gradients": {},
  "themes": {},
  "worlds": {
    "W-plate": {"kind": "footage", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null},
    "W-black": {"kind": "void", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null}
  },
  "font_slots": {
    "caption": {"family": "Plus Jakarta Sans", "use": "dialogue captions, link line, legal lines", "class": "friendly geometric-humanist sans 400-600"},
    "label": {"family": "Barlow Condensed", "use": "label words on in-world screens", "class": "condensed grotesque caps 600-700"},
    "wordmark": {"family": "Fraunces Soft", "use": "the type-set wordmark fallback only (FB-5); the real wordmark is the brand's image file", "class": "soft chunky serif 700-900"}
  },
  "type": {
    "headline": {"kind": "none", "lifetime": "hook", "max_words": 0, "max_lines": 0, "read_s": 0,
                 "f0": "no headline and no added text: the plate's moving subject is frame 0", "exit": "n/a"},
    "screen_label": {"slot": "label", "weight": 700, "size": 56, "size_range": [48, 64], "text_class": "TC-label", "case": "upper",
                     "tracking": 0.01, "colour": "primary", "max_words": 2, "max_chars": 22, "hold_s": [0.8, 1.6],
                     "top_ratio": 0.21},
    "wordmark_type": {"slot": "wordmark", "weight": 800, "size": 104, "size_range": [92, 120], "text_class": "TC-display",
                      "colour": "paper", "arc_deg": 48, "rotate": -6, "width": [600, 700]},
    "wordmark_image": {"width": 648, "width_range": [600, 700], "cy": 960, "in_frames": 8, "hold_s": [1.8, 2.4]},
    "link_line": {"slot": "caption", "weight": 500, "size": 40, "text_class": "TC-label", "case": "sentence", "colour": "paper",
                  "cy": 1180, "in_frames": 8},
    "legal": {"slot": "caption", "weight": 500, "size": 24, "text_class": "TC-legal", "case": "sentence", "colour": "paper",
              "x": 64, "y": 150, "shadow": "0 1 4 rgba(0,0,0,.6)"},
    "representational": {"slot": "caption", "weight": 600, "size": 24, "text_class": "TC-legal", "case": "upper", "tracking": 0.1,
                         "colour": "paper"}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-1",
    "by_layout": {"L-plate-band": "CS-1"},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:chamberlain",
