        "stack": null,
        "hide": [],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
                     "mask_words": [], "glossary": []}
      },
      "CS-3": {
        "extends": "lib:chamberlain",
        "unit": "sentence",
        "words": [1, 8],
        "max_chars_line": 24,
        "lines": 2,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 2,
        "min_hold_s_per_word": 0.3,
        "swap": {"type": "hard", "frames": 0},
        "pause_hold_s": 0.6,
        "tail_s": 0.25,
        "hard_pause_s": 0.9,
        "punct_break": true,
        "punct": "keep",
        "skin": {
          "slot": "caption", "weight": 500, "size": 64, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": 0,
          "colour": "#F6FA8C", "stroke": 0, "shadow": "0 2 10 rgba(0,0,0,.55)", "line_height": 1.25,
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "fixed_y", "cy": 1180, "offset": 0, "cx": 540, "max_w": 860, "align": "center",
                     "colour_by_bg": null, "avoid_face": true},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null,
        "tiers": null,
        "duet": null,
        "stack": null,
        "hide": [],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
