  },
  "layout": {
    "size": [1080, 1920],
    "safe": {"x": [64, 1016], "y": [110, 1500]},
    "ig_ui": {"top": 110, "bottom": 380, "right": 110},
    "face_clearance": 40,
    "caption_cy": {"full": 1420}
  },
  "layouts": {
    "L-plate": {"engine": "full", "presenter": null, "graphic": null,
                "caption": {"anchor": "fixed_y", "cy": 1420}, "treatment": null, "share": [0.0, 0.95], "safe": null},
    "L-endcard": {"engine": "hidden", "presenter": null, "graphic": {"x": 64, "y": 640, "w": 952, "h": 640},
                  "caption": {"anchor": "fixed_y", "cy": 1420}, "treatment": null, "share": [0.05, 0.2], "safe": null},
    "L-plate-band": {"engine": "letterbox", "band_h": 608, "cy": 860, "fill": "#000000", "src": "footage",
                     "presenter": null, "graphic": null, "caption": {"anchor": "fixed_y", "cy": 1290}, "treatment": null,
                     "share": [0.0, 0.95], "safe": null},
    "L-plate-blur": {"engine": "blurfill", "band_h": 1350, "cy": 900, "blur_px": 48, "luma": -0.35, "scale": 1.15, "src": "footage",
                     "presenter": null, "graphic": null, "caption": {"anchor": "fixed_y", "cy": 1420}, "treatment": null,
                     "share": [0.0, 0.95], "safe": null}
  },
  "slots": {},
  "motion": {"lead_frames": 2, "ease_entry": [0.22, 1, 0.36, 1], "ease_exit": [0.64, 0, 0.78, 0], "pop_overshoot": 0,
             "number_roll_frames": 0, "hold_min_frames": 10, "text_hold_per_word_s": 0.3,
             "caption_fade_frames": 0, "caption_swap": "hard", "pack_in_frames": 15, "pack_in_steps": {"poses": [4, 5], "hold_frames": 3, "scale": [0.55, 1.0], "jitter_deg": 2, "jitter_px": 6}, "pack_tilt_deg": [-2, 2], "label_swap": "hard", "label_blink_frames": {"on": [6, 7], "off": 6}, "label_hold_s": [1.4, 2.0],
             "static_s": [0.6, 1.8], "static_default_s": 1.1, "screen_on_frames": 0,
             "screen_wordmark_frames": 18, "screen_wordmark_step_frames": 2, "screen_wordmark_scale": [0.65, 1.0], "screen_wordmark_rotate": [-6, 0], "in_world_step_frames": [2, 3], "in_world_step": {"scene_field": "step_frames", "wordmark": 2, "packs": 3, "clouds": 3, "pack3d": 3},
             "iris_close_frames": 42, "iris_from_r": 1110, "iris_to_r": 510, "iris_hold_frames": [18, 24],
             "iris_snap_frames": 6, "iris_feather_px": 24, "black_frames": 4, "iris_black_frames": 0,
             "wordmark_in_frames": 5, "wordmark_scale": [1.0, 1.0], "wordmark_in_under_iris_snap": true, "plate_hold_max_frames": 12, "plate_pose_hold_keep": true, "sense_trip_s": [1.5, 2.0], "glow_in_frames": 3, "bloom_out_frames": 5, "orb_collapse_frames": 6, "glow_in_transition": {"type": "flash", "colour": "#FFE2A8", "peak": 0.45, "pre": 3, "frames": 15}, "glow_in_blur": {"kind": "radial", "amount": 0.12, "at": "centre", "frames": 6, "shape": "decay"}, "bloom_out_transition": {"type": "flash", "colour": "#FFF6E0", "peak": 0.9, "pre": 5, "frames": 5}, "orb_collapse_transition": {"type": "iris", "reveal": "next", "frames": 6, "feather": 40},
             "plate_cadence": {"conform": "duplicate_frames", "interpolate": false, "evidence": "v01 ones + 12-14 f pose holds; v02 held poses, screen objects on 2-3 f steps; v03 characters on twos, camera on ones"}},
  "camera_presets": {},
  "zoom_policy": "source_only",
  "stage_morphs": {"cut": 0},
  "grades": {"footage": null, "scene": {}, "events": {"max_per_reel": 0, "allowed": []}, "clip_treatments": null},
  "hooks": {
    "default": "HA-16",
    "allowed": ["HA-16", "HA-15", "HA-14", "HA-13"],
    "stopper": {"tests": ["ST-1", "ST-3", "ST-6"], "thumb_scale": 0.25, "read_s": 0, "hook_sc_3s": 1, "payoff_by_s": 5.0,
                "subject_min_frame_h": 0.2},
    "f0": {"require": ["moving_subject"], "forbid": ["headline"]}
  },
  "structure": {"type": "sketch", "markers": {"style": "none", "numbering": "asc", "recap": false, "teaser": false},
                "beats": ["setup", "gag", "product", "button", "logo"],
                "rehook_every_s": null, "intro_max_ratio": 0.15},
  "cadence": {"sc_per_10s": [1.5, 6.0], "hook_sc_3s": 1, "max_gap_s": 8.0, "max_static_s": 3.0, "caption_weight": 0.5,
              "cuts_per_min": null, "median_shot_s": null, "continuous_motion_required": false},
  "budgets": {},
  "exceptions": {"E6": {"slot_tolerance_px": 4}},
  "anchors": {"mode": "static", "fallback": "static_near_target", "face_clear_px": 40},
  "inserts": {"fetch": false, "ask_creator": true,
              "create_fallbacks": ["quote_card", "headline_card", "recreated_ui", "diagram", "logo_plate", "silhouette"], "patterns": ["P-SCREEN-SHOW", "P-STOCKIST-LINE"]},
  "footage": {
    "setups": [
      {"id": "A", "desc": "the brand's finished stop-motion or animated plates: 9:16, 1080x1920 or larger, 24/25/30 fps, the final grade baked in, one mixed audio track per plate (dialogue, foley, music)", "framing": {"subject_eyes_y": [480, 1300]}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "the plates: every shot of the sketch, each with 12-24 frames of handle before and after the action", "per_60s": [8, 24], "must": true, "formats": ["F-A", "F-B", "F-C"], "fallback": "FB-1"},
      {"id": "SH-2", "desc": "native 9:16 framing with character eyes between y 480 and 1300 and nothing that matters below y 1500", "per_60s": [8, 24], "must": true, "formats": ["F-A", "F-B", "F-C"], "fallback": "FB-2"},
      {"id": "SH-3", "desc": "the mixed plate audio: character voices (F-A), foley and music", "per_60s": [1, 1], "must": false, "formats": ["F-A", "F-B", "F-C"], "fallback": "FB-3"},
      {"id": "SH-4", "desc": "the dialogue script with the exact casing and spelling the captions must show", "per_60s": [1, 1], "must": false, "formats": ["F-A"], "fallback": "FB-4"},
      {"id": "SH-5", "desc": "the wordmark: a transparent PNG or SVG, one colour (white), at least 1200 px wide", "per_60s": [1, 1], "must": true, "formats": ["F-A", "F-B", "F-C"], "fallback": "FB-5"},
      {"id": "SH-6", "desc": "pack shots: transparent PNG cut-outs of 1-4 products, at least 900 px tall, front-on", "per_60s": [1, 4], "must": true, "formats": ["F-B"], "fallback": "FB-6"},
      {"id": "SH-7", "desc": "the approved claims list: the exact 1-2 word label words legal has cleared", "per_60s": [1, 1], "must": false, "formats": ["F-B"], "fallback": "FB-7"},
      {"id": "SH-8", "desc": "a locked-off plate of an in-world screen (TV, phone, billboard, window) with a flat blank face, at least 6 s, plus the same set wide", "per_60s": [1, 2], "must": true, "formats": ["F-B"], "fallback": "FB-8"},
      {"id": "SH-9", "desc": "a button plate: a last 2-4 s character beat (a reaction, a non-sequitur, a satisfied sip)", "per_60s": [1, 1], "must": true, "formats": ["F-A", "F-C"], "fallback": "FB-9"}
    ],
    "fallbacks": [
      {"id": "FB-1", "does": "nothing: the engine cannot make stop-motion; without plates there is no reel", "cost": "the template cannot run", "result": "no_fallback"},
      {"id": "FB-2", "does": "16:9 plates go in L-plate-band (letterbox, band y 556-1164, captions under it at y 1290); 4:5 or 1:1 plates go in L-plate-blur; a 9:16 crop window is used instead when the action fits a static crop at <= 1.35x on 1080p (<= 2.0x on 4K)", "cost": "the miniature no longer fills the phone; reads as a TV spot repost", "result": "degraded"},
      {"id": "FB-3", "does": "silent plates: bed from the SFX pack (calm), captions off by absence of speech, F-A unavailable", "cost": "no character voices; the sketch must read as pantomime", "result": "holds"},
      {"id": "FB-4", "does": "transcribe the plate audio and caption verbatim; sentence case", "cost": "the script's emphasis caps (\"you've GOT to\") and invented spellings are lost", "result": "holds"},
      {"id": "FB-5", "does": "type-set wordmark from BV-01 in the wordmark slot: line 1 on a 48 deg arc, line 2 straight, white, 600-700 px wide", "cost": "not the brand's real mark", "result": "degraded"},
      {"id": "FB-6", "does": "the screen spot shows label words and the wordmark only", "cost": "no product on screen; weaker product turn", "result": "degraded"},
      {"id": "FB-7", "does": "no label words: packs and the wordmark carry the spot", "cost": "no claims on screen", "result": "holds"},
      {"id": "FB-8", "does": "F-B unavailable; the product turn uses the brand's own product-in-world plate (F-A or F-C)", "cost": "no broadcast ritual", "result": "no_fallback"},
      {"id": "FB-9", "does": "hold the last plate's final frame up to 12 f and run the iris (F-A) or the cut to black on it", "cost": "no button laugh; the ending lands softer", "result": "degraded"}
    ],
    "props": [],
    "reaction_bank": ["character reaction close-ups, 1.2-2.0 s each, 2-3 characters"],
    "matte": "none",
    "min_source_px": {"punch_2x": 2160, "punch_1_35x": 1080, "crop_max_1080p": 1.35, "crop_max_2160p": 2.0}
  },
  "dialogue": null,
  "citations": null,
  "ink": null,
  "continuity": null,
  "series": null,
  "brand": {"sponsor": {"card": null, "disclosure": "Paid partnership", "disclosure_hold_s": 2.0, "disclosure_at": "f0"},
            "endcard": {"type": "wordmark", "max_s": 2.5, "ground": "ink", "cy": 960}},
  "sound": {"cue_moments": ["reveals", "transitions", "cta"], "meme_cues": false, "bed": {"on": false, "enter": "f0"}, "duck_db": -18,
            "loudness": {"lufs": -14, "true_peak_db": -1.5}},
  "tones": ["setup", "gag", "awe", "button", "cta"],
  "tone_treatment": {},
  "validator": {
    "rules": {
