{
  "schema": "veos.tokens/3",
  "playbook": "long-form-recut",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "long-form-recut",
    "name": "Long-form Re-cut",
    "template_version": 1,
    "inspired_by": ["veritasium"],
    "evidence": "analysis/short/veritasium.md",
    "status": "released",
    "unverified": [
      "profile.language.captions.transform",
      "captions.profiles.CS-1.lead_frames",
      "sound.bed",
      "sound.cue_moments",
      "type.object_title"
    ],
    "audit": "fidelity audit 2026-10-06 against v01-v03 at full resolution (docs/audit/long-form-recut/audit.md); completeness audit 2026-10-07 at full frame rate (docs/audit/long-form-recut/completeness.md)"
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "edited_master",
    "presenter": {"presence": "guest", "share": [5, 55], "max_absence_s": 90},
    "spine": "audio",
    "captions": {"mode": "full", "role": "primary", "mute_policy": "mute_safe"},
    "graphics": "passthrough",
    "duration": {"class": "long", "target_s": [110, 150]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0,
                "style": "long", "lang": "en", "percent_decimals": 1},
    "tone": {"energy": "calm", "comedy": "off", "comedy_max": "off"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A"], "default": "F-A"},
    "footage_dependency": "total",
    "cta": {"devices": ["none", "post_only", "cross_promo"], "placement": "end", "chosen": "none"},
    "modules": {
      "chrome": false, "running_state": false, "anchors": false, "data_figures": false, "citations": false,
      "dialogue": true, "canvas_camera": false, "ink": false, "continuity": false, "series": false, "brand": false
    }
  },
  "formats": {
    "F-A": {
      "name": "Master re-cut",
      "when": "every reel: one self-contained 110-150 s argument cut from the creator's own finished 16:9 long-form video",
      "profile": {},
      "layouts": ["L-master", "L-band-black", "L-band-blur", "L-void"],
      "hooks": {"default": "HA-14"},
      "structure": {"type": "explainer"},
      "shared_dna": "cold open mid-sentence on the master's strongest moving image, voice-coded serif captions (white host, gold guest) at y 1380, reframe-don't-redraw"
    }
  },
  "tone": {"energy": "calm", "meme_sfx": false, "roast": false, "caption_density": "high", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "host / narrator caption colour (every word the creator speaks, on or off screen)", "default": "#FFFFFF", "text_on": "ink", "brandable": false},
    "accent": {"meaning": "guest caption colour (every word spoken by anyone who is not the host; sampled #E8CC28 at full resolution, v01 @ 1:00 / 1:30, v02 @ 1:30)", "default": "#E8CC28", "text_on": "ink", "brandable": true},
    "ink": {"meaning": "caption stroke and shadow, letterbox fill, card ground", "default": "#000000"},
    "paper": {"meaning": "object titles, cross-promo line, created-card text", "default": "#FFFFFF"},
    "night": {"meaning": "letterbox and void fill behind 16:9 bands", "default": "#000000"},
    "muted": {"meaning": "small legal text on cards", "default": "#B9B9B9"}
  },
  "fixed_meaning": ["primary"],
  "max_bright_per_frame": 2,
  "gradients": {},
  "themes": {},
  "worlds": {
    "W-master": {"kind": "footage", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null},
    "W-void": {"kind": "void", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null}
  },
  "font_slots": {
    "serif": {"family": "Source Serif 4", "use": "speech captions, cross-promo line, created-card body", "class": "transitional text serif 500-700"},
    "title": {"family": "EB Garamond", "use": "italic object titles", "class": "old-style italic serif 400-600"}
  },
  "type": {
    "headline": {"kind": "none", "lifetime": "hook", "max_words": 0, "max_lines": 0, "read_s": 0, "f0": "no headline: the caption and the moving master carry frame 0", "exit": "n/a"},
    "object_title": {"slot": "title", "weight": 500, "style": "italic", "size": 68, "text_class": "TC-label", "tracking": 0.02,
                     "colour": "paper", "shadow": "0 2 6 rgba(0,0,0,.7)", "max_words": 3, "max_per_reel": 3, "hold_s": [1.5, 4.0]},
    "cross_promo": {"slot": "serif", "weight": 500, "size": 44, "text_class": "TC-label", "colour": "paper", "case": "sentence",
                    "shadow": "0 2 6 rgba(0,0,0,.7)", "cy": 1250, "hold_s": [2.0, 3.0]},
    "card_body": {"slot": "serif", "weight": 600, "size": 52, "text_class": "TC-label", "colour": "paper", "case": "sentence"},
    "card_kicker": {"slot": "serif", "weight": 500, "size": 26, "text_class": "TC-legal", "colour": "muted", "case": "upper", "tracking": 0.12},
    "legal": {"slot": "serif", "weight": 500, "size": 24, "text_class": "TC-legal", "colour": "muted", "case": "upper", "tracking": 0.12}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "devanagari_family": "Noto Serif Devanagari",
    "default": "CS-1",
    "by_layout": {},
    "speakers": {
      "host": {"colour": "primary", "style": "upright"},
      "narrator": {"colour": "primary", "style": "upright"},
      "guest": {"colour": "accent", "style": "upright", "note": "the host stays white on location too (v01 @ 1:19-1:20 'And how often / do you have / annihilation' white over handheld CERN footage); gold = a non-host voice only"}
    },
    "profiles": {
      "CS-1": {
        "extends": "lib:veritasium",
        "unit": "group",
        "words": [1, 4],
        "max_chars_line": 22,
        "lines": 1,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1,
        "min_hold_s_per_word": 0.2,
        "swap": {"type": "hard", "frames": 0},
        "pause_hold_s": 0,
        "tail_s": 0.3,
        "hard_pause_s": 0.9,
        "punct_break": true,
        "punct": "keep",
        "skin": {
          "slot": "serif", "weight": 600, "size": 70, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": 0,
          "colour": "primary", "stroke": 1, "stroke_colour": "#111111", "shadow": "0 2 8 rgba(0,0,0,.75)", "line_height": 1.1,
          "note": "Source Serif 4 600 ≈ 70-72 px (\"One thing\" 321 px wide, v02 @ 0:00), soft drop shadow, hairline outline at most; cy 1377 (v01 / v02), 1341 in the animated v03, whose captions use a lighter LaTeX-like serif (Source Serif 4 400 is the closest bundled cut); hard swaps (0 f, no fade, measured at 30 fps: v01 @ 1:19.70, v02 @ 0:35.42, 0:54.80), 2-3 words, 0.4-0.6 s each; chunks are voice-timed and run across master cuts (v02 @ 0:20.83 a chunk outlives the cut by 3 f, @ 0:35.28 the guest's gold chunk by 4 f; v01 @ 0:44.57 the guest's gold chunk starts 2 f before his picture)",
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "fixed_y", "cy": 1380, "offset": 0, "cx": 540, "max_w": 900, "align": "center",
                     "colour_by_bg": null, "avoid_face": true},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null,
        "tiers": null,
        "duet": null,
        "stack": null,
        "hide": ["transitions"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
                     "glossary": []}
      }
    }
  },
  "layout": {
    "size": [1080, 1920],
    "safe": {"x": [64, 1016], "y": [110, 1500]},
    "ig_ui": {"top": 110, "bottom": 380, "right": 110},
    "face_clearance": 40,
    "caption_cy": {"full": 1380}
  },
  "layouts": {
    "L-master": {"engine": "full", "presenter": null, "graphic": null,
                 "caption": {"anchor": "fixed_y", "cy": 1380}, "treatment": null, "share": [0.85, 1.0], "safe": null},
    "L-band-black": {"engine": "letterbox", "band_h": 608, "cy": 960, "fill": "#000000", "face": 0, "src": "footage",
                     "presenter": null, "graphic": null, "caption": {"anchor": "fixed_y", "cy": 1380}, "treatment": null,
                     "share": [0.0, 0.15], "safe": null},
    "L-band-blur": {"engine": "blurfill", "band_h": 608, "cy": 960, "blur_px": 40, "luma": 0, "scale": 1.15, "face": 0,
                    "src": "footage", "presenter": null, "graphic": null, "caption": {"anchor": "fixed_y", "cy": 1380},
                    "treatment": null, "share": [0.0, 0.15], "safe": null},
    "L-void": {"engine": "hidden", "presenter": null, "graphic": {"x": 64, "y": 560, "w": 952, "h": 640},
               "caption": {"anchor": "fixed_y", "cy": 1380}, "treatment": null, "share": [0.0, 0.08], "safe": null}
  },
  "slots": {},
  "motion": {"lead_frames": 2, "ease_entry": [0.22, 1, 0.36, 1], "ease_exit": [0.64, 0, 0.78, 0], "pop_overshoot": 0,
             "number_roll_frames": 0, "hold_min_frames": 10, "text_hold_per_word_s": 0.25,
             "title_in_frames": 8, "title_out_frames": 6, "dissolve_frames": 10, "end_fade_frames": 5},
  "camera_presets": {},
  "zoom_policy": "source_only",
  "stage_morphs": {"cut": 0},
  "grades": {"footage": null, "scene": {}, "events": {"max_per_reel": 0, "allowed": []}, "clip_treatments": null},
  "hooks": {
    "default": "HA-14",
    "allowed": ["HA-14", "HA-10", "HA-15"],
    "stopper": {"tests": ["ST-2", "ST-3", "ST-5", "ST-6"], "thumb_scale": 0.25, "read_s": 0, "hook_sc_3s": 4, "payoff_by_s": 1.0},
    "f0": {"require": ["caption", "footage"], "forbid": ["headline"]}
  },
  "structure": {"type": "explainer", "markers": {"style": "none", "numbering": "asc", "recap": false, "teaser": false},
                "rehook_every_s": 25, "intro_max_ratio": 0.15},
  "cadence": {"sc_per_10s": [6, 15], "hook_sc_3s": 4, "max_gap_s": 2.5, "max_static_s": 3.0, "caption_weight": 1.0,
              "cuts_per_min": null, "median_shot_s": null, "continuous_motion_required": false},
  "budgets": {},
  "exceptions": {"E6": {"slot_tolerance_px": 4}},
  "inserts": {"fetch": true, "ask_creator": false,
              "create_fallbacks": ["quote_card", "headline_card", "recreated_ui", "diagram", "logo_plate", "silhouette"], "patterns": ["P-SUBSTITUTE-CARD"]},
  "footage": {
    "setups": [
      {"id": "M", "desc": "the creator's own finished long-form master: 16:9, edited, graphics and music baked in, one stereo mix with the voice", "framing": {"head_top_y": [150, 260]}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "the finished 16:9 long-form master (the sub-story is cut from it)", "per_60s": [1, 1], "must": true, "formats": ["F-A"], "fallback": "FB-1"},
      {"id": "SH-2", "desc": "4K (2160p) export of the same master, so 9:16 crops never upsample", "per_60s": [0, 1], "must": false, "formats": ["F-A"], "fallback": "FB-2"},
      {"id": "SH-3", "desc": "the cast list: who is the host and the name of every guest in the chosen part", "per_60s": [0, 1], "must": true, "formats": ["F-A"], "fallback": "FB-3"},
      {"id": "SH-4", "desc": "the video's long-form title and where it lives (for the cross-promo line)", "per_60s": [0, 1], "must": false, "formats": ["F-A"], "fallback": "FB-4"}
    ],
    "fallbacks": [
      {"id": "FB-1", "does": "nothing: without a finished master there is nothing to re-cut", "cost": "the template cannot run", "result": "no_fallback"},
      {"id": "FB-2", "does": "crop the 1080p master at up to 1.78x (the compositor's 2.0x cap holds)", "cost": "face and render crops are softer; fine detail and baked small text lose sharpness", "result": "degraded"},
      {"id": "FB-3", "does": "diarise and label the most-talking voice 'host', every other voice 'guest'; ask once at the checkpoint", "cost": "a co-host would be captioned gold", "result": "holds"},
      {"id": "FB-4", "does": "cross-promo device unavailable; the CTA falls back to post_only", "cost": "no on-screen pointer to the full video", "result": "holds"}
    ],
    "props": [],
    "reaction_bank": [],
    "matte": "none",
    "min_source_px": {"punch_2x": 2160, "punch_1_35x": 1080, "crop_9x16_from_16x9": 2160}
  },
  "dialogue": {
    "cast": [
      {"id": "host", "role": "host", "caption": "host"},
      {"id": "guest", "role": "guest", "caption": "guest"}
    ],
    "cut_rules": {"handover_tol_f": 3, "reaction_s": [1.5, 3.0], "establish_s": [1.0, 2.0], "recrop_every_s": [999, 999],
                  "max_hold_s": 999, "min_shot_s": 0.8},
    "stack": false,
    "fallback": "blurfill", "blur_dim": 1.0,
    "single_cam_fallback": "two_crops"
