      "V-CAPTION": {"from": "captions", "max_lead_s": 0.15, "max_lag_s": 0.1},
      "V-TYPE": true,
      "V-EXC": true,
      "V-HUES": true,
      "V-LAYOUT": true,
      "V-REHOOK": {"max_gap_s": 25},
