  "citations": null,
  "ink": null,
  "continuity": null,
  "series": null,
  "brand": null,
  "sound": {"cue_moments": [], "meme_cues": false, "bed": {"on": false, "enter": "never"}, "duck_db": -18,
            "loudness": {"lufs": -14, "true_peak_db": -1.5}},
  "tones": ["explain", "awe", "warn", "win", "cta"],
  "tone_treatment": {},
