{
  "schema": "veos.tokens/3",
  "playbook": "whiteboard-split",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "whiteboard-split",
    "name": "Whiteboard Split",
    "template_version": 1,
    "inspired_by": ["kallaway"],
    "evidence": "analysis/short/kallaway.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "sound",
      "footage.setups",
      "layouts.L-split.presenter.popout"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "talking_head",
    "presenter": {"presence": "anchor", "share": [90, 100], "max_absence_s": 4},
    "spine": "talking_head",
    "captions": {"mode": "full", "role": "primary", "mute_policy": "mute_safe"},
    "graphics": "primary",
    "duration": {"class": "standard", "target_s": [60, 90]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0},
    "tone": {"energy": "balanced", "comedy": "off", "comedy_max": "off"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A"], "default": "F-A"},
    "footage_dependency": "low",
    "cta": {"devices": ["comment_keyword", "link_bio", "post_only"], "placement": "end", "chosen": "comment_keyword"},
    "modules": {
      "chrome": true, "running_state": false, "anchors": false, "data_figures": true, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": false, "continuity": true, "series": false, "brand": false
    }
  },
  "formats": {
    "F-A": {
      "name": "Whiteboard split",
      "when": "every reel: a framework, a before/after model, or a step-by-step workflow taught to camera",
      "profile": {},
      "layouts": ["L-split", "L-full", "L-clip"],
      "hooks": {"default": "HA-06"},
      "structure": {"type": "framework"},
      "shared_dna": "card band on top, one-word caption band, rounded face window below; punches to full face every 2-7 s; one recurring diagram; mixed sans + italic-serif lockups with a crimson key phrase"
    }
  },
  "tone": {"energy": "balanced", "meme_sfx": false, "roast": false, "caption_density": "high", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "the key phrase: lockup accent words (paper world only), the crimson underline, the key slab, the CTA deliverable line, count chips on paper", "default": "#B0122A", "text_on": "paper", "brandable": true},
    "accent": {"meaning": "the recurring motif and the lit node on the stage world; neon glow on the one active diagram part", "default": "#FF2D55", "text_on": "ink", "brandable": true},
    "data": {"meaning": "the reading: the viewer's / measured curve, the overlay series, the area fill under the part that matters", "default": "#D61FD0", "text_on": "ink", "brandable": true},
    "highlight": {"meaning": "the threshold: timeline segment bars, the highlighted page or row, the 'this part' marker", "default": "#FFE000", "text_on": "ink", "brandable": false},
    "bad": {"meaning": "the old way, the failing curve, the drop", "default": "#E0102A", "text_on": "paper", "brandable": false},
    "good": {"meaning": "the new way, the result that works, the success outline", "default": "#2BD96B", "text_on": "ink", "brandable": false},
    "mute": {"meaning": "inactive nodes, the ghost serif line, axis titles, grey bevel chips", "default": "#8A8A8A", "text_on": "ink", "bright": false},
    "ink": {"meaning": "text on paper, strokes, the caption on the paper world", "default": "#0B0B0B"},
    "paper": {"meaning": "text on stage, cards, node dots, the caption on the stage world and on footage", "default": "#FFFFFF"},
    "canvas": {"meaning": "paper world background", "default": "#E4E4E0"},
    "grid": {"meaning": "paper world grid lines", "default": "#DADAD6"},
    "night": {"meaning": "stage world background", "default": "#050505"}
  },
  "fixed_meaning": ["bad", "good"],
  "max_bright_per_frame": 3,
  "gradients": {},
  "worlds": {
    "W-stage": {"kind": "stage", "bg": "night", "dots": {"pitch": 36, "colour": "#FFFFFF", "alpha": 0.05, "r": 1.2},
                "glow": {"colour": "#FFFFFF", "alpha": 0.035, "r": 900, "x": 540, "y": 700, "drift": [0, 0, 0, 0]},
                "noise": 0, "vignette": 0, "texture": null, "particles": null},
    "W-paper": {"kind": "canvas", "bg": "canvas", "grid": {"pitch": 40, "colour": "grid", "width": 1.5, "alpha": 0.9, "fade": {"x": 540, "y": 770, "inner": 0.1, "outer": 0.3, "min": 0}},
                "noise": 0, "vignette": 0, "light": true, "texture": null, "particles": null}
  },
  "font_slots": {
    "display": {"family": "Inter Tight", "use": "lockup sans lines, step names, labels, chips", "class": "neo-grotesk sans 700-900"},
    "body": {"family": "Inter Tight", "use": "one-word captions (700)", "class": "neo-grotesk sans 600-800"},
    "serif": {"family": "Instrument Serif", "use": "italic accent spans in lockups, the caption keyword swap, annotation tags", "class": "condensed high-contrast italic serif"},
    "numeric": {"family": "Inter Tight", "use": "hero numerals (900), counters (800, tabular)", "class": "neo-grotesk sans 800-900"},
    "ui": {"family": "Inter Tight", "use": "recreated UI text inside mocks (500-600)", "class": "neo-grotesk sans 500-600"},
    "mono": {"family": "JetBrains Mono", "use": "commands, URLs and prompts typed into chat mocks", "class": "monospace 400-600"},
    "dev": {"family": "Noto Sans Devanagari", "use": "Devanagari captions and lockups (hi)", "class": "Devanagari sans 600-800"}
  },
  "type": {
    "headline": {
      "kind": "lockup", "lifetime": "section", "max_words": 8, "max_lines": 2, "read_s": 2.0, "max_emoji": 0,
      "slot": "display", "weight": 800, "size": [52, 72], "case": "title", "line_height": 1.04, "tracking": -0.01,
      "serif_ratio": 1.18, "x": [64, 1016], "top": 160, "align": "center",
      "underline": {"role": "primary", "px": 4, "offset": 10, "draw_frames": 8},
      "slab": {"role": "primary", "text": "paper", "radius": 6, "padding": [2, 16]},
      "f0": "not on frame 0: f0 shows the face window, the first one-word caption and the card skeleton; the lockup fades in (blur 4 px -> 0) and is readable by 0.4-1.0 s while the whole band zooms in (about 0.65 -> 1.0 over 0-1.5 s, ease-out); the underline draws over 8 f once the line is in",
      "exit": "blur-out 5 f, or carried off the band by P-DIAGRAM-PUSH",
      "text_class": "TC-display"
    },
    "lockup_line1": {"slot": "display", "weight": 800, "size": [44, 60], "text_class": "TC-display"},
    "lockup_line2": {"slot": "display", "weight": 800, "size": [56, 72], "text_class": "TC-display"},
    "serif_span": {"slot": "serif", "style": "italic", "weight": 400, "size_ratio": 1.18, "text_class": "TC-display"},
    "hero_numeral": {"slot": "numeric", "weight": 900, "size": [180, 240], "text_class": "TC-display"},
    "step_name": {"slot": "display", "weight": 800, "size": [64, 80], "lines": 2, "line_height": 0.98, "text_class": "TC-display"},
    "node_label": {"slot": "display", "weight": 700, "size": 40, "text_class": "TC-label"},
    "callout_tag": {"slot": "display", "weight": 700, "size": [28, 40], "fill": "paper", "text": "ink", "radius": 4, "padding": [4, 10], "text_class": "TC-label", "note": "28-39 px only with E3 and data-redundant"},
    "chip": {"slot": "display", "weight": 700, "size": 40, "fill": "#3A3A3C", "text": "paper", "radius": 6, "padding": [8, 18], "bevel": "inset 0 2px 0 rgba(255,255,255,.18)", "text_class": "TC-label"},
    "annotation": {"slot": "serif", "style": "italic", "weight": 400, "size": [52, 64], "arrow_px": 4, "text_class": "TC-label"},
    "hand_label": {"slot": "display", "weight": 800, "size": [56, 68], "arrow_px": 4, "text_class": "TC-label"},
    "mono": {"slot": "mono", "weight": 500, "size": [40, 44], "text_class": "TC-label"},
    "ui_text": {"slot": "ui", "weight": 600, "size": [40, 44], "text_class": "TC-label"},
    "counter": {"slot": "numeric", "weight": 800, "size": [40, 56], "text_class": "TC-label"},
    "legal": {"slot": "display", "weight": 500, "size": 24, "text_class": "TC-legal"}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-1",
    "by_layout": {"L-full": "CS-2", "L-clip": "CS-2"},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:kallaway",
        "unit": "word", "words": [1, 2], "max_chars_line": 18, "lines": 1,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1, "min_hold_s_per_word": 0.25, "tail_s": 0.12, "hard_pause_s": 0.9, "pause_hold_s": 0,
        "swap": {"type": "hard", "frames": 0},
        "punct": "keep",
        "skin": {"slot": "body", "weight": 700, "size": 56, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": -0.01,
                 "colour": "paper", "stroke": 0, "shadow": "0 2 6 rgba(0,0,0,.35)",
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "fixed_y", "cy": 1245, "offset": 0, "align": "center", "max_w": 952,
                     "colour_by_bg": {"light": "ink", "dark": "paper"},
                     "by_layout": {"L-split": {"anchor": "fixed_y", "cy": 1245}}},
        "emphasis": {"mechanism": "font_swap", "slot": "serif", "style": "italic", "weight": 400, "colour": null, "ratio": 1.12,
                     "select": ["topic_noun", "name", "glossary"], "max_per_chunk": 1, "max_per_s": 0.2, "min_score": 1.45,
                     "never": ["stopwords"]},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["morph"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
                     "glossary": []}
      },
      "CS-2": {
        "extends": "lib:kallaway",
        "unit": "word", "words": [1, 2], "max_chars_line": 16, "lines": 1,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1, "min_hold_s_per_word": 0.25, "tail_s": 0.12, "hard_pause_s": 0.9, "pause_hold_s": 0,
        "swap": {"type": "hard", "frames": 0},
        "punct": "keep",
        "skin": {"slot": "body", "weight": 700, "size": 66, "text_class": "TC-subtitle", "case": "as_spoken", "tracking": -0.01,
                 "colour": "paper", "stroke": 0, "shadow": "0 2 10 rgba(0,0,0,.6)",
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "fixed_y", "cy": 1160, "offset": 0, "align": "center", "max_w": 952, "colour_by_bg": null,
                     "by_layout": {"L-full": {"anchor": "fixed_y", "cy": 1160}, "L-clip": {"anchor": "fixed_y", "cy": 1160}}},
        "emphasis": {"mechanism": "font_swap", "slot": "serif", "style": "italic", "weight": 400, "colour": null, "ratio": 1.12,
                     "select": ["topic_noun", "name", "glossary"], "max_per_chunk": 1, "max_per_s": 0.2, "min_score": 1.45,
                     "never": ["stopwords"]},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["morph"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
                     "glossary": []}
      }
    }
  },
  "layout": {
    "size": [1080, 1920],
    "safe": {"x": [64, 1016], "y": [110, 1500]},
    "ig_ui": {"top": 110, "bottom": 380, "right": 110},
    "face_clearance": 40,
    "headline_top": 160,
    "caption_cy": {"split": 1245, "full": 1160, "range": [1150, 1300]},
    "card_zone": {"x": [64, 1016], "y": [380, 1160], "radius": 28},
    "band": {"x": [0, 1080], "y": [110, 1170]}
  },
  "layouts": {
    "L-split": {
      "engine": "card",
      "presenter": {"x": 64, "y": 1400, "w": 952, "h": 560, "radius": 30, "crop": "16:9", "border": 0, "shadow": 0.25, "face": 0.33, "eye": 0.16, "breakout": 120},
      "graphic": {"x": 64, "y": 150, "w": 952, "h": 1010},
      "caption": {"anchor": "fixed_y", "cy": 1245},
      "treatment": null, "share": [0.6, 0.8], "safe": null
    },
    "L-full": {
      "engine": "card",
      "presenter": {"x": 0, "y": 0, "w": 1080, "h": 1920, "radius": 0, "crop": "9:16", "border": 0, "shadow": 0, "face": 0.26, "eye": 0.36},
      "graphic": null,
      "caption": {"anchor": "fixed_y", "cy": 1160},
      "treatment": null, "share": [0.15, 0.35], "safe": null
    },
    "L-clip": {
      "engine": "hidden",
      "graphic": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "caption": {"anchor": "fixed_y", "cy": 1160},
      "treatment": null, "share": [0.0, 0.08], "safe": null
    },
    "schedule": {
      "switch_on": ["claim", "but", "number", "sentence", "pause"],
      "max_s": {"L-split": 18.0, "L-full": 4.5, "L-clip": 4.0},
      "min_s": {"L-split": 1.5, "L-full": 0.8, "L-clip": 1.5},
      "punches_per_60s": [3, 8],
      "measured": "v01 9 punches in 74 s (L-full 29%), v02 6 in 108 s (16%), v03 8 in 63 s (31%); L-full runs 0.83-4.38 s, median 2.2; L-split runs 1.75-17.7 s, median 5.5"
    }
  },
  "slots": {
    "S-HEAD": {"rect": {"x": 64, "y": 150, "w": 952, "h": 210}, "z": 5, "lifetime": "section:split", "content": ["lockup", "step_name"],
               "enter": "blur-build:6", "swap": "blur:4+6"},
    "S-CARD": {"rect": {"x": 64, "y": 380, "w": 952, "h": 780}, "z": 3, "lifetime": "section:split",
               "content": ["diagram", "motif", "ui_mock", "doc_card", "clip_card", "tile_grid", "counter_card", "logo_plate"],
               "enter": "scale-in:8", "swap": "evolve"},
    "S-CAP": {"rect": {"x": 64, "y": 1205, "w": 952, "h": 80}, "z": 7, "lifetime": "video", "content": ["caption"],
              "enter": "hard", "swap": "hard"},
    "S-WIN": {"rect": {"x": 64, "y": 1400, "w": 952, "h": 520}, "z": 4, "lifetime": "section:split", "content": ["face"],
              "enter": "cut", "swap": "cut"}
  },
  "motion": {
    "lead_frames": 2,
    "ease_entry": [0.22, 1, 0.36, 1],
    "ease_exit": [0.64, 0, 0.78, 0],
    "ease_in_out": [0.65, 0, 0.35, 1],
    "blur_build_frames": 6,
    "blur_build_px": 12,
    "word_stagger_frames": 3,
    "underline_draw_frames": 8,
    "slab_sweep_frames": 6,
    "card_scale_in": {"from": 0.92, "frames": 8, "blur_px": 10},
    "curve_draw_frames": [24, 40],
    "node_pop_frames": 5,
    "callout_pop_frames": 6,
    "chip_stack_frames": 6,
    "push_frames": [12, 24],
    "push_scale": [1.6, 2.4],
    "lockup_line_fade_frames": 6,
    "lockup_line_stagger_frames": 5,
    "word_build_frames": 4,
    "hook_band_zoom": {"from": 0.65, "to": 1.0, "frames": 45, "ease": "out"},
    "smear_push": {"frames_out": 3, "frames_in": 4, "dx_px": 700, "motion_blur_px": 40, "scene": {"in": "slide-r", "in_frames": 4, "out": "slide-l", "out_frames": 3, "smear": true}},
    "detail_cutzoom": {"scale": [2.0, 2.6], "blur_in_frames": 4},
    "clip_pullout": {"to_scale": 0.62, "frames": 8, "device": "phone"},
    "motif_pan": {"travel_px": [400, 700], "frames": 8, "settle_frames": 16, "ease": "expo-out"},
    "mini_player_swap_frames": 5,
    "title_swap_frames": [4, 6],
    "counter_step_frames": 5,
    "typewriter_chars_per_frame": 1,
    "row_stagger_frames": 2,
    "hold_min_frames": 10,
    "text_hold_per_word_s": 0.25
  },
  "camera_presets": {
    "push-drift": {"id": "Z-2", "scale": [1.0, 1.05], "frames": "beat", "tones": ["hype", "explain", "awe"], "note": "occasional slow push over one L-full run (v02 @ 1:08-1:11); never on two runs in a row"},
    "punch-in": {"id": "Z-3", "scale": [1.0, 1.15], "frames": 1, "hold": "until_next_cut", "tones": ["hype", "warn", "explain"], "max_per_reel": 6, "note": "framing step on a jump cut inside an L-full run >= 2 s; measured 1.08-1.22x in about half the runs"}
  },
  "zoom_policy": "crop_on_cut",
  "stage_morphs": {"cut": 0},
  "hooks": {
    "default": "HA-06",
    "allowed": ["HA-06", "HA-02", "HA-07", "HA-05"],
    "stopper": {"tests": ["ST-1", "ST-2", "ST-3", "ST-4", "ST-5", "ST-6"], "thumb_scale": 0.25, "read_s": 2.0, "hook_sc_3s": 9, "payoff_by_s": 2.5},
    "f0": {"require": ["presenter"], "forbid": []}
  },
  "structure": {
    "type": "framework",
    "markers": {"style": "SM-NUM", "numbering": "asc", "recap": true, "teaser": false},
    "rehook_every_s": 30,
    "intro_max_ratio": 0.15
  },
  "cadence": {
    "sc_per_10s": [11, 24],
    "hook_sc_3s": 9,
    "max_gap_s": 4.0,
    "hook_max_gap_s": 1.5,
    "max_static_s": 2.0,
    "caption_weight": 0.34,
    "cuts_per_min": null,
    "median_shot_s": null,
    "measured": "scene-cut median shot 2.9 / 4.4 / 3.4 s (v01-v03); card events inside L-split every 0.3-1.5 s",
    "continuous_motion_required": false
  },
  "budgets": {"sfx_per_10s": 4, "sfx_max_uses_per_file": 2},
  "exceptions": {
    "E3": {"subtitle_min_px": 54, "label_min_px": 28, "contrast_min": 7.0, "pill_contrast_min": 4.5, "weight_min": 600},
    "E6": {"slot_tolerance_px": 4}
  },
  "data": {
    "formulas": ["sum", "diff", "ratio", "percent_change", "per_period"],
    "tolerance": "display_rounding",
    "same_scale_rule": true
  },
  "citations": null,
  "inserts": {
    "fetch": false,
    "ask_creator": true,
    "create_fallbacks": ["quote_card", "headline_card", "recreated_ui", "diagram", "logo_plate", "silhouette"],
    "patterns": ["P-CLIP-INTERCUT", "P-CLIP-CARD", "P-CLIP-TAG", "P-MINI-PLAYER", "P-TILE-WALL", "P-LOGO-LINK", "P-SHOT-CARD", "P-CLIP-PULLOUT"]
  },
  "footage": {
    "setups": [
      {"id": "A", "desc": "landscape 16:9, 3840x2160, 30 fps, locked-off at eye level, medium-wide (waist up), presenter centred, one coloured practical light in the background, plain dark top, hands free to gesture",
       "framing": {"head_top_frac": [0.12, 0.22], "face_h_frac": [0.20, 0.26], "face_cx_frac": [0.42, 0.58]}},
      {"id": "B", "desc": "fallback: vertical 9:16 1080x1920 phone or camera take, head top at 10-14% of frame height, chest-up",
       "framing": {"head_top_frac": [0.10, 0.14], "face_h_frac": [0.16, 0.22]}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "the single talking-head take (setup A)", "per_60s": [1, 1], "must": true, "formats": ["F-A"], "fallback": "FB-1"},
      {"id": "SH-2", "desc": "the creator's own screen recordings or screenshots of a tool, page or dashboard they show", "per_60s": [0, 4], "must": false, "formats": ["F-A"], "fallback": "FB-3"},
      {"id": "SH-3", "desc": "the creator's own reels, thumbnails or B-roll clips (2-4 s each) for tile walls, clip cards and the mid-reel intercut", "per_60s": [0, 3], "must": false, "formats": ["F-A"], "fallback": "FB-4"}
    ],
    "fallbacks": [
      {"id": "FB-1", "does": "vertical 1080x1920 take (setup B): the window frames head and shoulders (face 0.30 of the window), L-full uses the native frame at face 0.24 (<= 1.15x)", "cost": "the window loses the room and the wide-vs-tight contrast between the two modes is smaller", "result": "degraded"},
      {"id": "FB-2", "does": "landscape 1920x1080 take: L-full face 0.20 (a 1.35x crop of the 9:16 slice), window as setup A", "cost": "full-face punches are looser and slightly soft", "result": "degraded"},
      {"id": "FB-3", "does": "recreated generic UI (fx.appUI / fx.device) built from the words of the script", "cost": "no real product footage", "result": "holds"},
      {"id": "FB-4", "does": "created typographic tiles (topic word + number + tint) in the tile wall / clip card; the mid-reel intercut becomes a full-band diagram beat instead", "cost": "no outside footage texture", "result": "holds"}
    ],
    "props": [],
    "reaction_bank": [],
    "matte": "optional",
    "min_source_px": {"punch_2x": 2160, "punch_1_35x": 1080}
  },
  "continuity": {
    "motif": {"id": "M-DIAGRAM", "shape": "loop | ring | ladder | chain | axes | road", "size": [640, 900], "glow": 24,
              "states": ["build", "idle", "visit:n", "recap"]},
    "recurring_diagram": {"min_visits": 3, "active": {"role": "accent", "glow_px": 28}, "inactive_opacity": 0.35, "same_position": true},
    "morph_required": false,
    "bookend": false
  },
  "series": null,
  "brand": {
    "sponsor": {"card": "P-SPONSOR-CARD", "disclosure": "Paid partnership", "disclosure_hold_s": 2.0},
    "endcard": null
  },
  "sound": {
    "cue_moments": ["hook", "reveals", "list_cue", "cta"],
    "meme_cues": false,
    "bed": {"on": true, "enter": "after_hook"},
    "duck_db": -18,
