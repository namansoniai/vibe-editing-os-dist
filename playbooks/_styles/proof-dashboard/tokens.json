{
  "schema": "veos.tokens/3",
  "playbook": "proof-dashboard",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "proof-dashboard",
    "name": "Proof Dashboard",
    "template_version": 1,
    "inspired_by": ["devinjatho"],
    "evidence": "analysis/short/devinjatho.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "profile.duration.target_s",
      "sound.bed",
      "captions.profiles.CS-1.language.profanity_mask",
      "captions.profiles.CS-1.skin.case"
