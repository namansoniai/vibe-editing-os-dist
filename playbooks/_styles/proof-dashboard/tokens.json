  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "talking_head",
    "presenter": {"presence": "host", "share": [35, 65], "max_absence_s": 10},
    "spine": "talking_head",
    "captions": {"mode": "full", "role": "support", "mute_policy": "mute_safe"},
    "graphics": "primary",
    "duration": {"class": "standard", "target_s": [45, 90]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0,
                "style": "short", "compact_decimals": 1, "percent_decimals": 0},
    "tone": {"energy": "hype", "comedy": "light", "comedy_max": "light"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A"], "default": "F-A"},
    "footage_dependency": "medium",
    "cta": {"devices": ["comment_keyword", "dm"], "placement": "end"},
    "modules": {
      "chrome": false, "running_state": true, "anchors": true, "data_figures": true, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": false, "continuity": false, "series": false, "brand": false
    }
  },
  "formats": {
    "F-A": {
      "name": "Proof Dashboard",
      "when": "every reel: a feature, setting, tactic or result explained by a creator on a virtual set, proven with real UI and real numbers",
      "profile": {},
      "layouts": ["L-set", "L-set-dim", "L-ui", "L-bubble", "L-in-app"],
      "hooks": {"default": "HA-02"},
      "structure": {"type": "tutorial"},
      "shared_dna": "matted presenter on a swapped dark virtual set, a two-line glow banner at the chest on frame 0, neon red/green/gold meaning, UI proof with a cursor orb, 1-4 word caps captions with one glowing keyword"
    }
  },
  "tone": {"energy": "hype", "meme_sfx": false, "roast": false, "caption_density": "high", "comedy": "light"},
  "roles": {
    "primary": {"meaning": "signature glow: the banner's glow line and the default caption keyword glow (type only, never a card fill)", "default": "#F5F000", "text_on": "ink", "brandable": true},
    "accent": {"meaning": "UI accent: step pills, toggles switched on, highlighter boxes", "default": "#1F6FEB", "text_on": "paper", "brandable": true},
    "send": {"meaning": "the DM / comment pill send button and the in-app Post button (sampled #6060E0, v04 @ 0:46, v05 @ 0:05)", "default": "#6060E0", "text_on": "paper", "brandable": false},
    "box_blue": {"meaning": "the keyword highlight box behind a caption chunk (cyan-blue gradient #20A8E8 -> #68D8F8, v01 @ 0:08-0:09)", "default": "#2AAEEB", "text_on": "paper", "brandable": false},
    "box_yellow": {"meaning": "the hype-word box behind a caps caption (sampled #DCD22C, v01 @ 0:10 LEGENDARY)", "default": "#DCD22C", "text_on": "ink", "brandable": false},
    "data": {"meaning": "the cursor orb, tap ripples, link glyphs and tech/feature keyword glow", "default": "#5CE1E6", "text_on": "ink", "brandable": false},
    "winner": {"meaning": "the winning card, number or option: gold border, gold counter, flare sweep (proof elements only)", "default": "#FFC83D", "text_on": "ink", "brandable": false},
    "bad": {"meaning": "wrong, the losing card, the mistake, warning icons", "default": "#FF2D2D", "text_on": "ink", "brandable": false},
    "good": {"meaning": "right, fixed, the solution, check marks", "default": "#39FF4A", "text_on": "ink", "brandable": false},
    "ink": {"meaning": "text on bright fills, deepest shadows", "default": "#0B0B10"},
    "paper": {"meaning": "caption and banner white, light UI cards", "default": "#FFFFFF"},
    "night": {"meaning": "UI world and data stage background", "default": "#08090D"},
    "panel": {"meaning": "dark UI surfaces: phone cards, input pills, notification cards", "default": "#16181F"},
    "muted": {"meaning": "ghost cards before the verdict, inactive rows, the losing counter at rest", "default": "#8B9099"},
    "canvas": {"meaning": "light article / document world", "default": "#F6F7F9"}
  },
  "fixed_meaning": ["bad", "good", "winner"],
  "max_bright_per_frame": 3,
  "gradients": {
    "platform": ["#F58529", "#DD2A7B", "#8134AF"],
    "winner": ["#FFF1B8", "#FFC83D", "#C98A00"],
    "good": ["#B9FFC3", "#39FF4A", "#12B82A"],
    "bad": ["#FF9A9A", "#FF2D2D", "#B30012"]
  },
  "worlds": {
    "W-set-skyline": {"kind": "backdrop", "bg": "#0A0F1E",
      "gradient": {"stops": ["#070B16", "#101A33", "#1B2240"], "angle": 180},
      "glow": {"colour": "#FFB65C", "alpha": 0.10, "r": 520, "x": 760, "y": 520, "drift": [12, 8, 0.25, 0.2]},
      "dots": null, "bokeh": {"count": [28, 40], "d": [20, 60], "colours": ["#FFB65C", "#FFE2B0", "#F4F1EA"], "alpha": [0.2, 0.45], "blur_px": [6, 14], "zone_y": [0, 1150], "note": "photographic blurred night-city window lights (v03 / v04 / v05 sets); a regular dot grid reads as a pixel skyline and is wrong; prefer the creator's own blurred city plate as `texture`"},
      "noise": 0.03, "vignette": 0.35, "texture": null, "particles": null},
    "W-set-neon-red": {"kind": "backdrop", "bg": "#120406",
      "gradient": {"radial": {"x": 540, "y": 560, "stops": ["#7A0F1A", "#2A060A", "#0B0204"]}},
      "glow": {"colour": "#FF2D2D", "alpha": 0.16, "r": 460, "x": 540, "y": 520, "drift": [10, 6, 0.3, 0.2]},
      "noise": 0.03, "vignette": 0.45, "texture": null, "particles": null},
    "W-set-neon-blue": {"kind": "backdrop", "bg": "#040A16",
      "gradient": {"radial": {"x": 540, "y": 560, "stops": ["#123E8C", "#081A3A", "#02060E"]}},
      "glow": {"colour": "#2F80FF", "alpha": 0.16, "r": 460, "x": 540, "y": 520, "drift": [10, 6, 0.3, 0.2]},
      "noise": 0.03, "vignette": 0.45, "texture": null, "particles": null},
    "W-set-warm": {"kind": "backdrop", "bg": "#1C140E",
      "gradient": {"stops": ["#2B1E14", "#3A2A1C", "#140E09"], "angle": 180},
      "glow": {"colour": "#FFB65C", "alpha": 0.12, "r": 600, "x": 300, "y": 600, "drift": [8, 6, 0.2, 0.2]},
      "noise": 0.04, "vignette": 0.40, "texture": null, "particles": null},
    "W-ui-dark": {"kind": "stage", "bg": "#08090D", "noise": 0.0, "vignette": 0.0, "texture": null, "particles": null},
    "W-ui-light": {"kind": "canvas", "bg": "#F6F7F9", "light": true, "noise": 0.0, "vignette": 0.0, "texture": null, "particles": null},
    "W-stage": {"kind": "stage", "bg": "#0B0B10",
      "glow": {"colour": "#5CE1E6", "alpha": 0.08, "r": 520, "x": 540, "y": 860, "drift": [14, 10, 0.25, 0.2]},
      "noise": 0.02, "vignette": 0.30, "texture": null, "particles": null},
    "W-verdict-red": {"kind": "void", "bg": "#0D0102",
      "gradient": {"radial": {"x": 540, "y": 900, "stops": ["#5C0610", "#200205", "#060001"]}},
      "noise": 0.02, "vignette": 0.40, "texture": null, "particles": null},
    "W-verdict-green": {"kind": "void", "bg": "#010D04",
      "gradient": {"radial": {"x": 540, "y": 900, "stops": ["#0B5C1C", "#032008", "#010602"]}},
      "noise": 0.02, "vignette": 0.40, "texture": null, "particles": null}
  },
  "font_slots": {
    "display": {"family": "Montserrat", "use": "hero numbers, verdict words", "class": "geometric extended heavy caps 800-900"},
    "banner": {"family": "Montserrat", "use": "the glow banner (hook headline); Montserrat Black matches v01 / v03 / v04 / v05 letterforms (audit 2026-10-06); a techno face only for a word like CHEATCODE", "class": "geometric heavy caps 900, tracking -0.01"},
    "body": {"family": "Montserrat", "use": "captions (CS-1...), transcript blocks", "class": "geometric heavy sans 700-900"},
    "ui": {"family": "Plus Jakarta Sans", "use": "recreated UI, step pills, notifications, input pills", "class": "neutral UI grotesk 500-800"},
    "numeric": {"family": "Inter Tight", "use": "view counters, countdown digits, donut percent", "class": "tabular grotesk 500-800"},
    "script": {"family": "Pinyon Script", "use": "the one celebration word (P-CELEBRATE)", "class": "formal script 400"},
    "mono": {"family": "JetBrains Mono", "use": "viewfinder timecode, REC overlay", "class": "monospace 400-700"}
  },
  "type": {
    "headline": {"kind": "banner", "lifetime": "hook", "max_words": 5, "max_lines": 2, "max_emoji": 0, "read_s": 1.25,
                 "chips": null, "z": 8, "cx": 540, "cy": 1010, "block_w": 820,
                 "order": "either line may glow: white over colour (v01 NEVER POST / INSTAGRAM, v04 YOU FINALLY / DID IT!) or the platform word in the platform gradient on top with the white line under it (v03 INSTAGRAM / BIG D*CK UPDATE at 0.55x, v05 INSTAGRAM / CHEATCODE)",
                 "colour_by_meaning": "warning -> bad, win -> good (green glow), secret / feature -> primary or the platform's own gradient on the platform word",
                 "line1": {"slot": "banner", "weight": 900, "size": [64, 120], "colour": "paper", "case": "upper", "tracking": -0.01},
                 "line2": {"slot": "banner", "weight": 900, "size": [64, 120], "colour": "primary", "case": "upper", "tracking": -0.01,
                           "glow": [18, 42]},
                 "line_height": 0.98, "shadow": "0 6 18 rgba(0,0,0,.55)", "radius": 0, "rotate": 0, "stroke": 0,
                 "f0": "fully built and readable on frame 0; floats +-6 px on a 2 s sine", "exit": "glitch-shatter 12 f or blur-rise 6 f, between 2.6 and 3.6 s",
                 "text_class": "TC-display"},
    "step_pill": {"slot": "ui", "weight": 700, "size": 46, "fill": "accent", "colour": "paper", "radius": 18, "padding": [12, 28], "glow": 24, "text_class": "TC-label"},
    "hero_counter": {"slot": "numeric", "weight": 700, "size": [120, 200], "colour": "paper", "glow": 22, "text_class": "TC-display"},
    "card_counter": {"slot": "numeric", "weight": 700, "size": [44, 56], "colour": "paper", "chip": "panel", "radius": 14, "text_class": "TC-label"},
    "transcript_block": {"slot": "body", "weight": 800, "size": 44, "case": "upper", "lines": [3, 6], "colour": "paper", "text_class": "TC-label"},
    "verdict_word": {"slot": "display", "weight": 900, "size": [72, 110], "case": "upper", "glow": [16, 36], "text_class": "TC-display"},
    "celebration": {"slot": "script", "weight": 400, "size": [120, 150], "colour": "winner", "glow": 20, "text_class": "TC-display"},
    "countdown": {"slot": "numeric", "weight": 500, "size": 150, "tracking": 0.06, "colour": "paper", "unit_size": 40, "text_class": "TC-display"},
    "notification": {"slot": "ui", "weight": 600, "size": 40, "fill": "panel", "radius": 32, "text_class": "TC-label"},
    "dm_keyword": {"slot": "ui", "weight": 500, "size": 58, "case": "as_typed", "fill": "#1B1B1B", "fill_opacity": 0.85, "radius": 48, "send_button": {"fill": "send", "w": 124, "h": 84, "radius": 28}, "avatar_d": 84, "cy": 980, "x": [200, 940], "text_class": "TC-display",
                   "note": "sentence-case keyword typed in a dark translucent pill, creator avatar left, violet send button right (v04 @ 0:46)"},
    "legal_label": {"slot": "ui", "weight": 700, "size": 24, "case": "upper", "tracking": 0.12, "colour": "paper", "opacity": 0.8, "text_class": "TC-legal"},
    "ui_chrome": {"slot": "ui", "weight": 500, "size": [18, 34], "text_class": "TC-decorative"},
    "viewfinder": {"slot": "mono", "weight": 500, "size": 26, "text_class": "TC-decorative"}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-1",
    "by_layout": {},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:devin",
        "unit": "group", "words": [1, 4], "max_chars_line": 12, "lines": 2,
        "no_split": ["names", "numbers", "units"], "punct": "strip_end",
        "lead_frames": 1, "min_hold_s_per_word": 0.25, "tail_s": 0.12, "hard_pause_s": 0.9,
        "swap": {"type": "hard", "frames": 0}, "pause_hold_s": 0,
        "skin": {"slot": "body", "weight": 800, "size": 96, "text_class": "TC-subtitle", "case": "upper", "tracking": 0.01,
                 "line_height": 1.0, "colour": "paper", "stroke": 0, "shadow": "0 4 14 rgba(0,0,0,.65)",
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "fixed_y", "cy": 1000, "offset": 0, "align": "center", "max_w": 900, "colour_by_bg": null,
                     "avoid_face": true, "hide_on_morph": true,
                     "by_layout": {"L-set-dim": {"anchor": "fixed_y", "cy": 1420}, "L-ui": {"anchor": "fixed_y", "cy": 1430},
                                   "L-bubble": {"anchor": "fixed_y", "cy": 1380}, "L-in-app": {"anchor": "inside_footage", "cy": 1360}}},
        "emphasis": {"mechanism": "glow", "colour": "primary", "glow_px": 18, "ratio": 1.08, "span": "phrase",
                     "select": ["number", "name", "glossary", "topic_noun"], "max_per_chunk": 1, "max_per_s": 0.5,
                     "never": ["stopwords"], "min_score": 1.2},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8", "transitions"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false,
                     "glossary": []}
      },
      "CS-BOX": {"extends": "lib:devin", "name": "keyword box (blue)", "unit": "group", "words": [1, 3], "max_chars_line": 16, "lines": 1, "punct": "strip_end",
                 "swap": {"type": "hard", "frames": 0},
                 "skin": {"slot": "ui", "weight": 600, "size": 64, "text_class": "TC-subtitle", "case": "as_spoken", "line_height": 1.0, "colour": "paper", "shadow": "none",
                          "container": {"type": "box", "fill": "#2AAEEB", "opacity": 1, "radius": 10, "padding": [10, 22], "glow": 24}},
                 "position": {"anchor": "fixed_y", "cy": 1050, "max_w": 900, "avoid_face": true},
                 "emphasis": {"mechanism": "none"},
                 "use": "a feature or product name said as the beat's subject (v01 @ 0:08-0:09 \"Linking Reels\" in a cyan box, x 265-792)",
                 "hide": ["under_z8", "transitions"], "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-HYPE": {"extends": "lib:devin", "name": "hype box (yellow)", "unit": "group", "words": [1, 2], "max_chars_line": 12, "lines": 1, "punct": "strip_end",
                  "swap": {"type": "hard", "frames": 0},
                  "skin": {"slot": "display", "weight": 900, "size": 88, "text_class": "TC-subtitle", "case": "upper", "line_height": 1.0, "colour": "ink", "shadow": "none",
                           "container": {"type": "box", "fill": "#DCD22C", "opacity": 1, "radius": 0, "padding": [8, 26]}},
                  "position": {"anchor": "fixed_y", "cy": 1060, "max_w": 940, "avoid_face": true},
                  "emphasis": {"mechanism": "none"},
                  "use": "one hype payoff word per reel (v01 @ 0:10 LEGENDARY, box x 160-922, y 996-1120); a masked swear word above it may use the marker font",
                  "hide": ["under_z8", "transitions"], "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-BAD": {"extends": "lib:devin", "unit": "group", "words": [1, 4], "max_chars_line": 12, "lines": 2, "punct": "strip_end", "swap": {"type": "hard", "frames": 0},
                 "skin": {"slot": "body", "weight": 800, "size": 96, "text_class": "TC-subtitle", "case": "upper", "line_height": 1.0,
                          "colour": "paper", "shadow": "0 4 14 rgba(0,0,0,.65)"},
                 "position": {"anchor": "fixed_y", "cy": 1000, "max_w": 900, "avoid_face": true,
                              "by_layout": {"L-set-dim": {"anchor": "fixed_y", "cy": 1420}, "L-ui": {"anchor": "fixed_y", "cy": 1430},
                                            "L-bubble": {"anchor": "fixed_y", "cy": 1380}}},
                 "emphasis": {"mechanism": "glow", "colour": "bad", "glow_px": 20, "ratio": 1.08, "span": "phrase",
                              "select": ["number", "name", "glossary", "topic_noun", "key_verb"], "max_per_chunk": 1, "max_per_s": 0.6},
                 "hide": ["under_z8", "transitions"],
                 "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-GOOD": {"extends": "lib:devin", "unit": "group", "words": [1, 4], "max_chars_line": 12, "lines": 2, "punct": "strip_end", "swap": {"type": "hard", "frames": 0},
                  "skin": {"slot": "body", "weight": 800, "size": 96, "text_class": "TC-subtitle", "case": "upper", "line_height": 1.0,
                           "colour": "paper", "shadow": "0 4 14 rgba(0,0,0,.65)"},
                  "position": {"anchor": "fixed_y", "cy": 1000, "max_w": 900, "avoid_face": true,
                               "by_layout": {"L-set-dim": {"anchor": "fixed_y", "cy": 1420}, "L-ui": {"anchor": "fixed_y", "cy": 1430},
                                             "L-bubble": {"anchor": "fixed_y", "cy": 1380}}},
                  "emphasis": {"mechanism": "glow", "colour": "good", "glow_px": 20, "ratio": 1.08, "span": "phrase",
                               "select": ["number", "name", "glossary", "topic_noun", "key_verb"], "max_per_chunk": 1, "max_per_s": 0.6},
                  "hide": ["under_z8", "transitions"],
                  "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-DATA": {"extends": "lib:devin", "unit": "group", "words": [1, 4], "max_chars_line": 12, "lines": 2, "punct": "strip_end", "swap": {"type": "hard", "frames": 0},
                  "skin": {"slot": "body", "weight": 800, "size": 96, "text_class": "TC-subtitle", "case": "upper", "line_height": 1.0,
                           "colour": "paper", "shadow": "0 4 14 rgba(0,0,0,.65)"},
                  "position": {"anchor": "fixed_y", "cy": 1000, "max_w": 900, "avoid_face": true,
                               "by_layout": {"L-set-dim": {"anchor": "fixed_y", "cy": 1420}, "L-ui": {"anchor": "fixed_y", "cy": 1430},
                                             "L-bubble": {"anchor": "fixed_y", "cy": 1380}}},
                  "emphasis": {"mechanism": "glow", "colour": "data", "glow_px": 20, "ratio": 1.08, "span": "phrase",
                               "select": ["number", "name", "glossary", "topic_noun"], "max_per_chunk": 1, "max_per_s": 0.5},
                  "hide": ["under_z8", "transitions"],
                  "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-WIN": {"extends": "lib:devin", "unit": "group", "words": [1, 4], "max_chars_line": 12, "lines": 2, "punct": "strip_end", "swap": {"type": "hard", "frames": 0},
                 "skin": {"slot": "body", "weight": 800, "size": 96, "text_class": "TC-subtitle", "case": "upper", "line_height": 1.0,
                          "colour": "paper", "shadow": "0 4 14 rgba(0,0,0,.65)"},
                 "position": {"anchor": "fixed_y", "cy": 1000, "max_w": 900, "avoid_face": true,
                              "by_layout": {"L-set-dim": {"anchor": "fixed_y", "cy": 1420}, "L-ui": {"anchor": "fixed_y", "cy": 1430},
                                            "L-bubble": {"anchor": "fixed_y", "cy": 1380}}},
                 "emphasis": {"mechanism": "glow", "colour": "winner", "glow_px": 22, "ratio": 1.1, "span": "phrase",
                              "select": ["number", "name", "glossary", "topic_noun"], "max_per_chunk": 1, "max_per_s": 0.5},
                 "hide": ["under_z8", "transitions"],
                 "language": {"script": "Latn", "transliteration": "keep_english_terms"}},
      "CS-SOFT": {"extends": "lib:devin", "unit": "group", "words": [1, 3], "max_chars_line": 18, "lines": 1, "punct": "strip_end",
                  "swap": {"type": "fade", "frames": 6},
                  "skin": {"slot": "ui", "weight": 700, "size": 66, "text_class": "TC-subtitle", "case": "as_spoken", "line_height": 1.05,
                           "colour": "primary", "shadow": "0 0 18 rgba(245,240,0,.45), 0 4 12 rgba(0,0,0,.6)"},
                  "position": {"anchor": "fixed_y", "cy": 1040, "max_w": 900, "avoid_face": true},
                  "emphasis": {"mechanism": "none"},
                  "hide": ["under_z8", "transitions"],
                  "language": {"script": "Latn", "transliteration": "keep_english_terms"}}
    }
  },
  "layout": {
    "size": [1080, 1920],
    "safe": {"x": [64, 1016], "y": [110, 1500]},
    "ig_ui": {"top": 110, "bottom": 380, "right": 110},
    "face_clearance": 40,
    "chest_band": {"cy": 1000, "range": [940, 1080], "h": 200},
    "proof_band": {"y": [1130, 1500]},
    "caption_cy": {"full": 1000, "low": 1430, "range": [960, 1100]},
    "side_card": {"w": 300, "h": 534, "y": 360, "x_left": 64, "x_right": 716},
