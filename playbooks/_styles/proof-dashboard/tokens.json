  "layouts": {
    "L-set": {"engine": "full", "caption": {"anchor": "fixed_y", "cy": 1000}, "treatment": null, "share": [0.35, 0.65], "safe": null},
    "L-set-dim": {"engine": "full", "caption": {"anchor": "fixed_y", "cy": 1420},
