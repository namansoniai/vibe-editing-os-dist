  "formats": {
    "F-A": {
      "name": "Archive explainer",
      "when": "a voice-over explainer about a person, company, place, event or rule: why something happened, who is behind it, how it works; 45-80 s",
      "profile": {},
      "layouts": [
        "L-A-canvas",
        "L-end"
      ],
      "hooks": {
        "default": "HA-11",
        "allowed": [
          "HA-11",
          "HA-12",
          "HA-07",
          "HA-19"
        ]
      },
      "structure": {
        "type": "explainer",
        "rehook_every_s": 25
      },
      "shared_dna": "the boxed caption is the headline; one brand blue (canvas in F-A, caption boxes and QR card in F-B); a branded end card with the creator's wordmark"
    },
    "F-B": {
      "name": "Podcast clip",
      "when": "a 30-60 s moment cut from the creator's own two-camera conversation (podcast, interview, panel)",
      "profile": {
        "source_type": "multi_speaker",
        "presenter": {
          "presence": "anchor",
          "share": [
            85,
            100
          ],
          "max_absence_s": 4
        },
        "spine": "talking_head",
        "graphics": "minimal",
        "duration": {
          "class": "short",
          "target_s": [
            30,
            60
          ]
        },
        "footage_dependency": "high",
        "modules": {
          "data_figures": false,
          "citations": false,
          "dialogue": true
        }
      },
      "layouts": [
        "L-B-full",
        "L-end"
      ],
      "hooks": {
        "default": "HA-14",
        "allowed": [
          "HA-14",
          "HA-03"
        ],
        "stopper": {
          "tests": [
            "ST-2",
            "ST-3",
            "ST-6"
          ],
          "thumb_scale": 0.25,
          "read_s": 1.2,
          "hook_sc_3s": 2,
          "payoff_by_s": 1.0
        },
        "f0": {
          "require": [
            "caption",
            "footage"
          ],
          "forbid": [
            "headline"
          ]
        }
      },
      "structure": {
        "type": "conversation",
        "markers": {
          "style": "none",
          "numbering": "asc",
          "recap": false,
          "teaser": false
        }
      },
      "cadence": {
        "sc_per_10s": [
          5,
          12
        ],
        "hook_sc_3s": 2,
        "max_gap_s": 3.0,
        "max_static_s": 4.0,
        "caption_weight": 1.0,
        "cuts_per_min": [
          7,
          16
        ],
        "median_shot_s": [
          2.0,
          5.0
        ],
        "continuous_motion_required": false
      },
      "captions": {
        "default": "CS-B"
      },
      "zoom_policy": "crop_on_cut",
      "shared_dna": "the boxed caption is the headline; one brand blue (canvas in F-A, caption boxes and QR card in F-B); a branded end card with the creator's wordmark"
    }
  },
