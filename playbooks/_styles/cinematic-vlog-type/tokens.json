  "footage": {
    "setups": [
      {"id": "A", "desc": "location talking piece: handheld selfie or gimbal at arm's length, natural light, 24/25/30 fps, 4K preferred", "framing": {"head_top_y": [250, 520]}},
      {"id": "B", "desc": "seated interview set: tripod, 50-85 mm, warm practicals (lamp, wall texture), shallow depth", "framing": {"head_top_y": [420, 700]}},
      {"id": "C", "desc": "wide / overhead: presenter small in a composed frame (drone, high angle, frame-within-frame)", "framing": {"head_top_y": [600, 1100]}},
      {"id": "D", "desc": "clean-matte headroom shot for behind-head words: plain or distant background, >= 300 px above the head", "framing": {"head_top_y": [560, 800]}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "opening shot: moving, composed (mirror, doorway, window, overhead, walk-in); 3-5 s plus a 1.5 s pre-roll handle for the bookend", "per_60s": [1, 1], "must": true, "formats": ["F-A", "F-B"], "fallback": "FB-1"},
