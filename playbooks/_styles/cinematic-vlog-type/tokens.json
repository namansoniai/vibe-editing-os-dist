        "punct_break": true,
        "punct": "keep",
        "swap": {"type": "hard", "frames": 0},
        "pause_hold_s": 0,
        "skin": {"slot": "serif", "weight": 600, "size": 54, "text_class": "TC-subtitle", "case": "sentence", "tracking": 0,
                 "line_height": 1.15, "colour": "subtitle", "stroke": 1, "stroke_colour": "shade",
                 "shadow": "2 3 2 rgba(0,0,0,.85)",
                 "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}},
        "position": {"anchor": "fixed_y", "cy": 1468, "offset": 0, "align": "center", "max_w": 952, "colour_by_bg": null, "hide_on_morph": true},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8", "E2", "morph"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      }
    }
