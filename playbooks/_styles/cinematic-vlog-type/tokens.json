      {"id": "SH-3", "desc": "walk-in and walk-out at the same spot (entrance at 0 s, exit at the end)", "per_60s": [1, 1], "must": false, "formats": ["F-A"], "fallback": "FB-3"},
      {"id": "SH-4", "desc": "location B-roll: details, hands, products, POV, macro inserts, 1-2 s each", "per_60s": [20, 40], "must": true, "formats": ["F-A", "F-B"], "fallback": "FB-4"},
      {"id": "SH-5", "desc": "talking pieces in 2-5 different setups or locations", "per_60s": [2, 5], "must": true, "formats": ["F-A", "F-B"], "fallback": "FB-5"},
