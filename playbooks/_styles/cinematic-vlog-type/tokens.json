    "flash": {"type": "flash", "frames": 6, "pre": 2, "peak": 0.9, "decay": 1.6, "burst": {"frames": 1, "pre": 0, "peak": 1}, "warm": {"colour": "#FFF6C8", "frames": 7, "pre": 4, "peak": 0.9}, "max_per_s": 3, "render": "built-in timeline.transitions[] (SCENES-API 4c)"},
    "typewriter_chars_per_frame": {"cta_line": 2, "chaos_snippet": 1},
    "zoom_through": {"punch_scale": 1.6, "punch_frames": 4, "pullout_from": 2.3, "pullout_frames": 24, "out": {"type": "zoom-blur", "frames": 6, "pre": 4, "amount": 0.3, "punch": 0.4, "layers": "all"}, "in": {"preset": "zoom-land", "land": 1.5, "note": "V-CAMERA slow_push landing cap 1.5x; source 2.3x"}},
    "whip": {"out_frames": 6, "in_frames": 14, "in_travel_px": 750, "transition": {"type": "whip", "frames": 20, "pre": 6, "px": 90, "travel": 750, "blend": 0}},
    "count_digit_frames": 6,
    "ink_draw_frames": 10,
    "vortex_frames": 8,
    "vortex": {"type": "zoom-blur", "frames": 9, "pre": 8, "amount": 0.3, "punch": 0.4},
