    "zoom-land": {"id": "Z-4", "land": 1.5, "frames": 24, "ease": "expoOut", "blur": {"kind": "radial", "amount": 0.18, "shape": "decay"}, "max_per_reel": 1, "tones": ["hype", "explain"], "note": "incoming half of T-12 only, on the cut; source pulls out from 2.3x, the slow_push landing exemption caps it at 1.5x"},
    "reset": {"id": "Z-3"}
  },
  "zoom_policy": "slow_push",
  "stage_morphs": {"cut": 0, "shrink-to-card": 12, "grow-from-card": 10, "fade-through": 8},
  "grades": {
    "footage": {"lift": 0.02, "gamma": 1.0, "gain": 1.0, "warmth": 0.08, "saturation": 1.06, "bloom": 0.08, "vignette": 0.12,
                "filter": "sepia(0.12) saturate(1.08) contrast(1.04)"},
    "scene": {
      "GR-mono": {"filter": "grayscale(1) contrast(1.18) brightness(0.92)", "use": "the negative / stuck persona, self-doubt, the problem state"},
      "GR-amber": {"filter": "sepia(0.45) saturate(1.35) hue-rotate(-10deg) contrast(1.06) brightness(0.96)", "use": "nostalgia, the obsessive / collector persona, late-night"},
      "GR-teal": {"filter": "sepia(0.35) hue-rotate(140deg) saturate(1.25) contrast(1.05)", "use": "the hacker / shortcut persona, cold logic, the algorithm"}
    },
    "events": {"max_per_reel": 8, "allowed": ["GR-mono", "GR-amber", "GR-teal"], "no_repeat_adjacent": true},
    "clip_treatments": null
  },
  "hooks": {
    "default": "HA-12",
    "allowed": ["HA-12", "HA-05", "HA-19", "HA-08"],
    "stopper": {"tests": ["ST-2", "ST-3", "ST-4", "ST-5", "ST-6"], "thumb_scale": 0.25, "read_s": 1.2, "hook_sc_3s": 6, "payoff_by_s": 3.0},
    "f0": {"require": ["live_motion"], "forbid": []}
  },
