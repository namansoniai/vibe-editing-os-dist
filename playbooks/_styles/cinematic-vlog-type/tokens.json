{
  "schema": "veos.tokens/3",
  "playbook": "cinematic-vlog-type",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "cinematic-vlog-type",
    "name": "Cinematic Vlog Type",
    "template_version": 1,
    "inspired_by": ["omgadrian"],
    "evidence": "analysis/short/omgadrian.md; evidence/short/omgadrian/v01-v05 (see evidence.md)",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "sound.bed",
      "font_slots.script.family",
      "font_slots.wide.family",
      "grades.scene",
      "profile.presenter.share"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "narrated_footage",
    "presenter": {"presence": "host", "share": [45, 60], "max_absence_s": 6},
    "spine": "hybrid",
    "captions": {"mode": "full", "role": "support", "mute_policy": "mute_safe"},
    "graphics": "support",
    "duration": {"class": "standard", "target_s": [55, 85]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0},
    "tone": {"energy": "balanced", "comedy": "light", "comedy_max": "light"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A", "F-B"], "default": "F-A"},
    "footage_dependency": "high",
    "cta": {"devices": ["comment_keyword", "link_bio", "end_card", "post_only"], "placement": "end"},
    "modules": {
      "chrome": false, "running_state": false, "anchors": false, "data_figures": false, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": true, "continuity": true, "series": true, "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Vlog / story",
      "when": "a thesis told through locations, staged personas or a personal journey: opinions, 'N types of X', place or product visits, year recaps, challenges",
      "profile": {},
      "layouts": ["L-full", "L-card916", "L-hidden"],
      "hooks": {"default": "HA-12"},
      "structure": {"type": "story", "markers": {"style": "SM-1", "numbering": "asc", "recap": false, "teaser": false}},
      "shared_dna": "one yellow; condensed yellow keyword block + white script connectors; pale-lemon serif subtitle at y 1468; cinematic graded footage; cream paper cards; bookend loop"
    },
    "F-B": {
      "name": "Tutorial with paper cards",
      "when": "a how-to in 3-8 rules or steps: technique, app or tool walkthrough, before/after fixes; examples shown on cream paper cards with yellow ink",
      "profile": {"presenter": {"share": [35, 55], "max_absence_s": 8}},
      "layouts": ["L-full", "L-card916", "L-card43", "L-hidden"],
      "hooks": {"default": "HA-05", "stopper": {"payoff_by_s": 0.7}},
      "structure": {"type": "tutorial", "markers": {"style": "SM-2", "numbering": "asc", "recap": false, "teaser": false}},
      "cadence": {"cuts_per_min": [27, 42], "median_shot_s": [0.9, 1.6]},
      "shared_dna": "same type layer, same subtitle, same yellow; the paper world carries the examples and the yellow ink marks them"
    }
  },
  "tone": {"energy": "balanced", "meme_sfx": false, "roast": false, "caption_density": "medium", "comedy": "light"},
  "roles": {
    "primary": {"meaning": "THE yellow: keyword blocks, counters, card titles, ink annotations, the CTA keyword. One hue per reel", "default": "#F7DE0B", "text_on": "ink", "brandable": true},
    "accent": {"meaning": "poster backdrop only: the sun disc / colour wall behind the silhouette (CTA, thesis poster)", "default": "#D42A05", "text_on": "ink", "brandable": true},
    "subtitle": {"meaning": "pale lemon serif subtitle text", "default": "#EEF272", "text_on": "ink", "brandable": false},
    "ink": {"meaning": "keyword blocks on light worlds, strokes, hard text on cream", "default": "#0B0B0B"},
    "paper": {"meaning": "white script connectors, guide lines", "default": "#FFFFFF"},
    "cream": {"meaning": "W-paper world background", "default": "#FCFBE6"},
    "greige": {"meaning": "W-grid world background (polaroids, devices, series lockup)", "default": "#E5E1D3"},
    "grid": {"meaning": "1 px grid lines on W-grid", "default": "#CFCBB6"},
    "frame": {"meaning": "polaroid border", "default": "#F6F4EC"},
    "gold": {"meaning": "series lockup only (>= 96 px)", "default": "#9A6E0A", "text_on": "paper"},
    "shade": {"meaning": "text strokes and shadows (warm black)", "default": "#1A1208"},
    "night": {"meaning": "W-void background (spin-in cards, device close-ups)", "default": "#050505"},
    "canvas": {"meaning": "v1 fallback = cream", "default": "#FCFBE6"}
  },
  "fixed_meaning": [],
  "max_bright_per_frame": 2,
  "gradients": {
    "sun": ["#FF8A2A", "#E8401C", "#7A0F06"],
    "soon": ["#FFE400", "#FFB21C", "#F26A12"],
    "teal_wall": ["#1FA3C6", "#0C7FA0", "#06465A"]
  },
  "worlds": {
    "W-footage": {"kind": "footage", "bg": "night", "footage": {"blur": 28, "brightness": 0.45, "pad": 60}, "noise": 0, "vignette": 0, "texture": null, "particles": null},
    "W-paper": {"kind": "paper", "bg": "cream", "grid": null, "noise": 0.03, "vignette": 0, "texture": null, "particles": null, "light": true},
    "W-grid": {"kind": "paper", "bg": "greige", "grid": {"pitch": 64, "colour": "grid", "width": 1, "alpha": 0.9}, "noise": 0.04, "vignette": 0.42, "texture": null, "particles": null, "light": true},
    "W-void": {"kind": "void", "bg": "night", "dots": {"pitch": 120, "colour": "paper", "alpha": 0.10, "r": 2}, "noise": 0.03, "vignette": 0.3, "texture": null, "particles": null},
    "W-poster": {"kind": "card-world", "bg": "accent", "gradient": {"radial": {"x": 540, "y": 975, "stops": ["#D42A05", "#B50E05", "#0A0503"]}}, "noise": 0.03, "vignette": 0.35, "texture": null, "particles": null, "disc": {"cx": 540, "cy": 975, "r": 487, "centre": "#D42A05", "edge": "#B50E05", "bg": ["#0A0603", "#270402"]}}
  },
  "font_slots": {
    "display": {"family": "Anton", "use": "duo keyword block, behind-head words, CTA keyword", "class": "condensed heavy caps (Anton, League Gothic, Bebas Neue, Oswald 700)"},
    "wide": {"family": "Montserrat", "use": "title lockup, card titles, end block, echo outline, series block (weight 900)", "class": "wide ultra-heavy caps (Montserrat 900; Archivo Black is wider than the source face)"},
    "numeric": {"family": "Montserrat", "use": "count-up digits (weight 900)", "class": "wide ultra-heavy caps 900"},
    "script": {"family": "Nanum Pen Script", "use": "connector words of the duo title, script asides, series script", "class": "pen handwriting (Nanum Pen Script), 400"},
    "serif": {"family": "EB Garamond", "use": "subtitles (CS-1), #N. markers", "class": "old-style serif 500"},
    "ui": {"family": "Jost", "use": "UI chips, chaos bracket tags, legal line, logo plate wordmark", "class": "geometric sans 500-700"},
    "body": {"family": "Jost", "use": "created UI and quote card body text", "class": "geometric sans 500-700"},
    "marker": {"family": "Pinyon Script", "use": "ink note labels next to arrows (rare)", "class": "thin script"},
    "mono": {"family": "JetBrains Mono", "use": "code-shaped texture only (TC-decorative)", "class": "mono"}
  },
  "type": {
    "headline": {"kind": "lockup", "lifetime": "section", "max_words": 7, "max_lines": 3, "read_s": 1.2,
                 "f0": "image-only allowed when the footage moves; first type beat by 0.7 s", "exit": "blur-up 4 f"},
    "duo_keyword": {"slot": "display", "weight": 400, "size": [180, 340], "text_class": "TC-display", "case": "upper", "tracking": -0.01, "line_height": 0.88, "colour": "primary", "shadow": "none", "fit_w": [860, 900]},
    "duo_connector": {"slot": "script", "weight": 400, "size": [84, 112], "text_class": "TC-display", "case": "as_spoken", "colour": "paper", "stroke": 0, "stroke_colour": "shade", "shadow": "0 1 4 rgba(0,0,0,.35)"},
    "behind_word": {"slot": "display", "weight": 400, "size": [200, 340], "text_class": "TC-display", "case": "upper", "colour": "primary", "line_height": 0.9},
    "title_lockup": {"slot": "wide", "weight": 900, "size": [80, 108], "text_class": "TC-display", "case": "upper", "tracking": -0.02, "line_height": 0.92, "colour": "primary", "stroke": 0, "stroke_colour": "shade", "shadow": "none", "fit_w": [860, 980]},
    "card_title": {"slot": "wide", "weight": 900, "size": [64, 84], "text_class": "TC-display", "case": "upper", "line_height": 0.95, "colour": "primary", "stroke": 0, "stroke_colour": "shade"},
    "counter": {"slot": "numeric", "weight": 900, "size": [280, 400], "text_class": "TC-display", "colour": "primary"},
    "counter_unit": {"slot": "wide", "weight": 900, "size": [90, 120], "text_class": "TC-display", "case": "upper", "line_height": 0.9, "colour": "primary"},
    "echo_outline": {"slot": "wide", "weight": 900, "size": [120, 170], "text_class": "TC-display", "case": "upper", "colour": "primary", "outline_px": 3},
    "script_aside": {"slot": "script", "weight": 400, "size": [84, 112], "text_class": "TC-display", "colour": "paper", "stroke": 0, "stroke_colour": "shade"},
    "hash_marker": {"slot": "serif", "weight": 500, "size": 54, "text_class": "TC-label", "colour": "subtitle"},
    "ui_chip": {"slot": "ui", "weight": 600, "size": 44, "text_class": "TC-label", "radius": 999},
    "chaos_tag": {"slot": "ui", "weight": 500, "size": [44, 64], "text_class": "TC-label", "colour": "paper"},
    "chaos_phrase": {"slot": "serif", "weight": 500, "size": [48, 72], "text_class": "TC-label", "style": "italic", "colour": "paper"},
    "end_block": {"slot": "wide", "weight": 900, "size": [70, 200], "text_class": "TC-display", "case": "upper", "line_height": 0.9, "colour": "primary"},
    "series_script": {"slot": "script", "weight": 400, "size": [120, 160], "text_class": "TC-display", "colour": "gold"},
    "series_block": {"slot": "wide", "weight": 900, "size": [130, 170], "text_class": "TC-display", "case": "upper", "colour": "gold"},
    "series_ep": {"slot": "ui", "weight": 600, "size": 40, "text_class": "TC-label", "colour": "gold"},
    "logo_word": {"slot": "ui", "weight": 500, "size": 72, "text_class": "TC-label", "colour": "paper"},
    "legal": {"slot": "ui", "weight": 500, "size": 24, "text_class": "TC-legal"}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-1",
    "by_layout": {},
    "speakers": {},
