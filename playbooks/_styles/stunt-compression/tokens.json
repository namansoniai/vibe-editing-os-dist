{
  "schema": "veos.tokens/3",
  "playbook": "stunt-compression",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "stunt-compression",
    "name": "Stunt Compression",
    "template_version": 1,
    "inspired_by": ["mr-beast"],
    "evidence": "analysis/short/mr-beast.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "sound.bed",
      "captions.profiles.CS-3.select_rule",
      "font_slots.chunky.family",
      "font_slots.numeric.family",
      "profile.cta.devices"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "stunt_footage",
    "presenter": {"presence": "host", "share": [60, 100], "max_absence_s": 3.0},
    "spine": "footage",
    "captions": {"mode": "full", "role": "support", "mute_policy": "mute_safe"},
    "graphics": "support",
    "duration": {"class": "standard", "target_s": [40, 75]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0, "style": "full"},
    "tone": {"energy": "hype", "comedy": "light", "comedy_max": "light"},
    "themes": {"policy": "single", "packs": [], "default": null},
    "formats": {"list": ["F-A"], "default": "F-A"},
    "footage_dependency": "total",
    "cta": {"devices": ["none", "post_only", "comment_keyword", "link_bio"], "placement": "end", "chosen": "none"},
    "modules": {
      "chrome": false, "running_state": true, "anchors": true, "data_figures": true, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": false, "continuity": false, "series": false, "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Stunt compression",
      "when": "any real-world stunt, giveaway, challenge, street question, prank or reveal shot with several people and a stake (money, a prize, a time limit)",
      "profile": {},
      "layouts": ["L-full", "L-wide-band"],
      "hooks": {"default": "HA-13", "allowed": ["HA-13", "HA-14", "HA-16"]},
      "structure": {"type": "stunt"},
      "shared_dna": "cold open mid-action, a hard cut every 1.0-1.5 s, neon-green money tags pinned to the money, per-beat caption modes (comic caps / neutral lowercase / none), ends on a reaction"
    }
  },
  "tone": {"energy": "hype", "meme_sfx": false, "roast": false, "caption_density": "medium", "comedy": "light"},
  "roles": {
    "primary": {"meaning": "the creator's own colour: the handle chip ring, the avatar badge, the CTA keyword sticker", "default": "#1179CB", "text_on": "paper", "brandable": true},
    "accent": {"meaning": "exclamation yellow: CS-3 shouts, subjects' lines, name calls", "default": "#FFE600", "text_on": "ink", "brandable": true, "large_text_only": false},
    "punch": {"meaning": "the one pink punch word of a neutral-register reel (CS-4)", "default": "#F34FF7", "text_on": "ink", "brandable": true},
    "good": {"meaning": "money and gain: money tags, +$ totals, the money word in a comic chunk, object glow, the green flash", "default": "#39FF14", "text_on": "ink", "brandable": false},
    "bad": {"meaning": "loss, zero, wrong: the $0 tag, the X flash", "default": "#E5191B", "text_on": "paper", "brandable": false},
    "paper": {"meaning": "caption fill, clock fill, handle chip fill, brand-in-type plates", "default": "#FFFFFF"},
    "ink": {"meaning": "every stroke and hard shadow (captions, tags, clock)", "default": "#000000"},
    "money_edge": {"meaning": "the dark inner stroke of money tags", "default": "#0A3A06"}
  },
  "fixed_meaning": ["good", "bad"],
  "max_bright_per_frame": 3,
  "gradients": {
    "glow_good": {"stops": ["#B6FF9E", "#39FF14", "#1FB80A"], "angle": 180},
    "scrim_brand": {"radial": {"x": 0.5, "y": 0.5, "stops": ["rgba(255,255,255,0.3)", "rgba(255,255,255,0)"]}}
  },
  "themes": {},
  "worlds": {
    "W-set": {"kind": "footage", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null},
    "W-band": {"kind": "footage", "bg": "#000000", "grid": null, "noise": 0, "vignette": 0, "texture": null, "particles": null, "footage": {"blur": 40, "brightness": 0.55, "pad": 0}}
  },
  "font_slots": {
    "chunky": {"family": "Bangers", "use": "CS-2 comic caps captions, CS-3 yellow exclamations, name calls", "class": "condensed comic caps, single weight"},
    "body": {"family": "Inter Tight", "use": "CS-1 neutral lowercase captions (600), handle chip text (700), URL line (800)", "class": "neo-grotesque sans 600-800"},
    "numeric": {"family": "Lilita One", "use": "money tags, running totals, the countdown clock, CS-4 pink punch word", "class": "rounded heavy display, one weight"},
    "display": {"family": "Montserrat", "use": "brand-in-type plates (900 caps) when no sponsor logo file exists", "class": "geometric sans 800-900 caps"},
    "ui": {"family": "Inter Tight", "use": "TC-legal lines: the disclosure", "class": "neo-grotesque sans 500-700"}
  },
  "type": {
    "headline": {"kind": "none", "lifetime": "hook", "f0": "no headline: the cold-open caption is the only text at f0", "exit": "n/a"},
    "money_tag": {"slot": "numeric", "weight": 400, "size": 112, "size_range": [72, 150], "colour": "good", "stroke": 5, "stroke_colour": "money_edge",
                  "glow": "0 0 22px rgba(57,255,20,.85), 0 0 6px rgba(57,255,20,.9)", "shadow": "0 6 0 rgba(0,0,0,.55)", "case": "as_written",
                  "entry": "type_on", "glyph_frames": 1.5, "glyph_drop": {"scale_y": 1.4, "dy": -20, "frames": 2},
                  "hold_s": [0.6, 2.2], "exit": "cut", "text_class": "TC-display"},
    "loss_tag": {"slot": "numeric", "weight": 400, "size": 122, "colour": "bad", "stroke": 6, "stroke_colour": "paper", "shadow": "0 6 0 rgba(0,0,0,.7)",
                 "shake_px": 10, "shake_frames": 8, "hold_s": [0.6, 1.4], "text_class": "TC-display"},
    "clock": {"slot": "numeric", "weight": 400, "size": 170, "colour": "paper", "stroke": 9, "stroke_colour": "ink", "glow": "0 0 18px rgba(0,0,0,.7)", "first_value_glow": "good",
              "cx": 540, "cy": 290, "format": "M:SS", "swap": "hard (E6)", "text_class": "TC-display"},
    "brand_type": {"slot": "display", "weight": 900, "size": [96, 128], "case": "upper", "colour": "paper", "stroke": 6, "stroke_colour": "ink",
                   "shadow": "0 6 0 rgba(0,0,0,.6)", "cy": 1000, "text_class": "TC-display"},
    "url_line": {"slot": "body", "weight": 800, "size": 64, "case": "upper", "colour": "paper", "stroke": 4, "stroke_colour": "ink", "text_class": "TC-label"},
    "handle_chip": {"slot": "body", "weight": 700, "size": 44, "fill": "paper", "text": "ink", "radius": 48, "height": 96, "avatar_d": 112,
                    "ring": "primary", "ring_px": 5, "hold_s": [0.5, 0.9], "text_class": "TC-label"},
    "name_call": {"slot": "chunky", "weight": 400, "size": 72, "case": "upper", "colour": "accent", "stroke": 6, "stroke_colour": "ink", "rotate": -6,
                  "text_class": "TC-display"},
    "x_flash": {"glyph": "X", "size": 200, "colour": "bad", "stroke": 0, "glow": "0 0 26px rgba(229,25,27,.9)", "entry": "blur", "entry_frames": 6,
                "hold_frames": [15, 24], "exit": "cut", "text_class": "TC-decorative"},
    "keyword_sticker": {"slot": "chunky", "weight": 400, "size": 120, "case": "upper", "colour": "paper", "fill": "primary", "stroke": 7, "stroke_colour": "ink",
                        "rotate": -4, "hold_s": [1.5, 2.5], "text_class": "TC-display"},
    "legal": {"slot": "ui", "weight": 600, "size": 26, "colour": "paper", "shadow": "0 2 4 rgba(0,0,0,.8)", "text_class": "TC-legal"}
  },
  "captions": {
    "profanity": {"mask": true, "style": "inner"},
    "default": "CS-2",
    "by_layout": {},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:mrbeast_neutral",
        "unit": "word",
        "words": [1, 1],
        "max_chars_line": 16,
        "lines": 1,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1,
        "min_hold_s_per_word": 0.13,
        "tail_s": 0.1,
        "punct": "strip_end",
        "swap": {"type": "hard", "frames": 0},
        "pause_hold_s": 0,
        "skin": {
          "slot": "Poppins", "weight": 600, "size": 64, "text_class": "TC-subtitle", "case": "lower", "tracking": 0,
          "colour": "paper", "stroke": 5, "stroke_colour": "#000000", "shadow": "0 2 6 rgba(0,0,0,.5)",
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "chest", "cy": 940, "cx": 540, "offset": 30, "max_w": 900, "align": "center", "avoid_face": true, "colour_by_bg": null},
        "emphasis": {"mechanism": "none", "slot": null, "colour": null, "ratio": 1.0, "select": null, "max_per_s": 0, "never": []},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      },
      "CS-2": {
        "extends": "lib:mrbeast_comic",
        "unit": "group",
        "words": [1, 5],
        "max_chars_line": 20,
        "lines": 2,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1,
        "min_hold_s_per_word": 0.15,
        "tail_s": 0.1,
        "punct": "keep",
        "swap": {"type": "pop", "frames": 2},
        "reveal": "word",
        "pause_hold_s": 0,
        "skin": {
          "slot": "chunky", "weight": 400, "size": 96, "text_class": "TC-subtitle", "case": "upper", "tracking": 0.02,
          "colour": "paper", "stroke": 10, "stroke_colour": "ink", "shadow": "0 3 6 rgba(0,0,0,.5)", "rotate": 0, "line_height": 1.0,
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "chest", "cy": 1000, "cx": 540, "offset": 30, "max_w": 920, "align": "center", "avoid_face": true, "colour_by_bg": null},
        "emphasis": {"mechanism": "colour", "slot": null, "colour": "good", "ratio": 1.0, "select": ["number"], "max_per_chunk": 1, "max_per_s": 0.5,
                     "never": ["stopwords"]},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      },
      "CS-3": {
        "extends": "lib:mrbeast_comic",
        "unit": "group",
        "words": [1, 3],
        "max_chars_line": 14,
        "lines": 1,
        "no_split": ["names", "numbers", "units"],
        "lead_frames": 1,
        "min_hold_s_per_word": 0.3,
        "tail_s": 0.12,
        "punct": "keep",
        "swap": {"type": "pop", "frames": 2},
        "pause_hold_s": 0.4,
        "skin": {
          "slot": "chunky", "weight": 400, "size": 112, "text_class": "TC-subtitle", "case": "upper", "tracking": 0.02,
          "colour": "accent", "stroke": 10, "stroke_colour": "ink", "shadow": "0 3 6 rgba(0,0,0,.5)", "rotate": -8, "line_height": 1.0,
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "chest", "cy": 1000, "cx": 540, "offset": 30, "max_w": 920, "align": "center", "avoid_face": true, "colour_by_bg": null},
        "emphasis": {"mechanism": "none"},
        "karaoke": null, "tiers": null, "duet": null, "stack": null,
        "hide": ["under_z8"],
        "language": {"script": "Latn", "transliteration": "keep_english_terms", "normalise_spelling": false, "glossary": []}
      },
      "CS-4": {
        "extends": "lib:mrbeast_neutral",
        "unit": "word",
        "words": [1, 1],
        "max_chars_line": 12,
        "lines": 1,
        "lead_frames": 1,
        "min_hold_s_per_word": 0.3,
        "punct": "keep",
        "swap": {"type": "pop", "frames": 2},
        "skin": {
          "slot": "Poppins", "weight": 700, "size": 96, "text_class": "TC-subtitle", "case": "lower", "tracking": 0,
          "colour": "punch", "stroke": 7, "stroke_colour": "ink", "shadow": "0 3 6 rgba(0,0,0,.45)", "rotate": 0,
          "container": {"type": "none", "fill": null, "opacity": 0, "radius": 0, "padding": [0, 0]}
        },
        "position": {"anchor": "chest", "cy": 900, "cx": 540, "offset": 30, "max_w": 900, "align": "center", "avoid_face": true, "colour_by_bg": null},
        "emphasis": {"mechanism": "none"},
        "hide": ["under_z8"]
      }
    }
  },
  "layout": {
    "size": [1080, 1920],
    "safe": {"x": [64, 1016], "y": [110, 1500]},
    "ig_ui": {"top": 110, "bottom": 380, "right": 110},
    "face_clearance": 40,
    "caption_cy": {"full": 1000, "neutral": 940},
    "clock_cy": 290,
    "brand_cy": 1000,
    "tag_band": {"y": [560, 1460]},
    "chip_band": {"y": [700, 1300]}
  },
  "layouts": {
    "L-full": {
      "engine": "full",
      "caption": {"anchor": "chest", "cy": 1000},
      "treatment": null, "share": [0.9, 1.0], "safe": null
    },
    "L-wide-band": {
      "engine": "blurfill",
      "band_h": 608,
      "cy": 960,
      "blur_px": 40,
      "luma": -0.45,
      "caption": {"anchor": "fixed_y", "cy": 1380},
      "treatment": null, "share": [0.0, 0.1], "safe": null
    }
  },
  "motion": {
    "lead_frames": 1,
    "ease_entry": [0.34, 1.56, 0.64, 1],
    "ease_exit": [0.64, 0, 0.78, 0],
    "pop_overshoot": 0.05,
    "tag_glyph_frames": 1.5,
    "tag_exit_frames": 4,
    "default_exit": "cut",
    "chip_pop_frames": 4,
    "shake_px": 10,
    "shake_frames": 8,
    "number_roll_frames": 8,
    "logo_pop_frames": 4,
    "x_blur_in_frames": 6,
    "glow_rise_frames": 3,
    "flash_frames": 6,
    "whip_frames": [4, 2, 3],
    "zoom_blur_frames": 4,
    "builtin_transitions": {
      "T-01": {"type": "whip", "dir": "right", "px": 60, "frames": 9, "pre": 4, "blend": 2},
      "T-05": {"type": "zoom-blur", "pre": 0, "frames": 4, "amount": 0.15, "punch": 0, "at": "face"},
      "P-51": {"type": "flash", "colour": "good", "peak": 0.6, "pre": 0, "frames": 10, "decay": 0.5}
    },
    "tag_type_on": {"helper": "VEOS.fx.typeOn", "cps": 20, "frames": 2, "drop": 0.18, "stretch": 0.4},
    "hold_min_frames": 12,
    "text_hold_per_word_s": 0.15
  },
  "camera_presets": {
    "recrop-in": {"id": "Z-R1", "scale": [1.0, 1.2], "frames": 1, "tones": ["any"], "max_per_reel": 6, "note": "jump on the same take (logo exit, GR-bw start) or FB-2/FB-3; 1.13-1.20 measured; <= 1.35 on 1080p, <= 2.0 on 4K (P-13 detail insert)"},
    "recrop-out": {"id": "Z-R2", "scale": [1, 1.0], "frames": 1, "tones": ["any"], "note": "back to the base framing on the next cut; follows every Z-R1 / Z-P1 / Z-C1"},
    "reaction-push": {"id": "Z-P1", "scale": [1.0, 1.15], "frames": 15, "tones": ["win", "warn"], "note": "eased push into the biggest reaction of a beat (measured 1.14-1.17 in 14-17 f, v01 @1.48, @20.40); holds to the cut"},
    "crash-zoom": {"id": "Z-C1", "scale": [1.0, 1.6], "frames": 24, "tones": ["win", "awe"], "max_per_reel": 2, "blur": {"kind": "radial", "amount": 0.18, "at": "face", "frames": 6, "shape": "decay"}, "note": "an erupting crowd from its first frame (measured 1.72 in 27 f, ease-out, v03 @7.27); no rotation"}
  },
  "zoom_policy": "presets",
  "stage_morphs": {"cut": 0},
  "grades": {
    "footage": null,
    "scene": {
      "GR-bw": {"filter": "grayscale(1) contrast(1.12)", "blend": "saturation", "fill": "#808080", "frames": [24, 45], "freeze": false, "enter": "recrop-in 1.13 on the same take (or a cut)", "exit": "cut"},
      "GR-green": {"filter": "none", "blend": "color", "fill": "#39FF14", "opacity": 0.6, "frames": [6, 10]}
    },
    "events": {"max_per_reel": 2, "allowed": ["GR-bw", "GR-green"], "min_gap_s": 6},
    "clip_treatments": null
  },
  "hooks": {
    "default": "HA-13",
    "allowed": ["HA-13", "HA-14", "HA-16"],
    "stopper": {"tests": ["ST-2", "ST-3", "ST-5", "ST-6"], "thumb_scale": 0.25, "read_s": 1.0, "hook_sc_3s": 5, "payoff_by_s": 2.3},
    "f0": {"require": [], "forbid": ["headline"]}
  },
  "structure": {
    "type": "stunt",
    "markers": {"style": "none", "numbering": "asc", "recap": false, "teaser": false},
    "rehook_every_s": 30,
    "intro_max_ratio": 0.15
  },
  "cadence": {
    "sc_per_10s": [5, 14],
    "hook_sc_3s": 5,
    "max_gap_s": 2.5,
    "max_static_s": 2.5,
    "caption_weight": 0.5,
    "cuts_per_min": [30, 48],
    "median_shot_s": [1.0, 1.3],
    "continuous_motion_required": false
  },
  "budgets": {"sfx_per_10s": 4, "sfx_max_uses_per_file": 2},
  "exceptions": {"E6": {"slot_tolerance_px": 4}},
  "running_state": {
    "vars": {
      "total": {"type": "money", "start": 0, "format": "numbers", "display": "P-23", "persist": "across_cuts"},
      "stake": {"type": "money", "start": 0, "format": "numbers", "display": "P-20", "persist": "across_cuts"},
      "clock": {"type": "clock", "start": null, "format": "M:SS", "display": "P-24", "persist": "across_cuts"}
    },
    "clock": {"time_base": "set", "jumps_allowed": true, "direction": "down", "shown_at": "per beat"}
  },
  "anchors": {"mode": "track", "fallback": "static_near_target", "face_clear_px": 40, "track_when_move_px": 90, "lost": "hold", "lost_fade_frames": 4, "scale_with": true, "max_track_s": 10},
  "data": {
    "formulas": ["sum", "diff", "per_period"],
    "tolerance": "display_rounding",
    "same_scale_rule": false
  },
  "citations": null,
  "inserts": {
    "fetch": false,
    "ask_creator": true,
    "create_fallbacks": ["quote_card", "headline_card", "recreated_ui", "diagram", "logo_plate", "silhouette"],
    "patterns": ["P-07", "P-30", "P-31"]
  },
  "footage": {
    "setups": [
      {"id": "A", "desc": "Host camera: vertical 9:16 handheld or gimbal phone/mirrorless, 4K 30 or 60 fps (conformed to 30), daylight or bright practicals, host lav visible is fine; walks with the host and holds the host's face 18-30% of frame height", "framing": {"head_top_y": [120, 420]}},
      {"id": "B", "desc": "Subject camera: second vertical 4K camera on the subject(s): close-ups of faces and hands for reactions; lav on the main subject", "framing": {"head_top_y": [140, 520]}},
      {"id": "C", "desc": "Wide / set camera: vertical or horizontal wide that shows the whole set, the crowd and the stake (cash pile, prize table) for establishes; horizontal is accepted (L-wide-band)", "framing": {"head_top_y": [300, 900]}},
      {"id": "D", "desc": "Phone screen recordings from the creator's own phone (or the subject's, with consent): the call, the app, the follow tap", "framing": {"head_top_y": null}}
    ],
    "shots": [
      {"id": "SH-1", "desc": "cold-open walk-and-talk: the host already moving and speaking the stake line to camera (A), 3 takes", "per_60s": [1, 1], "must": true, "formats": ["F-A"], "fallback": "FB-1"},
      {"id": "SH-2", "desc": "subject close-up reactions (B): face + hands, mouth covered, hands on head, jumping; at least 3 per subject who wins or loses", "per_60s": [8, 16], "must": true, "formats": ["F-A"], "fallback": "FB-2"},
      {"id": "SH-3", "desc": "host two-shot with the subject, medium (A or B): the ask, the offer, the handover", "per_60s": [6, 12], "must": true, "formats": ["F-A"], "fallback": "FB-3"},
      {"id": "SH-4", "desc": "the stake as an object (A/B macro): the cash case opening, the stack in a hand, the pile, the prize boxes, 0.5-1.5 s each", "per_60s": [3, 6], "must": true, "formats": ["F-A"], "fallback": "FB-4"},
      {"id": "SH-5", "desc": "wide establish of the set and the crowd (C), incl. the reveal of the room or the pile", "per_60s": [2, 5], "must": true, "formats": ["F-A"], "fallback": "FB-5"},
      {"id": "SH-6", "desc": "the reveal moment from two angles at once (A on the host, B on the subject), synced by sound", "per_60s": [1, 3], "must": true, "formats": ["F-A"], "fallback": "FB-6"},
      {"id": "SH-7", "desc": "bystander / crowd reactions (B or C): friends, classmates, passers-by", "per_60s": [2, 6], "must": false, "formats": ["F-A"], "fallback": "FB-7"},
      {"id": "SH-8", "desc": "phone screen recording of the moment that happens on a phone (D): the call, the follow tap, the balance", "per_60s": [0, 2], "must": false, "formats": ["F-A"], "fallback": "FB-8"},
      {"id": "SH-9", "desc": "the time limit on set: a visible timer or the host calling the time; the creator writes down the clock values per take", "per_60s": [0, 1], "must": false, "formats": ["F-A"], "fallback": "FB-9"},
