  "formats": {
    "F-A": {
      "name": "Evidence explainer",
      "when": "news, politics, policy, prices, myth-busting, fact-checks, incident reconstructions: any reel that makes claims and proves them",
      "profile": {},
      "layouts": [
        "L-full",
        "L-split-top",
        "L-split-bottom",
        "L-pip-ring",
        "L-pip-card",
        "L-band",
        "L-hidden"
