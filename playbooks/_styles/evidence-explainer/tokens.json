      "hooks": {
        "default": "HA-09"
      },
      "structure": {
        "type": "evidence"
      },
      "shared_dna": "matted presenter on a topic-coloured backdrop plate, no speech captions, every claim paid off by a source card with red highlight bars, plates for every spoken date/name/number, verdict stamps"
    }
  },
  "tone": {
    "energy": "balanced",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "none",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "the rim: split hairline, PiP ring, PiP-card border, plate wipe bar, year-chip underline. One per reel, from the theme",
      "default": "#EE0000",
      "text_on": "paper",
      "brandable": true
    },
    "accent": {
      "meaning": "marker yellow: keyword chips, number chips, map place labels and route lines, post highlighter",
      "default": "#F9E81F",
      "text_on": "ink",
      "brandable": true
    },
    "bad": {
      "meaning": "evidence red: highlight bars, FAKE / SCAM / FALSE stamps, the higher or worse number",
      "default": "#E30400",
      "text_on": "paper",
      "brandable": false
    },
    "good": {
      "meaning": "verified green: TRUE / CONFIRMED stamps, the lower or better number",
      "default": "#2BD94A",
      "text_on": "ink",
      "brandable": false
    },
    "data": {
      "meaning": "chart cyan: lines and bars on the data stage and the map",
      "default": "#3FE0D0",
      "text_on": "ink",
      "brandable": false
    },
    "plate": {
      "meaning": "dark plate fill under date / name / keyword plates",
      "default": "#121214"
    },
    "ink": {
      "meaning": "text on yellow and green, strokes",
      "default": "#0B0B0B"
    },
    "paper": {
      "meaning": "plate text, card headlines, underlines",
      "default": "#FFFFFF"
    },
    "night": {
      "meaning": "evidence world and data stage background",
      "default": "#09090B"
    },
    "slate": {
      "meaning": "map water and map panel background",
      "default": "#24262B"
    },
    "flash": {
      "meaning": "the light-leak burn transition (light pass only, never text)",
      "default": "#FCF88B"
    },
    "chip": {
      "meaning": "charcoal keyword-chip fill (opaque)",
      "default": "#3F3F3F",
      "text_on": "paper"
