  "formats": {
    "F-B": {
      "name": "Metaphor animation",
      "when": "a voice-over essay of 25-55 s: one idea, told as one evolving monochrome metaphor (the default; no camera needed)",
      "profile": {},
      "layouts": ["L-void"],
      "hooks": {"default": "HA-15"},
      "structure": {"type": "essay"},
      "shared_dna": "black void, greyscale light, quiet small type, slow eased motion, no punch-ins, one idea per breath; the essay is one continuous thought"
    },
    "F-A": {
      "name": "Seated essay",
      "when": "the creator on camera, seated and static, delivering one essay sentence-chain of 30-50 s; opens on a text-only black card",
      "profile": {
        "source_type": "talking_head",
        "presenter": {"presence": "anchor", "share": [80, 92], "max_absence_s": 6},
        "spine": "talking_head",
        "graphics": "minimal",
        "footage_dependency": "low",
        "modules": {"canvas_camera": false, "continuity": false}
      },
      "layouts": ["L-card", "L-seated"],
      "hooks": {"default": "HA-12", "f0": {"require": ["caption"], "forbid": ["presenter"]}},
      "structure": {"type": "essay"},
      "captions": {"default": "CS-A"},
      "type": {"headline": {"kind": "none", "lifetime": "hook", "max_words": 0, "max_lines": 0, "read_s": 0,
                            "f0": "no headline element: the cold-open caption card (CS-A0) is the f0 stopper", "exit": "n/a"}},
      "cadence": {"sc_per_10s": [1.5, 4], "hook_sc_3s": 1.0, "max_gap_s": null, "hook_max_gap_s": null,
                  "max_static_s": 2.5, "caption_weight": 0.5, "continuous_motion_required": false},
      "shared_dna": "same black-and-quiet restraint: the text-only black card, small lowercase type, zero zoom, zero decoration"
    }
  },
  "tone": {"energy": "calm", "meme_sfx": false, "roast": false, "caption_density": "low", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "the light: glow cores of every object and the motif dot (white is the only 'colour' of F-B)", "default": "#FFFFFF", "text_on": "ink", "brandable": false},
    "accent": {"meaning": "the one warm note: F-A caption gold (sampled #FCC31E, v01 @ 0:09 / 0:14); never on the F-B void unless the buyer brands the CTA keyword", "default": "#FCC31E", "text_on": "ink", "brandable": true},
    "mist": {"meaning": "secondary light: outlines at rest, F-B caption text, split-title type", "default": "#D8D8D8", "text_on": "ink", "brandable": false},
    "smoke": {"meaning": "tertiary: inactive outlines, struck-out options, threads, far dots", "default": "#8A8A8A", "text_on": "ink", "brandable": false},
    "slate": {"meaning": "filled surfaces inside objects (phone cards, bar track, lit-object shadow side)", "default": "#4A4A4A", "text_on": "paper", "brandable": false},
    "ash": {"meaning": "near-black planes: end-card panel, product card back, ground ellipse", "default": "#141414", "text_on": "paper", "brandable": false},
    "bad": {"meaning": "the dimmed state: the old way, the cost, the rejected option (grey, never red)", "default": "#6E6E6E", "text_on": "paper", "brandable": false},
    "good": {"meaning": "the lit state: the chosen path, the payoff (pure white with full glow)", "default": "#FFFFFF", "text_on": "ink", "brandable": false},
    "ink": {"meaning": "text on light fills", "default": "#0A0A0A"},
    "paper": {"meaning": "white text on dark (F-A cold-open card)", "default": "#F4F4F4"},
    "night": {"meaning": "the void: every F-B frame and the F-A cold-open card", "default": "#000000"},
    "canvas": {"meaning": "unused (kept for v1 readers)", "default": "#000000"},
    "grid": {"meaning": "the dot-field dots at rest", "default": "#3A3A3A"}
  },
  "fixed_meaning": ["bad", "good"],
  "max_bright_per_frame": 2,
  "gradients": {
    "lit_sphere": {"radial": {"x": 0.35, "y": 0.3, "stops": ["#F2F2F2", "#9A9A9A", "#2A2A2A", "#050505"]}, "use": "hourglass bulb fill inside the 2D line-art icon"},
    "beam": {"stops": ["rgba(255,255,255,0.28)", "rgba(255,255,255,0.0)"], "angle": 0, "use": "conic light cones and spotlight wedges"},
    "ground": {"radial": {"x": 0.5, "y": 0.5, "stops": ["#2E2E2E", "#0C0C0C", "#000000"]}, "use": "2D ground lines and horizons (the lit 3D objects use their own ground disc)"}
  },
