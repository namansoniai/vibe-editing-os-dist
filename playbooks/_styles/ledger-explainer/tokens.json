{
  "schema": "veos.tokens/3",
  "playbook": "ledger-explainer",
  "kind": "style_template",
  "version": 1,
  "style": {
    "id": "ledger-explainer",
    "name": "Ledger Explainer",
    "template_version": 1,
    "inspired_by": ["ankur-warikoo"],
    "evidence": "analysis/short/ankur-warikoo.md",
    "status": "released",
    "unverified": [
      "profile.language.speech",
      "profile.language.captions.transform",
      "sound.bed",
      "grades.scene.GR-case-mono"
    ]
  },
  "creator": {
    "name": null,
    "handle": null,
    "language": null,
    "caption_language": null,
    "banner_language": null,
    "cta": {"pattern": null, "deliverable": null, "community_chip": null, "signoff": null, "device": null, "keyword": null},
    "glossary": [],
    "logo": null
  },
  "profile": {
    "source_type": "talking_head",
    "presenter": {"presence": "anchor", "share": [88, 100], "max_absence_s": 3.5},
    "spine": "talking_head",
    "captions": {"mode": "full", "role": "support", "mute_policy": "mute_safe"},
    "graphics": "primary",
    "duration": {"class": "short", "target_s": [40, 60]},
    "language": {
      "speech": "en",
      "captions": {"lang": "en", "script": "Latn", "transform": "verbatim"},
      "on_screen": "en",
      "post_title": "en",
      "supported": [["en", "en", "Latn"], ["hinglish", "hinglish", "Latn"], ["hi", "hi", "Deva"]]
    },
    "numbers": {"grouping": "international", "currency": "$", "compact": "k_m_b", "units": "metric", "decimals": 0,
                "style": "full", "lang": "en", "compact_decimals": 2, "percent_decimals": 1},
    "tone": {"energy": "calm", "comedy": "off", "comedy_max": "off"},
    "themes": {"policy": "per_topic", "packs": ["TH-teal", "TH-maroon", "TH-case"], "default": "TH-teal"},
    "formats": {"list": ["F-A", "F-B", "F-C"], "default": "F-A"},
    "footage_dependency": "low",
    "cta": {"devices": ["end_card", "comment_keyword", "link_bio", "post_only"], "placement": "end", "chosen": "end_card"},
    "modules": {
      "chrome": true, "running_state": true, "anchors": false, "data_figures": true, "citations": false,
      "dialogue": false, "canvas_camera": false, "ink": false, "continuity": false, "series": true, "brand": true
    }
  },
  "formats": {
    "F-A": {
      "name": "Ledger inset",
      "when": "build-the-numbers reels and claim-vs-reality lists: a few named quantities, a total, a stress test, or 3-7 numbered traps",
      "profile": {},
      "layouts": ["L-inset-top", "L-endcard"],
      "hooks": {"default": "HA-07"},
      "structure": {"type": "ledger"},
      "shared_dna": "one calm presenter asset, white rounded ledger cards on a topic-keyed dark gradient, claim vs reality, numbers that land on the spoken word, quiet sentence captions inside the footage"
    },
    "F-B": {
      "name": "Face-bottom calculator",
      "when": "one big calculation stepped through a parameter (years, months, quantity): two options compared on one axis, then why, then the transfer to a second case",
      "profile": {},
      "layouts": ["L-face-bottom", "L-endcard"],
      "hooks": {"default": "HA-07"},
      "structure": {"type": "ledger"},
      "shared_dna": "same presenter, same white cards and Poppins figures, same claim vs reality axis; the data panel moves to the top and the face fills the bottom"
    },
    "F-C": {
      "name": "Case file",
      "when": "a documentary story told in one episode of a numbered series, with a running money/quantity ledger and creator-supplied monochrome stills",
      "profile": {"footage_dependency": "high", "graphics": "support"},
      "layouts": ["L-cinema-top", "L-endcard"],
      "hooks": {"default": "HA-12", "stopper": {"tests": ["ST-2", "ST-3", "ST-6"], "hook_sc_3s": 4, "payoff_by_s": 3.0, "read_s": 1.5, "thumb_scale": 0.25}},
      "structure": {"type": "story", "markers": {"style": "SM-case-tag", "numbering": "asc", "recap": false, "teaser": false}},
      "cadence": {"sc_per_10s": [3, 6], "hook_sc_3s": 4, "max_gap_s": 3.0, "max_static_s": 3.0},
      "flash": {"id": "T-9", "frames": 2, "peak_opacity": 0.85, "transition": {"type": "flash", "frames": 2, "pre": 0, "peak": 0.85, "decay": 1.1, "colour": "#FFFFFF"}, "use": "white flash on the inciting event and the turn only (built-in timeline.transitions flash; frames 1 or 2 as measured)"},
      "type": {"headline": {"kind": "title_card", "lifetime": "hook", "max_words": 4, "max_lines": 3, "read_s": 1.5,
                            "f0": "episode label at f0, title lines build 0.6-0.9 s (3 f each, 2-3 f stagger), grey to white by 1.0 s", "exit": "title fades out 4 f, then a hard cut into the first still"}},
      "shared_dna": "same framed 16:9 presenter, same quiet captions inside the footage, the ledger figure in Poppins with Indian grouping; the cards give way to a still band"
    }
  },
  "tone": {"energy": "calm", "meme_sfx": false, "roast": false, "caption_density": "medium", "comedy": "off"},
  "roles": {
    "primary": {"meaning": "the 'you are here' highlight: active chip tab ring, slider handle, end-card arrow, CTA keyword card", "default": "#FFFFFF", "text_on": "ink", "brandable": true},
    "accent": {"meaning": "series and story accent: ledger counter digits, case dots, episode label, the single accent object in stills", "default": "#40E87A", "text_on": "ink", "brandable": true},
    "stage": {"meaning": "the world tone at the F-B seam (theme-keyed, never text)", "default": "#14403D", "text_on": "paper", "brandable": true},
    "data": {"meaning": "the first compared option (card, bar, badge); theme-keyed", "default": "#1F5A5C", "text_on": "paper", "brandable": true},
    "night": {"meaning": "the second compared option (card, bar, badge)", "default": "#1C1C1C", "text_on": "paper", "brandable": false},
    "bad": {"meaning": "costs more, the false belief, the struck value, the empty dashed bar, the worse method", "default": "#C8283C", "text_on": "paper", "brandable": false},
    "good": {"meaning": "cheaper, the true value, the better method, the check", "default": "#26803A", "text_on": "paper", "brandable": false},
    "ink": {"meaning": "all text on cards", "default": "#111111"},
    "paper": {"meaning": "cards, chips, tiles, captions, summary lines", "default": "#FFFFFF"},
    "muted": {"meaning": "micro-labels on white cards (you think, a year, her salary)", "default": "#6B6B6B"},
    "ghost": {"meaning": "future items: unlit rank numerals and unlit tabs (with ink text)", "default": "#D6CFCC"}
  },
  "fixed_meaning": ["bad", "good"],
  "max_bright_per_frame": 3,
  "gradients": {},
  "themes": {
    "TH-teal": {
      "name": "Teal ledger",
      "when": "how something works, building the numbers, comparisons, plans (money in, salary, loans, investing, insurance; in other niches: calories, hours, grams, reps)",
      "roles": {"stage": "#14403D", "data": "#1F5A5C"},
      "worlds": {"W-ledger": {"top": "#0D2B2B", "bottom": "#2E7A72", "noise": 0.04,
                              "glow": {"colour": "#4A9A90", "alpha": 0.32, "r": 760, "x": 820, "y": 1560, "drift": [24, 18, 0.35, 0.25]}}},
      "gradients": {},
      "grade": null
    },
    "TH-maroon": {
      "name": "Maroon traps",
      "when": "traps, offers, myths, scams, hidden costs: anything where a claim is about to be shown false",
      "roles": {"stage": "#3A2420", "data": "#5A2E2A"},
      "worlds": {"W-ledger": {"top": "#1E1411", "bottom": "#8E524D", "noise": 0.04,
                              "glow": {"colour": "#A8645C", "alpha": 0.30, "r": 760, "x": 760, "y": 1700, "drift": [24, 18, 0.35, 0.25]}}},
      "gradients": {},
      "grade": null
    },
    "TH-case": {
      "name": "Case file",
      "when": "F-C only: a documentary story episode",
      "roles": {"stage": "#0B1F10", "data": "#135C2C", "accent": "#40E87A"},
      "worlds": {"W-ledger": {"top": "#050805", "bottom": "#135C2C", "noise": 0.05}},
      "gradients": {},
      "grade": "GR-case-mono"
    }
  },
  "worlds": {
    "W-ledger": {"kind": "card-world", "bg": "#0D2B2B", "top": "#0D2B2B", "bottom": "#2E7A72", "grid": null, "noise": 0.04, "vignette": 0.12,
                 "glow": {"colour": "#4A9A90", "alpha": 0.32, "r": 760, "x": 820, "y": 1560, "drift": [24, 18, 0.35, 0.25]},
                 "texture": null, "particles": null},
    "W-case": {"kind": "stage", "bg": "#050805", "top": "#050805", "bottom": "#135C2C", "grid": null, "noise": 0.05, "vignette": 0.2,
               "texture": null, "particles": null},
    "W-endcard": {"kind": "void", "bg": "#000000", "grid": null, "noise": 0.0, "vignette": 0.0, "texture": null, "particles": null}
  },
  "font_slots": {
    "display": {"family": "Poppins", "use": "row titles, panel titles, summary lines, chips, tags", "class": "geometric sans 500-800"},
    "body": {"family": "Poppins", "use": "captions, sub-labels, micro-labels, explain lines", "class": "geometric sans 400-600"},
    "numeric": {"family": "Poppins", "use": "every figure: chips, tiles, bars, counters, rank numerals", "class": "geometric sans 700-800, tabular figures"},
    "title": {"family": "Poppins", "use": "F-C staggered lowercase title", "class": "geometric sans 800, tight leading"}
  },
  "type": {
    "headline": {"kind": "none", "lifetime": "hook"},
    "board_label": {"slot": "display", "weight": 800, "size": 32, "case": "upper", "tracking": 0.04, "text_class": "TC-label", "redundant": true, "use": "row name (RUCHI, OPTION A)"},
    "row_title": {"slot": "display", "weight": 700, "size": 50, "case": "as_written", "text_class": "TC-label", "use": "list row claim, card title"},
    "sub_label": {"slot": "body", "weight": 500, "size": 32, "text_class": "TC-label", "redundant": true, "use": "one line under a title, words from the spoken line"},
    "micro_label": {"slot": "body", "weight": 500, "size": 28, "colour": "muted", "text_class": "TC-label", "redundant": true, "use": "you think, you actually get, a year, was X"},
    "value_chip": {"slot": "numeric", "weight": 800, "size": 42, "text_class": "TC-display", "use": "value on a chip"},
    "reality_tile": {"slot": "numeric", "weight": 800, "size": 56, "text_class": "TC-display", "use": "the true value tile"},
    "reality_tile_final": {"slot": "numeric", "weight": 800, "size": 96, "text_class": "TC-display", "use": "the last item's escalated tile"},
    "struck_value": {"slot": "numeric", "weight": 700, "size": 40, "text_class": "TC-label", "use": "the claimed value before the strike"},
    "total_card": {"slot": "numeric", "weight": 800, "size": 56, "text_class": "TC-display", "use": "combined total"},
    "rank_numeral": {"slot": "numeric", "weight": 800, "size": 100, "text_class": "TC-display", "use": "list numerals (lit paper, unlit ghost)"},
    "tab": {"slot": "display", "weight": 700, "size": 28, "case": "upper", "tracking": 0.08, "text_class": "TC-label", "redundant": true, "use": "ITEM n chip tabs"},
    "panel_title": {"slot": "display", "weight": 600, "size": 44, "text_class": "TC-label", "use": "F-B question title"},
    "param_chip": {"slot": "body", "weight": 600, "size": 28, "text_class": "TC-label", "redundant": true, "use": "F-B parameter chips"},
    "stat_card": {"slot": "numeric", "weight": 800, "size": 132, "text_class": "TC-display", "use": "F-B opening stat cards"},
    "explain_line": {"slot": "body", "weight": 500, "size": 40, "text_class": "TC-label", "use": "mechanism lines under bars"},
    "summary_line": {"slot": "display", "weight": 700, "size": 44, "text_class": "TC-label", "use": "the takeaway or stress-test question under the board"},
    "summary_helper": {"slot": "body", "weight": 500, "size": 32, "text_class": "TC-label", "redundant": true, "use": "second line of the takeaway"},
    "status_tag": {"slot": "display", "weight": 800, "size": 28, "case": "as_written", "text_class": "TC-label", "redundant": true, "use": "Cheaper? / Costs more / RUNS THE HOUSE"},
    "ledger_counter": {"slot": "numeric", "weight": 700, "size": 56, "colour": "accent", "text_class": "TC-display", "use": "F-C running ledger"},
    "ledger_header": {"slot": "body", "weight": 500, "size": 24, "colour": "paper", "text_class": "TC-legal", "use": "the word 'ledger' above the counter"},
    "ledger_sub": {"slot": "body", "weight": 500, "size": 28, "text_class": "TC-label", "redundant": true, "use": "needed / spent / recovered"},
    "case_tag": {"slot": "body", "weight": 600, "size": 28, "text_class": "TC-label", "redundant": true, "use": "case 01 / 07"},
    "title_stagger": {"slot": "title", "weight": 800, "size": 150, "case": "lower", "line_height": 0.86, "text_class": "TC-display", "use": "F-C title card"},
    "episode_label": {"slot": "body", "weight": 600, "size": 28, "colour": "accent", "text_class": "TC-label", "redundant": true, "use": "episode one"},
    "chapter_line": {"slot": "display", "weight": 700, "size": 56, "text_class": "TC-display", "use": "F-C chapter name under the title"},
    "sponsor_name": {"slot": "display", "weight": 700, "size": 44, "text_class": "TC-label", "use": "Talk to <brand>"},
    "sponsor_line": {"slot": "body", "weight": 500, "size": 32, "text_class": "TC-label", "redundant": true, "use": "Link given below"},
    "disclosure": {"slot": "body", "weight": 500, "size": 24, "text_class": "TC-legal", "use": "Paid partnership"},
    "endcard_title": {"slot": "display", "weight": 700, "size": 44, "text_class": "TC-label", "use": "end-card title, 2 lines"},
    "keyword_card": {"slot": "display", "weight": 800, "size": 72, "case": "upper", "text_class": "TC-display", "use": "comment keyword"}
  },
