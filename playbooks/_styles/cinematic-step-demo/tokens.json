      "structure": {
        "type": "tutorial",
        "markers": {
          "style": "SM-TAPE",
          "numbering": "asc",
          "recap": true,
          "teaser": false
        },
        "rehook_every_s": 35
      },
      "shared_dna": "same tungsten grade, white grotesk captions with one gold italic serif word, cuts hidden in motion, quiet type only"
    },
    "F-B": {
      "name": "Podcast clip",
      "when": "a 35-60 s opinion or story moment cut from a two-person conversation the creator recorded",
      "profile": {
        "source_type": "multi_speaker",
        "presenter": {
          "presence": "anchor",
          "share": [
            95,
            100
          ],
          "max_absence_s": 1.0
        },
        "spine": "talking_head",
        "duration": {
          "class": "short",
          "target_s": [
            35,
            60
          ]
        },
        "modules": {
          "dialogue": true
        }
      },
      "layouts": [
        "L-speaker",
        "L-insert"
      ],
      "hooks": {
        "default": "HA-14",
        "allowed": [
          "HA-14",
          "HA-16"
        ]
      },
      "structure": {
        "type": "conversation",
        "markers": {
          "style": "none",
          "numbering": "asc",
          "recap": false,
          "teaser": false
        }
      },
      "cadence": {
        "sc_per_10s": [
          2.5,
          7
        ],
        "hook_sc_3s": 2,
        "max_gap_s": 6.0,
        "hook_max_gap_s": 5.5,
        "cuts_per_min": [
          14,
          26
        ],
        "median_shot_s": [
          2.0,
          4.2
