    "F-A": {
      "name": "Step demo",
      "when": "a hands-on process taught in 3-7 steps: a recipe, a brew, a craft build, a camera setting, a repair, a routine",
      "profile": {},
      "layouts": [
        "L-desk",
        "L-overhead",
        "L-insert"
