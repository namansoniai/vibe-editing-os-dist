  "footage": {
    "setups": [
      {
        "id": "A",
        "desc": "desk A-roll: seated, chest-up, 50-85 mm look, f/1.8-2.8 shallow depth of field, warm practical lamps, a lined background (books, shelves, tools, pantry jars), dark top",
        "framing": {
          "head_top_y": [
            220,
            360
          ]
        }
      },
      {
        "id": "B",
        "desc": "overhead: camera straight down over a dark patterned or deep-coloured work surface, 9:16 vertical, hands enter from the bottom edge, object inside y 200-1250",
        "framing": {
          "object_zone_y": [
            200,
            1250
          ]
        }
      },
      {
        "id": "C",
        "desc": "desk insert: the A-roll camera low and close, the object held up or set at an angle, background falling to black",
        "framing": {}
      },
      {
        "id": "D",
        "desc": "podcast: one camera per speaker, tight single (head and shoulders), mic in frame, warm practicals behind; or one wide 4K camera",
        "framing": {
          "head_top_y": [
            140,
            320
          ]
        }
      }
    ],
    "shots": [
      {
        "id": "SH-1",
        "desc": "overhead hand demo clips (setup B), 3-12 s each, every step's action filmed start to finish",
        "per_60s": [
          6,
          12
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-1"
      },
      {
        "id": "SH-2",
        "desc": "finished-result clip: hands turning, opening or presenting the end result, 3-6 s, overhead or angled",
        "per_60s": [
          1,
          2
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-2"
      },
      {
        "id": "SH-3",
        "desc": "desk A-roll take of the whole script (setup A)",
        "per_60s": [
          1,
          1
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-3"
      },
      {
        "id": "SH-4",
        "desc": "desk inserts: object held to camera or set at an angle (setup C), 2-4 s, rack focus",
        "per_60s": [
          1,
          3
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-4"
      },
      {
        "id": "SH-5",
        "desc": "podcast: one synced camera per speaker (setup D), or a wide 4K shot of both",
        "per_60s": [
          1,
          1
        ],
        "must": true,
        "formats": [
          "F-B"
        ],
        "fallback": "FB-5"
      },
      {
        "id": "SH-6",
        "desc": "listener reactions: 2-3 s of nods, laughs, a look away, from the listener's camera (part of SH-5)",
        "per_60s": [
          2,
          4
        ],
        "must": false,
        "formats": [
          "F-B"
        ],
        "fallback": "FB-6"
      }
    ],
    "fallbacks": [
      {
        "id": "FB-1",
        "does": "no overhead camera: shoot the demo again with the A-roll camera tilted down at 45-60 degrees (setup C framing) and run it as the plate; with a horizontal 16:9 overhead clip, show it as a 16:9 band over a blurred copy of itself (P-PLATE-BAND); with only phone photos of each step, P-STEP-STILL (slow push on the photo)",
        "cost": "the top-down macro look is lost (angled) or the frame is no longer full-bleed (band, stills); the hand-swipe hidden cut is lost on stills",
        "result": "degraded"
      },
      {
        "id": "FB-2",
        "does": "use the last overhead clip's final 3 s (the finished state) as the hook plate, starting on the frame where the hand leaves",
        "cost": "no 'presenting' motion at f0; the hook still opens on the result",
        "result": "holds"
      },
      {
        "id": "FB-3",
        "does": "no desk A-roll: the reel runs voice-over on the overhead plates only, the creator's face appears in no shot; presence drops to flash (the hands)",
        "cost": "no host returns between steps; presenter share falls below 20%",
        "result": "no_fallback"
      },
      {
        "id": "FB-4",
        "does": "skip the inserts: punch-crop (Z-2) into the overhead clip on the object instead",
        "cost": "less depth; no rack focus",
        "result": "holds"
      },
      {
        "id": "FB-5",
        "does": "one camera only: two virtual crops of a 4K wide shot, one per speaker (engine single-camera fallback, two_crops); 1080p wide: blurfill bands per speaker",
        "cost": "softer image (crop upsampling up to 2x); the blurfill band loses the full-bleed face",
        "result": "degraded"
      },
      {
        "id": "FB-6",
        "does": "no listener footage: no reaction cutaways; recrop (Z-2) on the speaker at the would-be reaction point",
        "cost": "the conversation feels one-sided",
        "result": "holds"
      }
    ],
