  },
  "running_state": null,
  "anchors": null,
  "data": null,
  "citations": null,
  "inserts": {
    "fetch": true,
    "ask_creator": false,
    "create_fallbacks": [
      "quote_card",
      "headline_card",
      "recreated_ui",
      "diagram",
      "logo_plate",
      "silhouette"
    ],
    "patterns": [
      "P-25",
      "P-29"
    ]
  },
  "footage": {
    "setups": [
      {
        "id": "A",
        "desc": "F-A live room: host on a stage or chair, asker at a floor mic or across a table; 2-3 cameras (host single, asker single, room wide), 1080p+ 16:9 or 9:16; every person mic'd or one room mic",
        "framing": {
          "head_top_y": [
            140,
            320
          ]
        }
      },
      {
        "id": "B",
        "desc": "F-A single wide: one 4K camera seeing both people (two faux crops)",
        "framing": {
          "head_top_y": [
            160,
            340
          ]
        }
      },
      {
        "id": "C",
        "desc": "F-B solo: one camera, chest-up, eye-line just off lens as if answering someone; plain or lived-in background",
        "framing": {
          "head_top_y": [
            150,
            260
          ]
        }
      }
    ],
    "shots": [
      {
        "id": "SH-1",
        "desc": "host single, medium (waist-up) to medium close-up",
        "per_60s": [
          6,
          10
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-1"
      },
      {
        "id": "SH-2",
        "desc": "asker single at the mic or across the table, medium close-up, catches listening reactions",
        "per_60s": [
          4,
          8
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-2"
      },
      {
        "id": "SH-3",
        "desc": "room wide / audience shot that shows the host from behind the crowd",
        "per_60s": [
          0,
          2
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-3"
      },
      {
        "id": "SH-4",
        "desc": "solo talking head, chest-up, 1080p minimum, 4K preferred",
        "per_60s": [
          1,
          1
        ],
        "must": true,
        "formats": [
          "F-B"
        ],
        "fallback": "FB-4"
      },
      {
        "id": "SH-5",
        "desc": "the question as the creator received it (comment, DM, email screenshot) or their own screen/slide/whiteboard",
        "per_60s": [
          0,
          3
        ],
        "must": false,
        "formats": [
          "F-B"
        ],
        "fallback": "FB-5"
      }
    ],
    "fallbacks": [
      {
        "id": "FB-1",
        "does": "two faux crops of one wide shot (setup B): host crop + asker crop, 9:16 each, face 27-30% of the cell",
        "cost": "softer image (needs 4K for clean crops), no true eye-line",
        "result": "degraded"
      },
      {
        "id": "FB-2",
        "does": "asker crop from the wide; if the asker is never visible, F-B instead (the question becomes a question card)",
        "cost": "no listener reactions from a dedicated angle",
        "result": "degraded"
      },
      {
        "id": "FB-3",
