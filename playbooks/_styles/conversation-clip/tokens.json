  "font_slots": {
    "display": {
      "family": "Montserrat",
      "use": "the quote pill (800, caps)",
      "class": "geometric sans 800-900 caps"
    },
    "body": {
      "family": "Montserrat",
      "use": "captions 600, emphasis 800, guest italic",
      "class": "geometric sans 600-800 with a true italic"
    },
    "marker": {
      "family": "Permanent Marker",
      "use": "F-B board words only",
      "class": "felt-tip marker hand"
    },
    "ui": {
      "family": "Montserrat",
      "use": "F-B question card name line and text",
      "class": "geometric sans 500-700"
    }
  },
  "type": {
    "headline": {
      "kind": "pill",
      "lifetime": "hook",
      "max_words": 6,
      "max_lines": 2,
      "read_s": 1.2,
      "slot": "display",
      "weight": 800,
      "size": 68,
      "case": "upper",
      "tracking": 0,
      "line_height": 1.0,
      "fill": "primary",
      "text": "paper",
      "container": "box_per_line",
      "radius": 16,
      "padding": [
        8,
        22
      ],
      "stroke": 0,
      "shadow": "0 4 10 rgba(0,0,0,.25)",
      "rotate": 0,
      "rect": {
        "cx": 540,
        "top": 672,
        "bottom_max": 880,
        "max_w": 840
      },
      "quotes": "curly quotes when the pill is the asker's question; none when it is the host's verdict",
      "f0": "fully drawn on frame 0, no entrance",
      "exit": "hard 0 f at the word boundary where the question sentence ends (snap to a shot cut within 3 f, else mid-shot; measured 3.83 / 4.73 / 11.53 s); held >= 2.7 s, never later than 12 s",
      "text_class": "TC-display"
    },
    "cta_pill": {
      "slot": "display",
      "weight": 800,
      "size": 68,
      "case": "upper",
      "fill": "primary",
      "text": "paper",
      "container": "box_per_line",
      "radius": 16,
      "padding": [
        8,
        22
      ],
      "hold_s": [
        1.5,
        3.0
      ],
      "text_class": "TC-display"
    },
    "board_word": {
      "slot": "marker",
      "weight": 400,
      "size": [
        64,
        96
      ],
      "colour": "ink",
      "text_class": "TC-label",
      "write_on_frames": 10
    },
    "board_title": {
      "slot": "marker",
      "weight": 400,
      "size": [
        96,
        120
      ],
      "colour": "ink",
      "text_class": "TC-display",
      "write_on_frames": 12
    },
    "card_name": {
      "slot": "ui",
      "weight": 700,
      "size": 40,
      "colour": "paper",
      "text_class": "TC-label"
    },
    "card_text": {
      "slot": "ui",
