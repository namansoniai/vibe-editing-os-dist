              "anchor": "seam"
            }
          }
        },
        "emphasis": {
          "mechanism": "none"
        },
        "hide": []
      },
      "CS-3": {
        "extends": "lib:hormozi",
        "unit": "word",
        "words": [
          1,
          1
        ],
        "max_chars_line": 10,
        "lines": 1,
        "lead_frames": 1,
        "min_hold_s_per_word": 0.5,
        "swap": {
          "type": "hard",
          "frames": 0
        },
        "skin": {
          "slot": "body",
          "weight": 800,
          "size": 120,
          "text_class": "TC-display",
          "case": "as_spoken",
          "colour": "paper",
          "stroke": 0,
