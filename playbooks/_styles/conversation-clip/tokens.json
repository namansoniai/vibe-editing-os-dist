      "grouping": "international",
      "currency": "$",
      "compact": "k_m_b",
      "units": "metric",
      "decimals": 0,
      "style": "short"
    },
    "tone": {
      "energy": "balanced",
      "comedy": "off",
      "comedy_max": "light"
    },
    "themes": {
      "policy": "single",
      "packs": [],
      "default": null
    },
    "formats": {
      "list": [
        "F-A",
        "F-B"
      ],
      "default": "F-A"
