      "ink": false,
      "continuity": false,
      "series": false,
      "brand": false
    }
  },
  "formats": {
    "F-A": {
      "name": "Two-person Q&A",
      "when": "a real conversation on camera: an audience question at a talk, a client call, a podcast or interview moment; 2 people, 2+ cameras or one wide shot",
      "profile": {},
      "layouts": [
        "L-full-dialogue"
      ],
      "hooks": {
        "default": "HA-03",
        "allowed": [
          "HA-03",
          "HA-14"
        ]
      },
      "structure": {
        "type": "conversation"
      },
      "shared_dna": "red caps quote pill over the opener that survives the first cut, centre word-group captions coloured by speaker (host white upright, other voice yellow italic), hard cuts only, nothing else on screen"
    },
    "F-B": {
      "name": "Solo answer",
      "when": "the creator answers one question alone (a comment, a DM, a client question): one camera, plus their own screen or a board when they reference one",
      "profile": {
        "source_type": "talking_head",
        "presenter": {
          "presence": "anchor",
          "share": [
            90,
            100
          ],
          "max_absence_s": 2.5
        },
        "footage_dependency": "low",
        "duration": {
          "class": "standard",
          "target_s": [
            45,
            90
          ]
        },
        "modules": {
          "dialogue": false
        }
      },
      "layouts": [
        "L-full-solo",
        "L-solo-stack"
      ],
      "hooks": {
        "default": "HA-05",
        "allowed": [
          "HA-05",
          "HA-14"
        ],
        "f0": {
          "require": [],
          "forbid": []
        }
      },
      "cadence": {
        "cuts_per_min": [
          10,
          18
        ],
        "median_shot_s": [
          2.0,
          4.0
        ]
      },
      "structure": {
        "type": "conversation",
        "rehook_every_s": 30
      },
      "shared_dna": "same red caps pill on the opener, same centre captions (host white upright; the asker's words yellow italic), hard cuts with jump re-crops; the asker's face is replaced by their question in the bottom cell"
    }
  },
  "tone": {
    "energy": "balanced",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "high",
    "comedy": "off"
  },
  "roles": {
    "primary": {
      "meaning": "the quote pill fill (hook and CTA reprise only)",
      "default": "#E80001",
      "text_on": "paper",
      "brandable": true
    },
    "accent": {
      "meaning": "the second voice: guest / asker caption colour, and the asker's question on the F-B question card",
      "default": "#F2DF1A",
      "text_on": "ink",
      "brandable": true
    },
    "paper": {
      "meaning": "host captions, pill text",
      "default": "#FFFFFF"
    },
    "ink": {
      "meaning": "caption shadows, text on accent, board marker",
      "default": "#0B0B0B"
    },
    "board": {
      "meaning": "F-B board card fill (flip-chart white), drawn inside the insert rect on the void cell",
      "default": "#F4F4F1"
    },
    "void": {
      "meaning": "F-B bottom-cell ground behind a question card or screen",
      "default": "#0E0E10"
    }
  },
  "fixed_meaning": [],
  "max_bright_per_frame": 2,
  "gradients": {},
  "themes": {},
