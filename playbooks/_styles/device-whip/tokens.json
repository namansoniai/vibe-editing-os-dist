  "font_slots": {
    "display": {
      "family": "Montserrat",
      "use": "hook title (900 italic caps)",
      "class": "heavy italic geometric sans caps: Montserrat 900i, Poppins 800i"
    },
    "body": {
      "family": "Poppins",
      "use": "subtitles (500)",
      "class": "geometric sans 500-600: Poppins, Plus Jakarta Sans, Inter Tight"
    },
    "label": {
      "family": "Poppins",
      "use": "counter label, chips, verdicts (700)",
      "class": "geometric sans 700-800: Poppins, Plus Jakarta Sans"
    },
    "ui": {
      "family": "Inter Tight",
      "use": "message bubbles, notification drops, recreated UI (500-700)",
      "class": "neo-grotesk UI sans 500-700: Inter Tight, Plus Jakarta Sans"
    },
    "wordmark": {
      "family": "Barlow Condensed",
      "use": "end-card wordmark (700 caps)",
