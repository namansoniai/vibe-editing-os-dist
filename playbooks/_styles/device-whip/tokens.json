  "type": {
    "headline": {
      "kind": "lockup",
      "lifetime": "hook",
      "max_words": 9,
      "max_lines": 1,
      "max_emoji": 0,
      "read_s": 2.25,
      "f0": "phrase 1 pops in on f1-f2 (scale 0.70 -> 1.0, horizontal motion blur 12 -> 0 px, opacity 0.5 -> 1), sharp by f3, while the open punch (Z-4) runs",
      "exit": "never exits on its own: it is blurred away inside the hook whip (T-WHIP-S or T-WHIP) with the frame",
      "phrases": [
        2,
        3
      ],
      "phrase_words_max": 3,
      "phrase_hold_s_per_word": 0.25,
      "swap": "2-frame blurred crossover: the old phrase fades 1 -> 0 while the new one pops 0.85 -> 1.0 with 10 px horizontal blur",
      "measured_cy": 1340
    },
    "title": {
      "slot": "display",
      "weight": 900,
      "style": "italic",
      "size": 76,
      "case": "upper",
      "tracking": 0.01,
      "fill": "gradient:title",
      "stroke": 3,
      "stroke_role": "paper",
      "extrude": [
        4,
        6
      ],
      "extrude_role": "title_shadow",
      "cy": 1340,
      "max_w": 952,
      "text_class": "TC-display",
      "note": "cap 56 px, 686 px wide for \"DON'T TELL YOU\", cy 1340 (v02 @ 0:00.4-1.0); white 3 px stroke + hard navy extrusion confirmed"
    },
    "counter": {
      "slot": "label",
      "weight": 700,
      "size": 80,
      "case": "as_spoken",
      "colour": "accent",
      "stroke": 3,
      "stroke_role": "counter_stroke",
      "shadow": "0 3 8 rgba(0,0,0,.45)",
      "gap_above_caption": 120,
      "text_class": "TC-display",
      "note": "\"Reframes: 1\" 474 px wide, cy 1158, sits ~120 px above the caption (v03 @ 0:06)"
    },
    "chip": {
      "slot": "label",
      "weight": 700,
      "size": 44,
      "case": "sentence",
      "radius": 22,
      "padding": [
        10,
        26
      ],
      "text_class": "TC-label"
    },
    "verdict": {
      "slot": "label",
      "weight": 700,
      "size": 48,
      "case": "upper",
      "radius": 24,
      "text_class": "TC-label"
    },
    "bubble": {
      "slot": "ui",
      "weight": 500,
      "size": 42,
      "name_size": 26,
      "radius": 34,
      "avatar_d": 112,
      "text_class": "TC-label"
    },
    "wordmark": {
      "slot": "wordmark",
      "weight": 700,
      "size": [
        110,
        200
      ],
      "case": "upper",
      "tracking": 0.0,
      "text_class": "TC-display",
      "fit_w": 820,
      "cy": 860,
      "note": "fit to ~820 px wide (v01 @ 0:26.5 \"MRWHOSETHEBOSS\" spans 76 % of the width, cap \u2248 110 px), so a short name gets bigger type"
    },
    "keyword": {
      "slot": "label",
      "weight": 800,
      "size": 64,
      "case": "upper",
      "text_class": "TC-display"
    },
    "legal": {
      "slot": "ui",
      "weight": 600,
      "size": 24,
      "case": "upper",
      "tracking": 0.08,
      "text_class": "TC-legal"
    }
  },
  "captions": {
    "profanity": {
      "mask": true,
      "style": "inner"
    },
    "default": "CS-1",
    "by_layout": {},
    "speakers": {},
    "profiles": {
      "CS-1": {
        "extends": "lib:mrwhose",
        "unit": "line",
        "words": [
