  "hooks": {
    "default": "HA-17",
    "allowed": [
      "HA-17",
      "HA-02",
      "HA-10",
      "HA-14"
    ],
    "stopper": {
      "tests": [
        "ST-1",
        "ST-2",
        "ST-3",
        "ST-4",
        "ST-5",
        "ST-6"
      ],
      "thumb_scale": 0.25,
      "read_s": 2.25,
      "hook_sc_3s": 5,
      "payoff_by_s": 2.5
    },
    "f0": {
      "require": [],
      "forbid": []
    },
    "variants": {
      "HA-17.A": "H-A title whip (title stagger over the held-up device, whip by 2.3 s)",
      "HA-17.B": "H-B question ring (question captions + ring trace on the device, whip by 2.5 s)"
    }
  },
  "structure": {
    "type": "list",
    "markers": {
      "style": "none",
