    "L-device-dim": {
      "engine": "full",
      "graphic": {
        "x": 250,
        "y": 260,
        "w": 580,
        "h": 1060
      },
      "caption": {
        "anchor": "fixed_y",
        "cy": 1400
      },
      "treatment": {
        "dim": {
          "blur_px": 18,
          "luma": -0.35
        }
      },
      "share": [
        0.0,
        0.3
      ],
      "safe": null
    },
    "L-endcard": {
      "engine": "hidden",
      "graphic": {
        "x": 0,
        "y": 0,
        "w": 1080,
        "h": 1920
      },
      "caption": null,
      "treatment": null,
      "share": [
        0.0,
        0.14
      ],
      "safe": null
    },
    "schedule": {
      "switch_on": [
        "sentence",
        "number",
        "any"
      ],
      "max_s": {
        "L-full": 5.0,
        "L-pov": 5.0
      },
      "min_s": {
        "L-full": 0.8,
        "L-pov": 1.0
      },
      "tol_s": 0.25
    }
  },
  "slots": {},
  "motion": {
    "lead_frames": 2,
    "ease_entry": [
      0.22,
      1,
      0.36,
      1
    ],
    "ease_exit": [
      0.64,
      0,
      0.78,
      0
    ],
    "ease_in_out": [
      0.65,
      0,
      0.35,
      1
    ],
    "title_pop_frames": 2,
    "title_pop_from_scale": 0.7,
    "title_pop_blur_px": 12,
    "title_swap_frames": 2,
    "whip_out_frames": 4,
    "whip_peak_frames": 3,
    "whip_land_frames": 3,
    "whip_flash_lift": 0.28,
    "whip_l_frames": 6,
    "whip_s_frames": 7,
    "whip_s_roll_deg": 5,
    "ring_sweep_frames": 9,
    "ring_sweep_len": 0.45,
    "counter_roll_frames": 4,
    "counter_roll": "odometer: the changed digits slide up out of a clipped box while the new ones rise in from below, ease-out, 1-2 f after the cut",
    "counter_in_frames": 8,
    "pov_push": [
      1.0,
      1.08
    ],
    "pov_snap": [
      1.0,
      1.25
    ],
    "pov_snap_frames": 6,
    "step_punch": [
      1.06,
      1.23
    ],
    "bubble_fly_frames": 6,
    "endcard_build_frames": 14,
    "endcard_exit_frames": 5,
    "hold_min_frames": 10,
    "text_hold_per_word_s": 0.25
  },
  "camera_presets": {
    "zoom-through": {
      "id": "Z-1",
      "scale": [
        1.0,
        1.6
      ],
      "frames": 7,
      "tones": [
        "hype",
        "awe",
        "explain"
      ],
      "ease": "in",
      "use": "inside T-WHIP only (into the device or back out to the face at a section change); measured 1.5-1.6x over 6-7 f, ease-in; pivot p.origin = the device point; radial blur + flash are timeline built-ins"
    },
    "crash-zoom": {
      "id": "Z-4",
      "scale": [
        1.0,
        1.4
      ],
      "frames": 5,
      "tones": [
        "hype"
      ],
      "max_per_reel": 1,
      "use": "the hook open punch on f1-f5 (v02 @ 0.03-0.17 s: 1.0 -> 1.43), held until the hook whip"
    },
    "rotation-snap": {
      "id": "Z-5",
      "rotate": 5,
      "frames": 3,
      "tones": [
        "hype",
        "explain"
      ],
      "use": "inside T-WHIP-S only (the spin whip's 5 deg roll about p.origin = the device point; the smear is the built-in whip transition)"
    },
    "push-drift": {
      "id": "Z-2",
      "scale": [
        1.0,
        1.05
      ],
      "frames": "beat",
      "tones": [
        "explain",
        "awe"
      ],
      "use": "A-roll holds longer than 3 s"
    },
    "snap-punch": {
      "id": "Z-3",
      "scale": [
        1.0,
        1.15
      ],
      "frames": 3,
      "blur_frames": [
        1,
        2
      ],
      "hold": "until_next_cut",
      "tones": [
        "hype",
        "win"
      ],
      "max_per_reel": 2,
      "use": "a reaction punchline (comedy light) or FB-3 hold-up substitute"
    },
    "reset": {
      "id": "Z-0",
      "frames": 4
    }
  },
  "zoom_policy": "presets",
  "stage_morphs": {
    "cut": 0,
    "dim": 8,
    "fade-through": 10
  },
  "grades": {
    "footage": null,
    "scene": {},
    "events": {
      "max_per_reel": 0,
      "allowed": []
    },
    "clip_treatments": null
