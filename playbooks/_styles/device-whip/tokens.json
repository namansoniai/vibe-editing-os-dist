    }
  },
  "tone": {
    "energy": "balanced",
    "meme_sfx": false,
    "roast": false,
    "caption_density": "medium",
    "comedy": "light"
  },
  "roles": {
    "primary": {
      "meaning": "the hook title (blue italic caps), the end-card keyword chip (sampled #1070C8 mid-letter, v02 @ 0:00.6)",
      "default": "#1570C8",
      "text_on": "paper",
      "brandable": true
    },
    "accent": {
      "meaning": "the running counter label (Label: N) (sampled #D80018, v03 @ 0:06)",
      "default": "#D80018",
      "text_on": "paper",
      "brandable": true
    },
    "highlight": {
      "meaning": "the neon ring traced around the device, tap ripples",
      "default": "#4FE1FF",
      "text_on": "ink",
      "brandable": true
    },
    "bad": {
      "meaning": "fails, doesn't work, worse (verdict chip)",
      "default": "#D92D20",
      "text_on": "paper",
      "brandable": false
    },
    "good": {
      "meaning": "works, passed, better (verdict chip)",
      "default": "#1A7F38",
      "text_on": "paper",
      "brandable": false
    },
    "title_top": {
      "meaning": "the light top stop of the title gradient (derived from primary)",
      "default": "#4A9BE8"
    },
    "title_shadow": {
      "meaning": "the hard extrusion under the title and the counter stroke base",
      "default": "#06143D"
    },
    "counter_stroke": {
      "meaning": "the dark stroke around the counter label",
      "default": "#4A0610"
    },
    "ink": {
      "meaning": "text on light chips and bubbles, strokes",
      "default": "#0B0B0F"
    },
    "paper": {
      "meaning": "subtitles, title stroke, bubbles, end-card wordmark",
      "default": "#FFFFFF"
    },
    "bubble_text": {
      "meaning": "message-bubble body text",
      "default": "#2C2C30"
    },
    "night": {
      "meaning": "end card and POV underlay",
      "default": "#000000"
    }
  },
  "fixed_meaning": [
    "bad",
    "good"
  ],
  "max_bright_per_frame": 3,
  "gradients": {
    "title": {
      "stops": [
        "#5AA2FF",
        "#1A64FF",
        "#1450D6"
