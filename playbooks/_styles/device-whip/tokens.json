          "note": "Poppins 600 ~56 px with a visible black outline (v03 @ 0:00.5 \"Can your iPhone\" 473 px wide); real cy varies 1277 (v03) to ~1600 (v02); 1400 kept inside the safe band"
        },
        "position": {
          "anchor": "fixed_y",
          "cy": 1400,
          "offset": 0,
          "cx": 540,
          "max_w": 952,
          "align": "center",
          "colour_by_bg": null,
          "avoid_face": true,
          "hide_on_morph": true
        },
        "emphasis": {
          "mechanism": "none",
          "slot": null,
          "colour": null,
          "ratio": 1.0,
          "select": null,
          "max_per_s": 0,
          "never": []
        },
        "karaoke": null,
        "tiers": null,
        "duet": null,
        "stack": null,
        "hide": [
          "under_z8",
          "transitions"
        ],
        "language": {
          "script": "Latn",
          "transliteration": "keep_english_terms",
          "normalise_spelling": true,
          "glossary": []
        }
      }
    }
  },
