  "footage": {
    "setups": [
      {
        "id": "A",
        "desc": "A-roll: tripod, 4K, eye level, shallow depth of field (f/1.8-2.8), soft coloured practicals behind, device in hand",
        "framing": {
          "head_top_y": [
            160,
            320
          ]
        }
      },
      {
        "id": "B",
        "desc": "POV camera: second camera or phone at chin height looking down at the device held in one hand, same set blurred behind",
        "framing": {
          "screen_h_frac": [
            0.4,
            0.65
          ]
        }
      },
      {
        "id": "C",
        "desc": "device on a clamp or monopod at chest height; presenter leans in from the side; a locked-off camera on the device for repetitions",
        "framing": {
          "screen_h_frac": [
            0.45,
            0.8
          ]
        }
      }
    ],
    "shots": [
      {
        "id": "SH-1",
        "desc": "A-roll talking head with the device in hand",
        "per_60s": [
          6,
          12
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-8"
      },
      {
        "id": "SH-2",
        "desc": "hand-held device POV, screen 40-65% of frame height, one take per feature",
        "per_60s": [
          4,
          9
        ],
        "must": true,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-1"
      },
      {
        "id": "SH-3",
        "desc": "hold-up: device swung toward the lens, held still 1.5-2 s, face soft behind",
        "per_60s": [
          0,
          1
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-3"
      },
      {
        "id": "SH-4",
        "desc": "lean-in to the device on a clamp or monopod",
        "per_60s": [
          0,
          2
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-4"
      },
      {
        "id": "SH-5",
        "desc": "locked-off POV on the clamped device, finger taps, one take per repetition (count-ups)",
        "per_60s": [
          0,
          12
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-5"
      },
      {
        "id": "SH-6",
        "desc": "macro detail: icon, port, button or texture, tilted 15-25 degrees, slow forward move",
        "per_60s": [
          0,
          2
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-6"
      },
      {
        "id": "SH-7",
        "desc": "native screen recording of the device (backup for any UI that must be read)",
        "per_60s": [
          0,
          4
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-2"
      },
      {
        "id": "SH-8",
        "desc": "wide context: presenter using the device in the room",
        "per_60s": [
          0,
          1
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-7"
      },
      {
        "id": "SH-9",
        "desc": "reaction bank: laugh, disbelief, wince, shrug, 1-2 s each",
        "per_60s": [
          0,
          2
        ],
        "must": false,
        "formats": [
          "F-A"
        ],
        "fallback": "FB-8"
      }
    ],
    "fallbacks": [
      {
        "id": "FB-1",
        "does": "the SH-7 screen recording inside a drawn generic phone frame (P-11) over the dimmed A-roll (L-device-dim), tilt 6 degrees, slow float",
        "cost": "no real hand, no real device: believability and the POV feel are lost",
        "result": "degraded"
