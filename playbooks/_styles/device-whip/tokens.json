        "pause_hold_s": 0.6,
        "tail_s": 0.12,
        "hard_pause_s": 0.9,
        "punct_break": true,
        "punct": "keep",
        "skin": {
          "slot": "body",
          "weight": 600,
          "size": 56,
          "text_class": "TC-subtitle",
          "case": "sentence",
          "tracking": 0,
          "line_height": 1.12,
          "colour": "paper",
          "stroke": 3,
          "stroke_colour": "#000000",
          "shadow": "0 3 10 rgba(0,0,0,.6)",
          "container": {
            "type": "none",
            "fill": null,
            "opacity": 0,
            "radius": 0,
            "padding": [
              0,
              0
