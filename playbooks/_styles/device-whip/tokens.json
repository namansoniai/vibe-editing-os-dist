  "formats": {
    "F-A": {
      "name": "Device Whip",
      "when": "every reel: tech and gadget reviews, hidden-feature lists, 'can it do X?' count-up tests, one-device stories",
      "profile": {},
      "layouts": [
        "L-full",
        "L-pov",
        "L-device-dim",
        "L-endcard"
      ],
      "hooks": {
        "default": "HA-17"
      },
      "structure": {
        "type": "list"
      },
