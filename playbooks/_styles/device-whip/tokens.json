        "cost": "no macro texture",
        "result": "degraded"
      },
      {
        "id": "FB-7",
        "does": "skip the wide; stay on SH-1",
        "cost": "none worth noting",
        "result": "holds"
      },
      {
        "id": "FB-8",
        "does": "the nearest natural reaction or line in the main A-roll take",
        "cost": "fewer reaction beats",
        "result": "holds"
      }
